import rinzu.stdio;
import rinzu.testing;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.error as err;
import rinzu.future as future;
import rinzu.number as num;

class Progress {
    ticks: Int,
    done: Bool
}

async fn heartbeat(progress: Progress) {
    while !progress.done {
        await delay(5);
        progress.ticks = progress.ticks + 1;
    }
}

fn pattern() -> ByteArray {
    return bytesApi.from(b"\x00\xff\x80A\x00B\xfeC");
}

fn payload() -> ByteArray {
    var data = pattern();
    while bytesApi.length(data) < 65536 {
        data = bytesApi.concat(data, data);
    }
    return data;
}

fn verify(data: ByteArray, offset: Int) {
    let expected = pattern();
    var index = 0;
    while index < bytesApi.length(data) {
        let position = offset + index;
        assertTrue(
            bytesApi.get(data, index) == bytesApi.get(expected, position - (position / 8) * 8),
            "binary content"
        );
        index = index + 1;
    }
}

fn configuration(name: String, defaultValue: String) -> String {
    try {
        let resultValue6 = rinzu.process.setting(name, defaultValue);
        return resultValue6;
    }
    catch [resultError6: Error, ...resultRest6] {
        assertTrue(false, err.message(resultError6));
    }
    return defaultValue;
}

fn integer(name: String) -> Int {
    try {
        let resultValue5 = num.parseInt(configuration(name, "0"));
        return resultValue5;
    }
    catch [resultError5: Error, ...resultRest5] {
        assertTrue(false, err.message(resultError5));
    }
    return 0;
}

fn readLimit(defaultSize: Int) -> Int {
    let configured = integer("SOCKET_READ_MAXIMUM");
    if configured == 0 {
        return defaultSize;
    }
    assertTrue(configured >= 1 && configured <= 65536, "read maximum");
    return configured;
}

async fn put(stream: rinzu.socket.TcpStream, data: ByteArray) {
    try {
        try {
            let resultValue4 = await rinzu.socket.writeAll(stream, data);
            assertEqual<Int>(resultValue4, bytesApi.length(data), "writeAll length");
        }
        catch [resultError4: Error, ...resultRest4] {
            if resultError4 is rinzu.socket.WriteFailure {
                assertTrue(false, err.message(resultError4.payload.cause));
            }
            else {
                throw resultError4;
            }
        }
    }
    catch [unexpectedWorkerError: Error, ...unexpectedWorkerRest] {
        assertTrue(false, err.message(unexpectedWorkerError));
    }
}

async fn half(stream: rinzu.socket.TcpStream) {
    try {
        try {
            let resultValue3 = await rinzu.socket.shutdownWrite(stream);
        }
        catch [resultError3: Error, ...resultRest3] {
            assertTrue(false, err.message(resultError3));
        }
    }
    catch [unexpectedWorkerError: Error, ...unexpectedWorkerRest] {
        assertTrue(false, err.message(unexpectedWorkerError));
    }
}

fn cleanup(ticks: Int) {
    let stats = rinzu.socket.statistics();
    rinzu.stdio.writeLine(
        f"CLEANUP:{stats.handleSlots}:{stats.operations}:{stats.buffers}:{stats.eventThreads}:TICKS:{ticks}:EVENTS:{stats.readinessEvents}:PARTIAL:{stats.partialWrites}"
    );
    assertEqual<Int>(stats.handleSlots, 0, "live handles");
    assertEqual<Int>(stats.operations, 0, "live operations");
    assertEqual<Int>(stats.buffers, 0, "live buffers");
    assertEqual<Int>(stats.eventThreads, 0, "event thread joined");
    assertTrue(ticks > 0, "timer progressed");
}

async fn receive(stream: rinzu.socket.TcpStream) {
    let maximum = readLimit(4096);
    try {
        await delay(300);
        var total = 0;
        var chunks = 0;
        while true {
            try {
                let resultValue2 = await rinzu.socket.read(stream, maximum);
                if resultValue2.eof {
                    break;
                }
                verify(resultValue2.data, total);
                total = total + bytesApi.length(resultValue2.data);
                chunks = chunks + 1;
            }
            catch [resultError2: Error, ...resultRest2] {
                assertTrue(false, err.message(resultError2));
                return;
            }
        }
        assertEqual<Int>(total, 1114240, "greeting plus byte echo");
        rinzu.stdio.writeLine(f"BINARY:{total}:CHUNKS:{chunks}");
    }
    catch [unexpectedWorkerError: Error, ...unexpectedWorkerRest] {
        assertTrue(false, err.message(unexpectedWorkerError));
    }
}

