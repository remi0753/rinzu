import rinzu.timer;
import rinzu.http;
import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;

class Ticks {
    value: Int
}

async fn ticking(ticks: Ticks) {
    var i = 0;
    while i < 20 {
        await rinzu.timer.sleep(1);
        ticks.value = ticks.value + 1;
        i = i + 1;
    }
}

async fn main() {
    try {
        let client = rinzu.http.newClient();
        let ticks = Ticks(value: 0);
        try all {
            let counter = ticking(ticks);
            try {
                let resultValue5 = await rinzu.http.request(client, "BASE/slow", bytesApi.from(b""), false, 2000);
                if resultValue5.status != 200 || bytesApi.length(resultValue5.body) != 8192 || ticks.value != 20 {
                    rinzu.core.panic("badResponse");
                }
            }
            catch [resultError5: Error, ...resultRest5] {
                rinzu.core.panic("badGet");
            }
            await counter;
            let body = bytesApi.from(b"\x00\xff\x02\x00\x04\x05\x80");
            try {
                let resultValue4 = await rinzu.http.request(client, "BASE/echo", body, true, 2000);
                if resultValue4.body != body {
                    rinzu.core.panic("badEcho");
                }
            }
            catch [resultError4: Error, ...resultRest4] {
                rinzu.core.panic("badPost");
            }
            try {
                let resultValue3 = await rinzu.http.request(client, "BASE/disconnect", bytesApi.from(b""), false, 2000);
                rinzu.core.panic("badDisconnect");
            }
            catch [resultError3: Error, ...resultRest3] {
                if resultError3 is rinzu.http.HttpFailure {
                    if resultError3.payload.status != 200 || bytesApi.length(resultError3.payload.partial) != 7 {
                        rinzu.core.panic("badPartial");
                    }
                }
                else {
                    throw resultError3;
                }
            }
            try {
                let resultValue2 = await rinzu.http.request(client, "BASE/binary", bytesApi.from(b""), false, 2000);
                if bytesApi.length(resultValue2.body) != 8192 {
                    rinzu.core.panic("badRecoveredLength");
                }
            }
            catch [resultError2: Error, ...resultRest2] {
                rinzu.core.panic("badRecovery");
            }
        }
        finally {
            try {
                let resultValue1 = await rinzu.http.close(client);
            }
            catch [resultError1: Error, ...resultRest1] {
                rinzu.core.panic("badClose");
            }
        }
        if rinzu.http.liveClients() != 0 || rinzu.http.liveBuffers() != 0 {
            rinzu.core.panic("badLive");
        }
        rinzu.stdio.writeLine("http-basic-ok");
    }
    catch unexpectedEntryErrors {
        rinzu.core.panic("unexpectedEntryFailure");
    }
}
