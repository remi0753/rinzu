import rinzu.timer;
import rinzu.http;
import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.error as err;
import rinzu.future as future;

fn expected(failure: Error, status: Int) {
    if failure is rinzu.http.HttpFailure {
        expectedHttp(failure, status);
    }
    else {
        rinzu.core.panic("unexpectedFailureType");
    }
}

fn expectedHttp(failure: rinzu.http.HttpFailure, status: Int) {
    switch err.nativeStatus(failure.payload.cause) {
        case Option.Some(value): {
            if value != status {
                rinzu.core.panic("badStatus");
            }
        }
        case Option.None: {
            rinzu.core.panic("badNative");
        }
    }
}

async fn main() {
    try {
        let client = rinzu.http.newClient();
        let controls = rinzu.http.retainedControlBytes();
        try all {
            try {
                let resultValue13 = await rinzu.http.request(client, "BASE/slow", bytesApi.from(b""), false, 20);
                rinzu.core.panic("badTimeout");
            }
            catch [resultError13: Error, ...resultRest13] {
                expected(resultError13, 28);
            }
            try {
                let resultValue12 = await rinzu.http.request(client, "BASE/huge", bytesApi.from(b""), false, 2000);
                rinzu.core.panic("badBound");
            }
            catch [resultError12: Error, ...resultRest12] {
                if resultError12 is rinzu.http.HttpFailure {
                    expected(resultError12, -7306);
                    if bytesApi.length(resultError12.payload.partial) > 65536 {
                        rinzu.core.panic("badPartialBound");
                    }
                }
                else {
                    throw resultError12;
                }
            }
            try {
                let resultValue11 = await rinzu.http.request(client, "BASE/redirect", bytesApi.from(b""), false, 2000);
                if resultValue11.status != 302 || bytesApi.length(resultValue11.body) != 0 {
                    rinzu.core.panic("badFollow");
                }
            }
            catch [resultError11: Error, ...resultRest11] {
                rinzu.core.panic("badRedirect");
            }
            try {
                let resultValue10 = await rinzu.http.request(client, "BASE/status", bytesApi.from(b""), false, 2000);
                if resultValue10.status != 503 {
                    rinzu.core.panic("bad503");
                }
            }
            catch [resultError10: Error, ...resultRest10] {
                rinzu.core.panic("badHttpStatus");
            }
            try {
                let resultValue9 = await rinzu.http.request(client, "SSLBASE/binary", bytesApi.from(b""), false, 1000);
                rinzu.core.panic("badTls");
            }
            catch [resultError9: Error, ...resultRest9] {
                expected(resultError9, 60);
            }
            try {
                let resultValue8 = await rinzu.http.request(
                    client,
                    "http://example.com/",
                    bytesApi.from(b""),
                    false,
                    2000
                );
                rinzu.core.panic("badPolicy");
            }
            catch [resultError8: Error, ...resultRest8] {
                expected(resultError8, -7304);
            }
            try {
                let resultValue7 = await rinzu.http.request(
                    client,
                    "http://user@127.0.0.1/",
                    bytesApi.from(b""),
                    false,
                    2000
                );
                rinzu.core.panic("badUser");
            }
            catch [resultError7: Error, ...resultRest7] {
                expected(resultError7, -7304);
            }
            try {
                let resultValue6 = await rinzu.http.request(
                    client,
                    "BASE/\u{0}hidden",
                    bytesApi.from(b""),
                    false,
                    2000
                );
                rinzu.core.panic("badNul");
            }
            catch [resultError6: Error, ...resultRest6] {
                expected(resultError6, -7304);
            }
            try all {
                let pending = rinzu.http.request(client, "BASE/slow", bytesApi.from(b""), false, 2000);
                let settled = cancelledRequest(pending);
                try {
                    let resultValue5 = await rinzu.http.close(client);
                    rinzu.core.panic("badBusyClose");
                }
                catch [resultError5: Error, ...resultRest5] {
                    switch err.nativeStatus(resultError5) {
                        case Option.Some(status): {
                            if status != -7303 {
                                rinzu.core.panic("badBusyStatus");
                            }
                        }
                        case Option.None: {
                            rinzu.core.panic("badBusyNative");
                        }
                    }
                }
                let cancelled = future.cancel(pending);
                if !cancelled {
                    rinzu.core.panic("badCancel");
                }
                while !future.isReady(settled) {
                    await rinzu.timer.sleep(1);
                }
            }
            finally {}
            var i = 0;
            while i < 32 {
                try {
                    let resultValue4 = await rinzu.http.request(client, "BASE/binary", bytesApi.from(b""), false, 2000);
                    if bytesApi.length(resultValue4.body) != 8192 {
                        rinzu.core.panic("badSize");
                    }
                }
                catch [resultError4: Error, ...resultRest4] {
                    rinzu.core.panic("badRecovery");
                }
                if rinzu.http.liveBuffers() != 0 || rinzu.http.retainedControlBytes() != controls {
                    rinzu.core.panic("badGrowth");
                }
                i = i + 1;
            }
        }
        finally {
            try {
                let resultValue3 = await rinzu.http.close(client);
            }
            catch [resultError3: Error, ...resultRest3] {
                rinzu.core.panic("badClose");
            }
        }
        try {
            let resultValue2 = await rinzu.http.close(client);
            rinzu.core.panic("badTwice");
        }
        catch [resultError2: Error, ...resultRest2] {}
        try {
            let resultValue1 = await rinzu.http.request(client, "BASE/binary", bytesApi.from(b""), false, 2000);
            rinzu.core.panic("badClosed");
        }
        catch [resultError1: Error, ...resultRest1] {
            expected(resultError1, -7302);
        }
        if rinzu.http.liveClients() != 0 || rinzu.http.liveBuffers() != 0 {
            rinzu.core.panic("badLive");
        }
        rinzu.stdio.writeLine("http-stress-ok");
    }
    catch unexpectedEntryErrors {
        rinzu.core.panic("unexpectedEntryFailure");
    }
}

// Retain an observation path while independently checking physical cancellation.
async fn cancelledRequest(value: Future<rinzu.http.Response>) {
    try {
        let response = await value;
    }
    catch errors {
        rinzu.core.panic("unexpectedRequestFailure");
    }
}
