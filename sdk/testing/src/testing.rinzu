import rinzu.bytes as bytesApi;
import rinzu.stdio;
import rinzu.string as textApi;

native {
    fn beginCase(name: ByteArray, length: CSize) -> Int symbol "rinzu_testing_case_begin";

    fn recordError(name: ByteArray, nameLength: CSize, message: ByteArray, messageLength: CSize)
        symbol "rinzu_testing_case_error";

    fn endCase(failed: Int) symbol "rinzu_testing_case_end";
}

/// A recoverable test assertion failure, including the caller's message.
error AssertionFailed {}

/// A named case could not start in the current test context.
error InvalidTestCase {}

fn selectCase(name: String) throws(InvalidTestCase) -> Bool {
    let encoded = textApi.encodeUtf8(name);
    let selection = beginCase(encoded, bytesApi.byteLength(encoded));
    if selection < 0 {
        throw InvalidTestCase(message: f"cannot start test case: {name}");
    }
    return selection == 1;
}

fn recordFailure(problems: List<Error>) {
    for problem in problems {
        let name = textApi.encodeUtf8(problem.name);
        let message = textApi.encodeUtf8(problem.message);
        recordError(name, bytesApi.byteLength(name), message, bytesApi.byteLength(message));
    }
    endCase(1);
}

/// Run a named synchronous case in a .test.rinzu file.
/// Record ordinary Errors as case failures and return to the file's main.
fn runCase(name: String, body: fn () throws(Error) -> Unit) throws(InvalidTestCase) {
    if !selectCase(name) {
        return;
    }
    try {
        body();
    }
    catch problems {
        recordFailure(problems);
        return;
    }
    endCase(0);
}

/// Run and await a named asynchronous case in a .test.rinzu file.
async fn runAsyncCase(name: String, body: fn () throws(Error) -> Future<Unit>) throws(InvalidTestCase) {
    if !selectCase(name) {
        return;
    }
    try {
        await body();
    }
    catch problems {
        recordFailure(problems);
        return;
    }
    endCase(0);
}

/// Assert a condition using AssertionFailed on failure.
/// Success returns Unit without output. A failed assertion prints the message.
/// Let failures propagate from tests; use finally for fixture/Owner cleanup.
///
/// ```rinzu-test
/// import rinzu.testing;
///
/// fn main() {
///     rinzu.testing.assertTrue(true, "positive assertion");
/// }
/// ```
fn assertTrue(condition: Bool, message: String) {
    if !condition {
        rinzu.stdio.writeLine(f"assertTrue failed: {message}");
        throw AssertionFailed(message: message);
    }
}

/// Compare actual and expected with the normal Equality marker rules.
/// A mismatch prints the message and both values, then throws AssertionFailed.
/// Observe native Owner handles separately; this helper does not close resources.
///
/// ```rinzu-test
/// import rinzu.testing;
///
/// fn main() {
///     rinzu.testing.assertEqual<ByteArray>(byteArray(b"\x00\xff"), byteArray(b"\x00\xff"), "binary equality");
/// }
/// ```
fn assertEqual<T: Equality>(actual: T, expected: T, message: String) {
    if actual != expected {
        rinzu.stdio.writeLine(f"assertEqual failed: {message}");
        rinzu.stdio.writeLine("actual:");
        rinzu.stdio.writeLine(actual);
        rinzu.stdio.writeLine("expected:");
        rinzu.stdio.writeLine(expected);
        throw AssertionFailed(message: message);
    }
}

export assertTrue;
export assertEqual;
export AssertionFailed;
export InvalidTestCase;
export runCase;
export runAsyncCase;
