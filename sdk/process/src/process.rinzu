import rinzu.option;
import rinzu.bytes as bytesApi;
import rinzu.error as err;
import rinzu.native as bridge;
import rinzu.number as num;
import rinzu.string as textApi;

error InvalidArgumentEncoding {
    payload: { index: Int, byteOffset: Int }
}

enum ArgumentSnapshot {
    Ready(value: List<String>),
    Invalid(index: Int, byteOffset: Int)
}

fn arguments() throws(InvalidArgumentEncoding) -> List<String> {
    switch argumentSnapshot() {
        case ArgumentSnapshot.Ready(values): {
            return values;
        }
        case ArgumentSnapshot.Invalid(index, offset): {
            throw InvalidArgumentEncoding(
                message: "process argument is not valid UTF-8",
                payload: { index = index, byteOffset = offset }
            );
        }
    }
}

export arguments;
export InvalidArgumentEncoding;

native {
    fn rawRead(name: String) -> Int symbol "rinzu_process_environment_read";

    fn rawBytes() -> Bytes(4096) symbol "rinzu_process_environment_bytes";

    fn rawErrorLine(bytes: ByteArray, length: CSize) -> CInt symbol "rinzu_process_error_line";

    fn identifier() -> Int symbol "rinzu_process_identifier";
}

fn environment(name: String) -> Option<String> {
    if textApi.utf8ByteLength(name) == 0 || textApi.utf8ByteLength(name) > 1024 {
        throw err.create(610, "process.environment.name");
    }
    switch textApi.find(name, "\u{0}", 0) {
        case Option.Some(index): {
            throw err.create(610, "process.environment.name");
        }
        case Option.None: {}
    }
    let length = rawRead(name);
    if length == -1 {
        return (Option<String>.None());
    }
    if length < 0 {
        throw err.create(610, "process.environment.length");
    }
    switch bytesApi.slice(bytesApi.from(rawBytes()), 0, length) {
        case Option.None: {
            throw err.create(610, "process.environment.snapshot");
        }
        case Option.Some(bytes): {
            let resultValue4 = textApi.decodeUtf8(bytes);
            return (Option<String>.Some(value: resultValue4));
        }
    }
}

fn setting(name: String, defaultValue: String) -> String {
    return rinzu.option.getOrElse(
        environment(name),
        fn () -> String {
            return defaultValue;
        }
    );
}

fn integer(name: String, defaultValue: Int, minimum: Int, maximum: Int) -> Int {
    let parsed = rinzu.option.map(
        environment(name),
        fn (text: String) -> Int {
            return num.parseInt(text);
        }
    );
    let number = rinzu.option.getOrElse(
        parsed,
        fn () -> Int {
            return defaultValue;
        }
    );
    if number < minimum || number > maximum {
        throw err.create(610, "process.integer.range");
    }
    return number;
}

export environment;
export setting;
export integer;

// Explicit Main-only status. Root cleanup completes before the host returns it.
fn setExitStatus(status: Int) -> Bool {
    return setProcessExitStatus(status);
}

fn writeErrorLine(text: String) -> Int {
    let data = textApi.encodeUtf8(f"{text}\n");
    if bytesApi.length(data) > 4096 {
        throw err.create(610, "process.stderr.length");
    }
    return bridge.checkStatus(Int(rawErrorLine(data, bytesApi.byteLength(data))), "process.stderr");
}

export setExitStatus;
export writeErrorLine;
export identifier;
