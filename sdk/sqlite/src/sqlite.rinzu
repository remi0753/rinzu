export close;
export isOpen;
export isStatementOpen;
export executeWithObserver;
export retainedControlBytes;

fn ownedCopy(connection: Connection, sql: String, text: Bool) -> ByteArray {
    switch stringFind(sql, "\u{0}", 0) {
        case Option.Some(index): {
            throw error(-7010, "sqlite.query.input");
        }
        case Option.None: {}
    }
    let resultValue6 = nativeStatus(Int(rawOwnedReady(connection.handle)), "sqlite.query.owner");
    // Protect acquisition itself: cancellation may arrive at the native return boundary.
    try {
        let resultValue5 = nativeStatus(Int(rawOwnedBegin(connection.handle, sql, text)), "sqlite.query.data");
        let all = byteArray(rawOwnedBytes(connection.handle));
        switch bytesSlice(all, 0, rawOwnedLength(connection.handle)) {
            case Option.Some(data): {
                return (data);
            }
            case Option.None: {
                throw error(-7010, "sqlite.query.length");
            }
        }
    }
    finally {
        let released = rawOwnedRelease(connection.handle);
    }
    throw error(-7010, "sqlite.query.unreachable");
}

fn queryBytes(connection: Connection, sql: String) -> ByteArray {
    return ownedCopy(connection, sql, false);
}

fn queryText(connection: Connection, sql: String) -> String {
    let resultValue4 = ownedCopy(connection, sql, true);
    return utf8Decode(resultValue4);
    throw error(-7010, "sqlite.queryText.unreachable");
}

export queryBytes;
export queryText;
export ownedAllocations;
export ownedReleases;
export ownedLive;

fn setDeadline(connection: Connection, milliseconds: Int) -> Int {
    return nativeStatus(Int(rawDeadline(connection.handle, milliseconds)), "sqlite.deadline");
}

fn inTransaction(connection: Connection) -> Bool {
    let state = Int(rawTransactionState(connection.handle));
    if state == 0 {
        return (false);
    }
    if state == 1 {
        return (true);
    }
    let resultValue3 = nativeStatus(state, "sqlite.inTransaction");
    return (false);
}

fn queryByteRows(connection: Connection, sql: String, maximumRows: Int) -> List<ByteArray> {
    if maximumRows < 1 || maximumRows > 256 {
        throw error(-7010, "sqlite.query.rows");
    }
    switch stringFind(sql, "\u{0}", 0) {
        case Option.Some(index): {
            throw error(-7010, "sqlite.query.input");
        }
        case Option.None: {}
    }
    let resultValue2 = nativeStatus(Int(rawOwnedReady(connection.handle)), "sqlite.query.owner");
    try {
        let resultValue1 = nativeStatus(
            Int(rawOwnedRowsBegin(connection.handle, sql, maximumRows)),
            "sqlite.query.rows"
        );
        let data = byteArray(rawOwnedBytes(connection.handle));
        let count = rawOwnedRows(connection.handle);
        var rows: List<ByteArray> = [];
        var row = 0;
        var offset = 0;
        while row < count {
            let length = rawOwnedRowLength(connection.handle, row);
            switch bytesSlice(data, offset, offset + length) {
                case Option.None: {
                    throw error(-7010, "sqlite.query.rowLength");
                }
                case Option.Some(value): {
                    rows = rinzu.List.append(rows, value);
                }
            }
            row = row + 1;
            offset = offset + length;
        }
        return (rows);
    }
    finally {
        let released = rawOwnedRelease(connection.handle);
    }
    throw error(-7010, "sqlite.query.unreachable");
}

