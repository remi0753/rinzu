import rinzu.timer;
import rinzu.sqlite;
import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.future as future;

fn worker() -> ByteArray {
    try {
        let resultValue2 = rinzu.sqlite.openMemory();
        try {
            try {
                let resultValue1 = resultValue2.queryBytes("SELECT x'00ff0001'");
                return resultValue1;
            }
            catch [resultError1: Error, ...resultRest1] {
                rinzu.core.panic("badQuery");
            }
        }
        finally {
            let closed = resultValue2.close();
        }
    }
    catch [resultError2: Error, ...resultRest2] {
        rinzu.core.panic("badOpen");
    }
    return bytesApi.from(b"");
}

async fn main() {
    try {
        try all {
            let child = spawn worker();
            await rinzu.sqlite.gateStarted();
            if rinzu.sqlite.ownedLive() != 1 {
                rinzu.core.panic("badHeld");
            }
            let cancelled = future.cancel(child);
            if !cancelled {
                rinzu.core.panic("badCancel");
            }
            if rinzu.sqlite.ownedLive() != 1 {
                rinzu.core.panic("badEarlyFree");
            }
            rinzu.sqlite.gateRelease();
            while !future.isReady(child) {
                await rinzu.timer.sleep(1);
            }
        }
        finally {}
        if rinzu.sqlite.ownedLive() != 0 || rinzu.sqlite.ownedAllocations() != 1 || rinzu.sqlite.ownedReleases() != 1 {
            rinzu.core.panic("badBaseline");
        }
        rinzu.stdio.writeLine("owned-cancel-ok");
    }
    catch unexpectedEntryErrors {
        rinzu.core.panic("unexpectedEntryFailure");
    }
}
