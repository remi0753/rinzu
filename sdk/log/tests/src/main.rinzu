import rinzu.log;
import rinzu.io;
import rinzu.stdio;
import rinzu.core;
import rinzu.error as err;

async fn main() {
    try {
        try {
            let resultValue8 = await rinzu.log.open("events.log");
            try all {
                let first = rinzu.log.emit(resultValue8, 1, 0, 0, 0);
                try {
                    let resultValue7 = await rinzu.log.emit(resultValue8, 1, 0, 1, 0);
                    rinzu.core.panic("badOverlap");
                }
                catch [resultError7: Error, ...resultRest7] {
                    if err.code(resultError7) != Option<Int>.Some(value: -7401) {
                        rinzu.core.panic("badBusy");
                    }
                }
                try {
                    let resultValue6 = await first;
                }
                catch [resultError6: Error, ...resultRest6] {
                    rinzu.core.panic("badFirst");
                }
                var i = 1;
                while i < 1000 {
                    try {
                        let resultValue5 = await rinzu.log.emit(resultValue8, 1, i, 2, 0);
                    }
                    catch [resultError5: Error, ...resultRest5] {
                        rinzu.core.panic("badRow");
                    }
                    i = i + 1;
                }
                try {
                    let resultValue4 = await rinzu.log.emit(resultValue8, 4, 0, 0, 0);
                    rinzu.core.panic("badLevel");
                }
                catch [resultError4: Error, ...resultRest4] {}
                try {
                    let resultValue3 = await rinzu.log.flush(resultValue8);
                }
                catch [resultError3: Error, ...resultRest3] {
                    rinzu.core.panic("badFlush");
                }
            }
            finally {
                try {
                    let resultValue2 = await rinzu.log.close(resultValue8);
                }
                catch [resultError2: Error, ...resultRest2] {
                    rinzu.core.panic("badClose");
                }
            }
            try {
                let resultValue1 = await rinzu.log.emit(resultValue8, 1, 0, 0, 0);
                rinzu.core.panic("badClosed");
            }
            catch [resultError1: Error, ...resultRest1] {
                if err.code(resultError1) != Option<Int>.Some(value: -7402) {
                    rinzu.core.panic("badClosedCode");
                }
            }
        }
        catch [resultError8: Error, ...resultRest8] {
            rinzu.core.panic("badOpen");
        }
        if rinzu.io.liveFiles() != 0 || rinzu.io.liveBuffers() != 0 {
            rinzu.core.panic("badLive");
        }
        rinzu.stdio.writeLine("log-ok");
    }
    catch unexpectedEntryErrors {
        rinzu.core.panic("unexpectedEntryFailure");
    }
}
