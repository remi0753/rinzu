import rinzu.bytes as bytesApi;
import rinzu.core as core;
import rinzu.error as err;
import rinzu.list as listApi;
import rinzu.native as bridge;
import rinzu.string as textApi;

fn readSize(path: String) -> Future<Int> {
    return readResourceSize(path);
}

native {
    opaque File;

    opaque Completion;

    fn rawCompletion(file: File) -> Completion symbol "rinzu_io_completion";

    fn rawOpen(path: String, writing: CInt) -> File symbol "rinzu_io_open";

    fn rawTemporary(path: String) -> File symbol "rinzu_io_temporary";

    fn rawInstallTemporary(file: File, destination: String) -> CInt symbol "rinzu_io_install_temporary";

    fn rawStandard(stream: CInt) -> File symbol "rinzu_io_standard";

    fn rawOwnerHasFile() -> CBool symbol "rinzu_io_owner_has_file";

    fn rawOwnerFile() -> File symbol "rinzu_io_owner_file";

    fn rawPending(file: File) -> CBool symbol "rinzu_io_pending";

    fn rawReadyStatus(file: File) -> CInt symbol "rinzu_io_ready_status";

    fn rawRead(file: File, maximum: Int) -> CInt symbol "rinzu_io_read";

    fn rawWrite(file: File, data: ByteArray, length: CSize) -> CInt symbol "rinzu_io_write";

    fn rawWriteAll(file: File, data: ByteArray, length: CSize) -> CInt symbol "rinzu_io_write_all";

    fn rawFlush(file: File) -> CInt symbol "rinzu_io_flush";

    fn rawClose(file: File) -> CInt symbol "rinzu_io_close";

    fn rawPath(from: String, to: String, removing: CInt) -> File symbol "rinzu_io_path";

    fn rawReady(file: File) -> CBool symbol "rinzu_io_ready";

    fn rawStatus(file: File) -> CInt symbol "rinzu_io_status";

    fn rawLength(file: File) -> Int symbol "rinzu_io_length";

    fn rawBytes(file: File) -> Bytes(65536) symbol "rinzu_io_bytes";

    fn rawCancel(file: File) -> Unit symbol "rinzu_io_cancel";

    fn rawFinish(file: File) -> Unit symbol "rinzu_io_finish";

    fn monotonicMillis() -> Int symbol "rinzu_io_monotonic";

    fn unixMillis() -> Int symbol "rinzu_io_unix";

    fn liveFiles() -> Int symbol "rinzu_io_live_files";

    fn liveBuffers() -> Int symbol "rinzu_io_live_buffers";

    fn liveOperations() -> Int symbol "rinzu_io_live_operations";

    fn retainedControlBytes() -> Int symbol "rinzu_io_retained_controls";
}

export readSize;

class ReadChunk {
    const data: ByteArray,
    const eof: Bool
}

fn invalidPath(path: String) -> Bool {
    if textApi.length(path) == 0 {
        return true;
    }
    switch textApi.find(path, "\u{0}", 0) {
        case Option.Some(index): {
            return true;
        }
        case Option.None: {
            return false;
        }
    }
}

fn problem(status: Int, label: String) -> Error {
    try {
        let resultValue7 = bridge.checkStatus(status, label);
        return err.create(-7104, label);
    }
    catch [resultError7: Error, ...resultRest7] {
        return resultError7;
    }
}

async fn wait(file: File) {
    await bridge.completed(rawCompletion(file));
}

async fn settle(file: File) {
    rawCancel(file);
    await wait(file);
    rawFinish(file);
}

async fn open(path: String, writing: CInt) -> File {
    if invalidPath(path) {
        throw problem(-7104, "io.open");
    }
    let file = rawOpen(path, writing);
    var delivered = false;
    try {
        await wait(file);
        let resultValue6 = bridge.checkStatus(Int(rawStatus(file)), "io.open");
        delivered = true;
        return (file);
    }
    finally {
        await settle(file);
        if !delivered {
            let disposed = await close(file);
        }
    }
    throw problem(-7104, "io.open.unreachable");
}

async fn openRead(path: String) -> File {
    return await open(path, CInt(0));
}

async fn openWrite(path: String) -> File {
    return await open(path, CInt(1));
}

/// Create a unique regular file with a template ending in XXXXXX.
/// close removes it unless installTemporary has physically completed.
async fn openTemporary(template: String) -> File {
    if invalidPath(template) {
        throw problem(-7104, "io.temporary.path");
    }
    let file = rawTemporary(template);
    var delivered = false;
    try {
        await wait(file);
        let status = bridge.checkStatus(Int(rawStatus(file)), "io.temporary");
        delivered = true;
        return file;
    }
    finally {
        await settle(file);
        if !delivered {
            let disposed = await close(file);
        }
    }
}

/// Atomically rename an open temporary file, preserving it after close.
async fn installTemporary(file: File, destination: String) -> Int {
    if invalidPath(destination) {
        throw problem(-7104, "io.temporary.destination");
    }
    try {
        let admitted = bridge.checkStatus(Int(rawInstallTemporary(file, destination)), "io.temporary.install");
        await wait(file);
        return bridge.checkStatus(Int(rawStatus(file)), "io.temporary.install");
    }
    finally {
        if rawPending(file) {
            await settle(file);
        }
    }
}

async fn standard(stream: CInt) -> File {
    let file = rawStandard(stream);
    var delivered = false;
    try {
        await wait(file);
        let resultValue5 = bridge.checkStatus(Int(rawStatus(file)), "io.standard");
        delivered = true;
        return (file);
    }
    finally {
        await settle(file);
        if !delivered {
            let disposed = await close(file);
        }
    }
    throw problem(-7104, "io.standard.unreachable");
}

async fn standardInput() -> File {
    return await standard(CInt(0));
}

async fn standardOutput() -> File {
    return await standard(CInt(1));
}

async fn read(file: File, maximum: Int) -> ReadChunk {
    if maximum < 1 || maximum > 65536 {
        throw problem(-7104, "io.read");
    }
    let ready = Int(rawReadyStatus(file));
    if ready != 0 {
        throw problem(ready, "io.read");
    }
    try {
        let started = Int(rawRead(file, maximum));
        if started != 0 {
            throw problem(started, "io.read");
        }
        await wait(file);
        let resultValue4 = bridge.checkStatus(Int(rawStatus(file)), "io.read");
        let valid = rawLength(file);
        let all = bytesApi.from(rawBytes(file));
        switch bytesApi.slice(all, 0, valid) {
            case Option.Some(data): {
                return (ReadChunk(data: data, eof: valid == 0));
            }
            case Option.None: {
                throw problem(-7104, "io.read.validLength");
            }
        }
    }
    finally {
        if rawPending(file) {
            await settle(file);
        }
    }
    throw problem(-7104, "io.read.unreachable");
}

async fn write(file: File, data: ByteArray) -> Int {
    if bytesApi.length(data) > 65536 {
        throw problem(-7104, "io.write");
    }
    let ready = Int(rawReadyStatus(file));
    if ready != 0 {
        throw problem(ready, "io.write");
    }
    try {
        let started = Int(rawWrite(file, data, bytesApi.byteLength(data)));
        if started != 0 {
            throw problem(started, "io.write");
        }
        await wait(file);
        let resultValue3 = bridge.checkStatus(Int(rawStatus(file)), "io.write");
        return (rawLength(file));
    }
    finally {
        if rawPending(file) {
            await settle(file);
        }
    }
    throw problem(-7104, "io.write.unreachable");
}

async fn writeAll(file: File, data: ByteArray) -> Int {
    let length = bytesApi.length(data);
    if length > 65536 {
        throw problem(-7104, "io.writeAll");
    }
    let ready = Int(rawReadyStatus(file));
    if ready != 0 {
        throw problem(ready, "io.writeAll");
    }
    try {
        let started = Int(rawWriteAll(file, data, bytesApi.byteLength(data)));
        if started != 0 {
            throw problem(started, "io.writeAll");
        }
        await wait(file);
        let resultValue2 = bridge.checkStatus(Int(rawStatus(file)), "io.writeAll");
        return (rawLength(file));
    }
    finally {
        if rawPending(file) {
            await settle(file);
        }
    }
    throw problem(-7104, "io.writeAll.unreachable");
}

async fn control(file: File, flushing: Bool, label: String) -> Int {
    let ready = Int(rawReadyStatus(file));
    if ready != 0 {
        throw problem(ready, label);
    }
    try {
        var started = 0;
        if flushing {
            started = Int(rawFlush(file));
        }
        else {
            started = Int(rawClose(file));
        }
        if started != 0 {
            throw problem(started, label);
        }
        await wait(file);
        return bridge.checkStatus(Int(rawStatus(file)), label);
    }
    finally {
        if rawPending(file) {
            await settle(file);
        }
    }
    throw problem(-7104, "io.finish.unreachable");
}

async fn flush(file: File) -> Int {
    return await control(file, true, "io.flush");
}

async fn close(file: File) -> Int {
    return await control(file, false, "io.close");
}

async fn closeOwnerFiles() -> Int {
    // Explicit whole-Owner drain, after Source children have physically joined.
    // Includes unpublished open/dup handles and path operations.
    try {
        while rawOwnerHasFile() {
            let file = rawOwnerFile();
            if rawPending(file) {
                await settle(file);
            }
            else {
                let resultValue1 = await close(file);
            }
        }
    }
    finally {}
    return (0);
}

async fn pathOperation(from: String, to: String, removing: CInt) -> Int {
    if invalidPath(from) || (removing == CInt(0) && invalidPath(to)) {
        throw problem(-7104, "io.path");
    }
    let operation = rawPath(from, to, removing);
    try {
        await wait(operation);
        return bridge.checkStatus(Int(rawStatus(operation)), "io.path");
    }
    finally {
        await settle(operation);
    }
    throw problem(-7104, "io.path.unreachable");
}

async fn rename(from: String, to: String) -> Int {
    return await pathOperation(from, to, CInt(0));
}

async fn remove(path: String) -> Int {
    return await pathOperation(path, "", CInt(1));
}

export File;
export ReadChunk;
export openRead;
export openWrite;
export openTemporary;
export installTemporary;
export read;
export write;
export writeAll;
export flush;
export close;
export rename;
export remove;
export monotonicMillis;
export unixMillis;
export liveFiles;
export liveBuffers;
export retainedControlBytes;
export standardInput;
export standardOutput;
export closeOwnerFiles;
export liveOperations;

enum FilePhase {
    ValidatePath,
    Submit,
    OpenFile,
    Read,
    OpenDirectory,
    InspectDestination,
    CreateTemporary,
    Write,
    CopyMetadata,
    Flush,
    Install,
    CloseFile,
    RemoveTemporary,
    CloseDirectory
}

type FileFailure = {
    path: String,
    phase: FilePhase,
    status: Option<Int>,
    temporaryName: Option<String>
};

error FileOperationFailed {
    payload: FileFailure
}

error InvalidReadLimit {
    payload: { maxBytes: Int }
}

error ReadLimitExceeded {
    payload: { path: String, maxBytes: Int }
}

error InvalidFileUtf8 {
    payload: { path: String }
}

error InstallUncertain {
    payload: FileFailure
}

type ReplaceReceipt = {
    bytesWritten: Int,
    cleanupErrors: List<FileOperationFailed>
};

native {
    opaque WholeFile;

    fn rawWholeNew(path: String, maximum: Int, replacing: CBool) -> WholeFile symbol "rinzu_io_whole_new";

    fn rawWholeOpen(file: WholeFile) -> Unit symbol "rinzu_io_whole_open";

    fn rawWholeRead(file: WholeFile) -> Unit symbol "rinzu_io_whole_read";

    fn rawWholeWrite(file: WholeFile, data: ByteArray, length: CSize) -> Unit symbol "rinzu_io_whole_write";

    fn rawWholeInstall(file: WholeFile) -> Unit symbol "rinzu_io_whole_install";

    fn rawWholeCancelPending(file: WholeFile) -> CBool symbol "rinzu_io_whole_cancel_pending";

    fn rawWholeCleanup(file: WholeFile) -> CBool symbol "rinzu_io_whole_cleanup";

    fn rawWholeRelease(file: WholeFile) -> Unit symbol "rinzu_io_whole_release";

    fn rawWholeStatus(file: WholeFile) -> Int symbol "rinzu_io_whole_status";

    fn rawWholePhase(file: WholeFile) -> Int symbol "rinzu_io_whole_phase";

    fn rawWholeEof(file: WholeFile) -> CBool symbol "rinzu_io_whole_eof";

    fn rawWholeLimitExceeded(file: WholeFile) -> CBool symbol "rinzu_io_whole_limit_exceeded";

    fn rawWholeBytes(file: WholeFile) -> ByteArray symbol "rinzu_io_whole_bytes";

    fn rawWholeInstallResult(file: WholeFile) -> Int symbol "rinzu_io_whole_install_result";

    fn rawWholeCleanupStatus(file: WholeFile, index: Int) -> Int symbol "rinzu_io_whole_cleanup_status";

    fn rawWholeTemporaryName(file: WholeFile) -> String symbol "rinzu_io_whole_temporary_name";
}

fn wholePhase(file: WholeFile) -> FilePhase {
    // Same order as RinzuIoFilePhase in the private bridge.
    let phases = [
        FilePhase.ValidatePath(),
        FilePhase.Submit(),
        FilePhase.OpenFile(),
        FilePhase.Read(),
        FilePhase.OpenDirectory(),
        FilePhase.InspectDestination(),
        FilePhase.CreateTemporary(),
        FilePhase.Write(),
        FilePhase.CopyMetadata(),
        FilePhase.Flush(),
        FilePhase.Install(),
        FilePhase.CloseFile(),
        FilePhase.RemoveTemporary(),
        FilePhase.CloseDirectory()
    ];
    switch listApi.get(phases, rawWholePhase(file)) {
        case Option.Some(phase): {
            return phase;
        }
        case Option.None: {
            core.panic("invalid whole-file phase");
            return FilePhase.Submit();
        }
    }
}

fn fileFailure(path: String, phase: FilePhase, cause: Error, temporaryName: Option<String>) -> FileOperationFailed {
    return FileOperationFailed(
        message: f"File operation failed at {phase} for {path}: {cause.message}",
        cause: cause,
        payload: {
            path = path,
            phase = phase,
            status = err.nativeStatus(cause),
            temporaryName = temporaryName
        }
    );
}

fn checkWholeStatus(file: WholeFile, path: String) throws(FileOperationFailed) {
    let status = rawWholeStatus(file);
    if status != 0 {
        let phase = wholePhase(file);
        throw fileFailure(path, phase, problem(status, f"io.{phase}"), Option<String>.None());
    }
}

fn newWhole(path: String, maximum: Int, replacing: CBool) throws(FileOperationFailed) -> WholeFile {
    if invalidPath(path) {
        throw fileFailure(path, FilePhase.ValidatePath(), problem(-7104, "io.path"), Option<String>.None());
    }
    try {
        return rawWholeNew(path, maximum, replacing);
    }
    catch [cause: Error, ...rest] {
        throw fileFailure(path, FilePhase.Submit(), cause, Option<String>.None());
    }
}

async fn waitWhole(file: WholeFile, path: String, phase: FilePhase) throws(FileOperationFailed) {
    try {
        await bridge.completed(file);
    }
    catch [cause: Error, ...rest] {
        throw fileFailure(path, phase, cause, Option<String>.None());
    }
}

fn wholeTemporaryName(file: WholeFile) -> Option<String> {
    try {
        return Option<String>.Some(value: rawWholeTemporaryName(file));
    }
    catch problems {
        return Option<String>.None();
    }
}

fn cleanupIssue(file: WholeFile, path: String, index: Int) -> Option<FileOperationFailed> {
    let status = rawWholeCleanupStatus(file, index);
    if status == 0 {
        return Option<FileOperationFailed>.None();
    }
    var phase = FilePhase.CloseFile();
    var name = Option<String>.None();
    if index == 2 {
        phase = FilePhase.RemoveTemporary();
        name = wholeTemporaryName(file);
    }
    else if index == 3 {
        phase = FilePhase.CloseDirectory();
    }
    return Option<FileOperationFailed>.Some(value: fileFailure(path, phase, problem(status, f"io.{phase}"), name));
}

fn throwCleanupIssue(file: WholeFile, path: String, index: Int) throws(FileOperationFailed) {
    switch cleanupIssue(file, path, index) {
        case Option.Some(issue): {
            throw issue;
        }
        case Option.None: {}
    }
}

async fn finishWhole(file: WholeFile, path: String) throws(FileOperationFailed) {
    try {
        if rawWholeCancelPending(file) {
            await waitWhole(file, path, FilePhase.Submit());
        }
        if rawWholeCleanup(file) {
            await waitWhole(file, path, FilePhase.CloseFile());
        }
        try all {
            throwCleanupIssue(file, path, 0);
            throwCleanupIssue(file, path, 1);
            throwCleanupIssue(file, path, 2);
            throwCleanupIssue(file, path, 3);
        }
        finally {}
    }
    finally {
        rawWholeRelease(file);
    }
}

fn checkReadLimit(maxBytes: Int) throws(InvalidReadLimit) {
    if maxBytes < 0 {
        throw InvalidReadLimit(message: "File read limit must be nonnegative", payload: { maxBytes = maxBytes });
    }
}

async fn readWhole(file: WholeFile, path: String, maxBytes: Int) throws(ReadLimitExceeded, FileOperationFailed)
    -> ByteArray {
    rawWholeOpen(file);
    await waitWhole(file, path, FilePhase.OpenFile());
    checkWholeStatus(file, path);
    while !rawWholeEof(file) {
        rawWholeRead(file);
        await waitWhole(file, path, FilePhase.Read());
        checkWholeStatus(file, path);
        if rawWholeLimitExceeded(file) {
            throw ReadLimitExceeded(
                message: f"File exceeds the {maxBytes}-byte limit: {path}",
                payload: { path = path, maxBytes = maxBytes }
            );
        }
    }
    try {
        return rawWholeBytes(file);
    }
    catch [cause: Error, ...rest] {
        throw fileFailure(path, FilePhase.Read(), cause, Option<String>.None());
    }
}

/// Read a regular file completely, up to the required byte limit.
async fn readBytes(path: String, maxBytes: Int) throws(InvalidReadLimit, ReadLimitExceeded, FileOperationFailed)
    -> ByteArray {
    checkReadLimit(maxBytes);
    let file = newWhole(path, maxBytes, false);
    try {
        return await readWhole(file, path, maxBytes);
    }
    finally {
        await finishWhole(file, path);
    }
}

/// Read and strictly decode a regular file as UTF-8, preserving its BOM, NULs and newlines.
async fn readText(path: String, maxBytes: Int) throws(
    InvalidReadLimit,
    ReadLimitExceeded,
    FileOperationFailed,
    InvalidFileUtf8
) -> String {
    checkReadLimit(maxBytes);
    let file = newWhole(path, maxBytes, false);
    try {
        let data = await readWhole(file, path, maxBytes);
        try {
            return textApi.decodeUtf8(data);
        }
        catch [cause: Error, ...rest] {
            throw InvalidFileUtf8(message: f"File is not valid UTF-8: {path}", payload: { path = path }, cause: cause);
        }
    }
    finally {
        await finishWhole(file, path);
    }
}

async fn writeWhole(file: WholeFile, path: String, data: ByteArray) throws(FileOperationFailed) {
    let length = bytesApi.length(data);
    var offset = 0;
    while offset < length {
        var count = length - offset;
        if count > 65536 {
            count = 65536;
        }
        let end = offset + count;
        switch bytesApi.slice(data, offset, end) {
            case Option.Some(chunk): {
                rawWholeWrite(file, chunk, bytesApi.byteLength(chunk));
                await waitWhole(file, path, FilePhase.Write());
                checkWholeStatus(file, path);
            }
            case Option.None: {
                core.panic("invalid whole-file write slice");
            }
        }
        offset = end;
    }
}

/// Atomically install the new bytes. The receipt includes any post-install cleanup errors.
async fn replaceBytes(path: String, data: ByteArray) throws(FileOperationFailed, InstallUncertain) -> ReplaceReceipt {
    let file = newWhole(path, 0, true);
    var delivered = false;
    try {
        rawWholeOpen(file);
        await waitWhole(file, path, FilePhase.OpenDirectory());
        checkWholeStatus(file, path);
        await writeWhole(file, path, data);
        rawWholeInstall(file);
        await waitWhole(file, path, FilePhase.Install());
        if rawWholeInstallResult(file) == 2 {
            let cause = problem(rawWholeStatus(file), "io.Install");
            throw InstallUncertain(
                message: f"File installation could not be confirmed: {path}",
                cause: cause,
                payload: {
                    path = path,
                    phase = FilePhase.Install(),
                    status = err.nativeStatus(cause),
                    temporaryName = Option<String>.None()
                }
            );
        }
        checkWholeStatus(file, path);
        if rawWholeCleanup(file) {
            await waitWhole(file, path, FilePhase.CloseFile());
        }
        var issues: List<FileOperationFailed> = [];
        var index = 0;
        while index < 4 {
            switch cleanupIssue(file, path, index) {
                case Option.Some(issue): {
                    try {
                        issues = listApi.append(issues, issue);
                    }
                    catch [overflow: listApi.LengthOverflow] {
                        core.panic("whole-file cleanup has at most four errors");
                    }
                }
                case Option.None: {}
            }
            index = index + 1;
        }
        let receipt: ReplaceReceipt = {
            bytesWritten = bytesApi.length(data),
            cleanupErrors = issues
        };
        delivered = true;
        return receipt;
    }
    finally {
        if delivered {
            rawWholeRelease(file);
        }
        else {
            await finishWhole(file, path);
        }
    }
}

/// Encode UTF-8 and atomically install the resulting bytes.
async fn replaceText(path: String, text: String) throws(FileOperationFailed, InstallUncertain) -> ReplaceReceipt {
    return await replaceBytes(path, textApi.encodeUtf8(text));
}

