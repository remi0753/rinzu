import rinzu.io;

class FileStream {
    const file: rinzu.io.File,
    const maximum: Int,
    busy: Bool,
    state: Int,
    failure: Option<Error>
}

fn problem(code: Int) -> Error {
    return error(code, "stream.file");
}

async fn openFile(path: String) -> FileStream {
    return await openFileWithLimit(path, 65536);
}

async fn openFileWithLimit(path: String, maximum: Int) -> FileStream {
    if maximum < 1 || maximum > 65536 {
        throw problem(-7204);
    }
    let resultValue2 = await rinzu.io.openRead(path);
    return (FileStream(file: resultValue2, maximum: maximum, busy: false, state: 0, failure: Option<Error>.None()));
    throw problem(-7204);
}

async fn next(stream: FileStream) -> Option<ByteArray> {
    if stream.busy {
        throw problem(-7203);
    }
    if stream.state == 3 {
        throw problem(-7202);
    }
    if stream.state == 1 {
        return (Option<ByteArray>.None());
    }
    switch stream.failure {
        case Option.Some(failure): {
            throw failure;
        }
        case Option.None: {}
    }
    stream.busy = true;
    try {
        try {
            let resultValue1 = await rinzu.io.read(stream.file, stream.maximum);
            if resultValue1.eof {
                stream.state = 1;
                return (Option<ByteArray>.None());
            }
            return (Option<ByteArray>.Some(value: resultValue1.data));
        }
        catch [resultError1: Error, ...resultRest1] {
            stream.state = 2;
            stream.failure = Option<Error>.Some(value: resultError1);
            throw resultError1;
        }
    }
    finally {
        stream.busy = false;
    }
    throw problem(-7204);
}

async fn close(stream: FileStream) -> Int {
    if stream.busy {
        throw problem(-7203);
    }
    if stream.state == 3 {
        throw problem(-7202);
    }
    stream.busy = true;
    // Close consumes the fd even when the native close reports an Error.
    stream.state = 3;
    try {
        return await rinzu.io.close(stream.file);
    }
    finally {
        stream.busy = false;
    }
    throw problem(-7204);
}

export FileStream;
export openFile;
export openFileWithLimit;
export next;
export close;
