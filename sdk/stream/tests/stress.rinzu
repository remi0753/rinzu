import rinzu.timer;
import rinzu.stream;
import rinzu.io;
import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.error as err;
import rinzu.future as future;

async fn ready() -> ByteArray {
    return bytesApi.from(b"ready");
}

async fn main() {
    try {
        var index = 0;
        while index < 2000 {
            if bytesApi.length(await ready()) != 5 {
                rinzu.core.panic("badReady");
            }
            index = index + 1;
        }
        try {
            let resultValue12 = await rinzu.stream.openFileWithLimit("missing.bin", 1024);
            rinzu.core.panic("badMissing");
        }
        catch [resultError12: Error, ...resultRest12] {}
        try {
            let resultValue11 = await rinzu.stream.openFileWithLimit("input.bin", 0);
            rinzu.core.panic("badLimit");
        }
        catch [resultError11: Error, ...resultRest11] {
            if err.code(resultError11) != Option<Int>.Some(value: -7204) {
                rinzu.core.panic("badLimitCode");
            }
        }
        // A stopped consumer starts no producer/read allocation.
        try {
            let resultValue10 = await rinzu.stream.openFile("input.bin");
            if rinzu.io.liveBuffers() != 0 {
                rinzu.core.panic("badPrefetch1");
            }
            await rinzu.timer.sleep(2);
            if rinzu.io.liveBuffers() != 0 {
                rinzu.core.panic("badPrefetch2");
            }
            try {
                let resultValue9 = await rinzu.stream.close(resultValue10);
            }
            catch [resultError9: Error, ...resultRest9] {
                rinzu.core.panic("badIdleClose");
            }
        }
        catch [resultError10: Error, ...resultRest10] {
            rinzu.core.panic("badIdleOpen");
        }
        // Fault fixture only: invalidate the native owner through its alias and
    // check that stream caches the original I/O Error rather than resume.
        try {
            let resultValue8 = await rinzu.stream.openFile("input.bin");
            try {
                let resultValue7 = await rinzu.io.close(resultValue8.file);
            }
            catch [resultError7: Error, ...resultRest7] {
                rinzu.core.panic("badFaultClose");
            }
            var attempt = 0;
            while attempt < 2 {
                try {
                    let resultValue6 = await rinzu.stream.next(resultValue8);
                    rinzu.core.panic("badFaultResult");
                }
                catch [resultError6: Error, ...resultRest6] {
                    switch err.nativeStatus(resultError6) {
                        case Option.None: {
                            rinzu.core.panic("badFaultMissingStatus");
                        }
                        case Option.Some(status): {
                            if status != -7102 {
                                rinzu.core.panic("badFaultCode");
                            }
                        }
                    }
                }
                attempt = attempt + 1;
            }
            try {
                let resultValue5 = await rinzu.stream.close(resultValue8);
                rinzu.core.panic("badFaultCloseResult");
            }
            catch [resultError5: Error, ...resultRest5] {
                switch err.nativeStatus(resultError5) {
                    case Option.None: {
                        rinzu.core.panic("badFaultCloseMissing");
                    }
                    case Option.Some(status): {
                        if status != -7102 {
                            rinzu.core.panic("badFaultCloseCode");
                        }
                    }
                }
            }
        }
        catch [resultError8: Error, ...resultRest8] {
            rinzu.core.panic("badFaultOpen");
        }
        try {
            let resultValue4 = await rinzu.stream.openFileWithLimit("input.bin", 1024);
            try all {
                try all {
                    let first = rinzu.stream.next(resultValue4);
                    let settled = cancelledRead(first);
                    try {
                        let resultValue3 = await rinzu.stream.next(resultValue4);
                        rinzu.core.panic("badOverlap");
                    }
                    catch [resultError3: Error, ...resultRest3] {
                        if err.code(resultError3) != Option<Int>.Some(value: -7203) {
                            rinzu.core.panic("badOverlapCode");
                        }
                    }
                    try {
                        let resultValue2 = await rinzu.stream.close(resultValue4);
                        rinzu.core.panic("badBusyClose");
                    }
                    catch [resultError2: Error, ...resultRest2] {
                        if err.code(resultError2) != Option<Int>.Some(value: -7203) {
                            rinzu.core.panic("badBusyCode");
                        }
                    }
                    let requested = future.cancel(first);
                    if !requested {
                        rinzu.core.panic("badCancel");
                    }
                    while !future.isReady(settled) {
                        await rinzu.timer.sleep(1);
                    }
                }
                finally {}
                if resultValue4.busy {
                    rinzu.core.panic("badDrain");
                }
            }
            finally {
                try {
                    let resultValue1 = await rinzu.stream.close(resultValue4);
                }
                catch [resultError1: Error, ...resultRest1] {
                    rinzu.core.panic("badClose");
                }
            }
        }
        catch [resultError4: Error, ...resultRest4] {
            rinzu.core.panic("badOpen");
        }
        if rinzu.io.liveFiles() != 0 || rinzu.io.liveBuffers() != 0 {
            rinzu.core.panic("badResource");
        }
        rinzu.stdio.writeLine("stream-stress-ok");
    }
    catch unexpectedEntryErrors {
        rinzu.core.panic("unexpectedEntryFailure");
    }
}

// A cancelled operation may have no value; normal I/O errors still fail the test.
async fn cancelledRead(value: Future<Option<ByteArray>>) {
    try {
        let chunk = await value;
    }
    catch errors {
        rinzu.core.panic("unexpectedReadFailure");
    }
}
