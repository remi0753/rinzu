import rinzu.stream;
import rinzu.io;
import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.error as err;

async fn value() -> ByteArray {
    return bytesApi.from(b"abc");
}

fn wrapped() -> Future<ByteArray> {
    return value();
}

async fn main() {
    try {
        let kept = value();
        if bytesApi.length(await kept) != 3 || bytesApi.length(await kept) != 3 {
            rinzu.core.panic("bad1");
        }
        let nested = wrapped();
        if bytesApi.length(await nested) != 3 || bytesApi.length(await nested) != 3 {
            rinzu.core.panic("badNested");
        }
        try {
            let resultValue6 = await rinzu.stream.openFileWithLimit("input.bin", 1024);
            var total = 0;
            var eof = false;
            try all {
                while !eof {
                    try {
                        let resultValue5 = await rinzu.stream.next(resultValue6);
                        switch resultValue5 {
                            case Option.Some(data): {
                                total = total + bytesApi.length(data);
                            }
                            case Option.None: {
                                eof = true;
                            }
                        }
                    }
                    catch [resultError5: Error, ...resultRest5] {
                        rinzu.core.panic("bad3");
                    }
                }
                if total != 8192 {
                    rinzu.core.panic("bad4");
                }
                try {
                    let resultValue4 = await rinzu.stream.next(resultValue6);
                    switch resultValue4 {
                        case Option.Some(data): {
                            rinzu.core.panic("bad6");
                        }
                        case Option.None: {}
                    }
                }
                catch [resultError4: Error, ...resultRest4] {
                    rinzu.core.panic("bad5");
                }
            }
            finally {
                try {
                    let resultValue3 = await rinzu.stream.close(resultValue6);
                }
                catch [resultError3: Error, ...resultRest3] {
                    rinzu.core.panic("bad7");
                }
            }
            try {
                let resultValue2 = await rinzu.stream.close(resultValue6);
                rinzu.core.panic("bad8");
            }
            catch [resultError2: Error, ...resultRest2] {
                if err.code(resultError2) != Option<Int>.Some(value: -7202) {
                    rinzu.core.panic("bad9");
                }
            }
            try {
                let resultValue1 = await rinzu.stream.next(resultValue6);
                rinzu.core.panic("bad10");
            }
            catch [resultError1: Error, ...resultRest1] {
                if err.code(resultError1) != Option<Int>.Some(value: -7202) {
                    rinzu.core.panic("bad11");
                }
            }
        }
        catch [resultError6: Error, ...resultRest6] {
            rinzu.core.panic("bad2");
        }
        if rinzu.io.liveFiles() != 0 || rinzu.io.liveBuffers() != 0 {
            rinzu.core.panic("bad12");
        }
        rinzu.stdio.writeLine("stream-basic-ok");
    }
    catch unexpectedEntryErrors {
        rinzu.core.panic("unexpectedEntryFailure");
    }
}
