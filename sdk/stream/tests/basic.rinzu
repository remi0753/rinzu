import rinzu.stream;
import rinzu.io;
import rinzu.stdio;

async fn value() -> ByteArray {
    return byteArray(b"abc");
}

fn wrapped() -> Future<ByteArray> {
    return value();
}

async fn main() {
    try {
        let kept = value();
        if bytesLength(await kept) != 3 || bytesLength(await kept) != 3 {
            panic("bad1");
        }
        let nested = wrapped();
        if bytesLength(await nested) != 3 || bytesLength(await nested) != 3 {
            panic("badNested");
        }
        try {
            let resultValue6 = await rinzu.stream.openFileWithLimit("input.bin", 1024);
            var total = 0;
            var eof = false;
            try all {
                while !eof {
                    try {
                        let resultValue5 = await rinzu.stream.next(resultValue6);
                        switch resultValue5 {
                            case Option.Some(data): {
                                total = total + bytesLength(data);
                            }
                            case Option.None: {
                                eof = true;
                            }
                        }
                    }
                    catch [resultError5: Error, ...resultRest5] {
                        panic("bad3");
                    }
                }
                if total != 8192 {
                    panic("bad4");
                }
                try {
                    let resultValue4 = await rinzu.stream.next(resultValue6);
                    switch resultValue4 {
                        case Option.Some(data): {
                            panic("bad6");
                        }
                        case Option.None: {}
                    }
                }
                catch [resultError4: Error, ...resultRest4] {
                    panic("bad5");
                }
            }
            finally {
                try {
                    let resultValue3 = await rinzu.stream.close(resultValue6);
                }
                catch [resultError3: Error, ...resultRest3] {
                    panic("bad7");
                }
            }
            try {
                let resultValue2 = await rinzu.stream.close(resultValue6);
                panic("bad8");
            }
            catch [resultError2: Error, ...resultRest2] {
                if errorCode(resultError2) != -7202 {
                    panic("bad9");
                }
            }
            try {
                let resultValue1 = await rinzu.stream.next(resultValue6);
                panic("bad10");
            }
            catch [resultError1: Error, ...resultRest1] {
                if errorCode(resultError1) != -7202 {
                    panic("bad11");
                }
            }
        }
        catch [resultError6: Error, ...resultRest6] {
            panic("bad2");
        }
        if rinzu.io.liveFiles() != 0 || rinzu.io.liveBuffers() != 0 {
            panic("bad12");
        }
        rinzu.stdio.writeLine("stream-basic-ok");
    }
    catch unexpectedEntryErrors {
        panic("unexpectedEntryFailure");
    }
}
