fn identity2D() -> Transform2D {
    return Transform2D(a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: 0.0, ty: 0.0);
}

fn translation2D(x: Float, y: Float) -> Transform2D {
    return Transform2D(a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: x, ty: y);
}

fn scale2D(x: Float, y: Float) -> Transform2D {
    return Transform2D(a: x, b: 0.0, c: 0.0, d: y, tx: 0.0, ty: 0.0);
}

/// Positive rotation is clockwise in the batch's top-left coordinate system.
fn rotation2D(radians: Float) -> Transform2D {
    let output = identity2D();
    let status = checked(Int(rawRotation2D(radians, output)), "macos.rotation2D");
    return output;
}

/// Apply first, then next: next * first.
fn compose2D(first: Transform2D, next: Transform2D) -> Transform2D {
    return Transform2D(
        a: next.a * first.a + next.c * first.b,
        b: next.b * first.a + next.d * first.b,
        c: next.a * first.c + next.c * first.d,
        d: next.b * first.c + next.d * first.d,
        tx: next.a * first.tx + next.c * first.ty + next.tx,
        ty: next.b * first.tx + next.d * first.ty + next.ty
    );
}

/// A contiguous draw span. Constructed by Batch2D; do not mutate batch storage.
class BatchDraw2D {
    const texture: Texture,
    const textureId: Int,
    const sampler: Sampler,
    const filter: Int,
    const clip: Scissor,
    const first: Int,
    count: Int
}

/// Bounded, reusable quad batch. Coordinates and clip use target pixels, top-left.
/// Reset only after the command using its vertex buffer has physically settled.
class Batch2D {
    const vertices: Buffer,
    const rgba: RenderPipeline,
    const bgra: RenderPipeline,
    const nearest: Sampler,
    const linear: Sampler,
    const white: Texture,
    const command: Command,
    const capacity: Int,
    width: Int,
    height: Int,
    count: Int,
    draws: List<BatchDraw2D>,
    transform: Transform2D,
    clip: Scissor,
    filter: Int,
    closed: Bool,
    rendering: Bool

    fn reset(self: Batch2D, width: Int, height: Int) {
        try {}
        finally {
            let ready = checked(Int(rawBufferWritable(self.vertices.handle)), "macos.batch2D.reset");
            if self.rendering {
                throw error(-7803, "macos.batch2D.rendering");
            }
            if self.closed || width <= 0 || height <= 0 || width > 32768 || height > 32768 {
                throw error(-7804, "macos.batch2D.size");
            }
            self.width = width;
            self.height = height;
            self.count = 0;
            self.draws = [];
            self.transform = identity2D();
            self.clip = Scissor(x: 0, y: 0, width: width, height: height);
            self.filter = filterLinear;
        }
    }

    fn setTransform(self: Batch2D, transform: Transform2D) {
        let ready = checked(Int(rawBufferWritable(self.vertices.handle)), "macos.batch2D.transform");
        if self.rendering {
            throw error(-7803, "macos.batch2D.rendering");
        }
        self.transform = transform;
    }

    fn setClip(self: Batch2D, clip: Scissor) {
        let ready = checked(Int(rawBufferWritable(self.vertices.handle)), "macos.batch2D.clip");
        if self.rendering {
            throw error(-7803, "macos.batch2D.rendering");
        }
        if clip.x < 0
            || clip.y < 0
            || clip.width <= 0
            || clip.height <= 0
            || clip.x > self.width
            || clip.y > self.height
            || clip.width > self.width - clip.x
            || clip.height > self.height - clip.y {
            throw error(-7804, "macos.batch2D.clip");
        }
        self.clip = clip;
    }

    fn setFilter(self: Batch2D, filter: Int) {
        let ready = checked(Int(rawBufferWritable(self.vertices.handle)), "macos.batch2D.filter");
        if self.rendering {
            throw error(-7803, "macos.batch2D.rendering");
        }
        if filter != filterNearest && filter != filterLinear {
            throw error(-7804, "macos.batch2D.filter");
        }
        self.filter = filter;
    }

    fn fillRect(self: Batch2D, destination: Rect, color: Color) {
        self.image(self.white, destination, color);
    }

    /// Coordinates use the current batch transform. TextMetrics uses font points.
    fn text(self: Batch2D, text: Text2D, x: Float, y: Float, tint: Color) {
        self.image(
            text.texture,
            Rect(
                x: x + text.metrics.left,
                y: y + text.metrics.top,
                width: Float(text.width) / text.scale,
                height: Float(text.height) / text.scale
            ),
            tint
        );
    }

    fn image(self: Batch2D, texture: Texture, destination: Rect, tint: Color) {
        self.imageRegion(texture, destination, Rect(x: 0.0, y: 0.0, width: 1.0, height: 1.0), tint);
    }

    /// Normalized UVs, with row zero at the top. Texture pixels must be premultiplied.
    fn imageRegion(self: Batch2D, texture: Texture, destination: Rect, uv: Rect, tint: Color) {
        try {}
        finally {
            let ready = checked(Int(rawBufferWritable(self.vertices.handle)), "macos.batch2D.image");
            if self.rendering {
                throw error(-7803, "macos.batch2D.rendering");
            }
            if self.closed || self.width <= 0 || self.count >= self.capacity {
                throw error(-7804, "macos.batch2D.capacityOrState");
            }
            let id = texture.identity();
            let projection = Transform2D(
                a: 2.0 / Float(self.width),
                b: 0.0,
                c: 0.0,
                d: -2.0 / Float(self.height),
                tx: -1.0,
                ty: 1.0
            );
            let written = self.vertices.writeQuad2D(
                self.count,
                Quad2D(destination: destination, uv: uv, tint: tint, transform: compose2D(self.transform, projection))
            );
            var grouped = false;
            switch rinzu.List.get(self.draws, rinzu.List.length(self.draws) - 1) {
                case Option.None: {}
                case Option.Some(last): {
                    if last.textureId == id
                        && last.filter == self.filter
                        && last.clip.x == self.clip.x
                        && last.clip.y == self.clip.y
                        && last.clip.width == self.clip.width
                        && last.clip.height == self.clip.height {
                        last.count = last.count + 6;
                        grouped = true;
                    }
                }
            }
            if !grouped {
                var sampler = self.linear;
                if self.filter == filterNearest {
                    sampler = self.nearest;
                }
                self.draws = rinzu.List.append(
                    self.draws,
                    BatchDraw2D(
                        texture: texture,
                        textureId: id,
                        sampler: sampler,
                        filter: self.filter,
                        clip: self.clip,
                        first: self.count * 6,
                        count: 6
                    )
                );
            }
            self.count = self.count + 1;
        }
    }

    fn drawCallCount(self: Batch2D) -> Int {
        return rinzu.List.length(self.draws);
    }

    /// Encode into an already begun pass. On Error the caller must abandon it.
    fn encode(self: Batch2D, command: Command, format: Int) -> Int {
        if self.rendering {
            throw error(-7803, "macos.batch2D.rendering");
        }
        return self.encodeNow(command, format);
    }

    private fn encodeNow(self: Batch2D, command: Command, format: Int) -> Int {
        if self.closed || self.width <= 0 || (format != pixelRGBA8 && format != pixelBGRA8) {
            throw error(-7804, "macos.batch2D.encode");
        }
        // Binding first makes subsequent writes/reset fail until finish/abandon.
        let bound = command.setVertexBuffer(0, self.vertices, 0);
        var pipeline = self.bgra;
        if format == pixelRGBA8 {
            pipeline = self.rgba;
        }
        let installed = command.setRenderPipeline(pipeline);
        var index = 0;
        while index < rinzu.List.length(self.draws) {
            switch rinzu.List.get(self.draws, index) {
                case Option.None: {
                    throw error(-7804, "macos.batch2D.span");
                }
                case Option.Some(draw): {
                    let clipped = command.setScissor(draw.clip);
                    let sampled = command.setFragmentTexture(0, draw.texture);
                    let filtered = command.setFragmentSampler(0, draw.sampler);
                    let issued = command.drawTriangles(draw.first, draw.count);
                }
            }
            index = index + 1;
        }
        return index;
    }

    /// Own a complete frame, including abandon / physical drain on Error or cancel.
    async fn render(self: Batch2D, surface: View, clear: Color) -> Int {
        var admitted = false;
        try {
            try {}
            finally {
                if self.rendering || rawCommandState(self.command.handle) != 0 {
                    throw error(-7803, "macos.batch2D.rendering");
                }
                self.rendering = true;
                admitted = true;
            }
            let begun = self.command.beginRender(surface, clear);
            let encoded = self.encodeNow(self.command, pixelBGRA8);
            let submitted = self.command.commit();
            return await self.command.wait();
        }
        finally {
            if admitted {
                try {
                    if rawCommandState(self.command.handle) == 1 {
                        let abandoned = self.command.abandon();
                    }
                    else if rawCommandState(self.command.handle) == 2 {
                        let drained = await self.command.wait();
                    }
                }
                finally {
                    self.rendering = false;
                }
            }
        }
    }

    async fn renderTexture(self: Batch2D, texture: Texture, clear: Color) -> Int {
        var admitted = false;
        try {
            try {}
            finally {
                if self.rendering || rawCommandState(self.command.handle) != 0 {
                    throw error(-7803, "macos.batch2D.rendering");
                }
                self.rendering = true;
                admitted = true;
            }
            let info = texture.info();
            let begun = self.command.beginRenderTexture(texture, clear);
            let encoded = self.encodeNow(self.command, info.format);
            let submitted = self.command.commit();
            return await self.command.wait();
        }
        finally {
            if admitted {
                try {
                    if rawCommandState(self.command.handle) == 1 {
                        let abandoned = self.command.abandon();
                    }
                    else if rawCommandState(self.command.handle) == 2 {
                        let drained = await self.command.wait();
                    }
                }
                finally {
                    self.rendering = false;
                }
            }
        }
    }

    fn destroy(self: Batch2D) {
        if self.rendering || rawCommandState(self.command.handle) != 0 {
            throw error(-7803, "macos.batch2D.commandBusy");
        }
        let ready = checked(Int(rawBufferWritable(self.vertices.handle)), "macos.batch2D.destroy");
        let command = self.command.destroy();
        let vertices = self.vertices.destroy();
        let rgba = self.rgba.destroy();
        let bgra = self.bgra.destroy();
        let nearest = self.nearest.destroy();
        let linear = self.linear.destroy();
        let white = self.white.destroy();
        self.draws = [];
        self.closed = true;
    }
}

