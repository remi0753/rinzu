fn uiDisposeCanvas(canvas: Canvas2D) {
    if canvas.disposed {
        return;
    }
    canvas.stop();
    try {
        canvas.batch.destroy();
    }
    finally {
        let closed = canvas.clock.destroy();
        canvas.disposed = true;
    }
}

fn uiCloseCanvases(scope: UiScope) {
    var index = 0;
    while index < rinzu.List.length(scope.canvases) {
        switch rinzu.List.get(scope.canvases, index) {
            case Option.None: {}
            case Option.Some(canvas): {
                uiDisposeCanvas(canvas);
            }
        }
        index = index + 1;
    }
    scope.canvases = [];
}

native {
    record DataState {
        rows: Int,
        visibleRows: Int,
        cellViews: Int,
        bytes: Int,
        revision: Int,
        selectedId: Int,
        selectedRow: Int,
        firstVisible: Int,
        lastVisible: Int,
        pendingRows: Int
    }

    fn rawDataCreate(window: WindowHandle, kind: Int, columns: Int, frame: Rect, action: Int)
        -> Int symbol "rinzu_macos_data_create";

    fn rawDataColumn(view: ViewHandle, column: Int, title: ByteArray, length: CSize, width: Float, sortable: CBool)
        -> CInt symbol "rinzu_macos_data_column";

    fn rawDataBegin(view: ViewHandle, token: Int) -> CInt symbol "rinzu_macos_data_begin";

    fn rawDataOwned(view: ViewHandle, token: Int) -> CBool symbol "rinzu_macos_data_owned";

    fn rawDataAppend(view: ViewHandle, token: Int, id: Int, parent: Int, cells: ByteArray, length: CSize)
        -> CInt symbol "rinzu_macos_data_append";

    fn rawDataCommit(view: ViewHandle, token: Int) -> CInt symbol "rinzu_macos_data_commit";

    fn rawDataCancel(view: ViewHandle, token: Int) -> CInt symbol "rinzu_macos_data_cancel";

    fn rawDataState(view: ViewHandle, output: DataState) -> CInt symbol "rinzu_macos_data_state";

    fn rawDataSelect(view: ViewHandle, id: Int, reveal: CBool) -> CInt symbol "rinzu_macos_data_select";

    fn rawDataScroll(view: ViewHandle, id: Int) -> CInt symbol "rinzu_macos_data_scroll";

    fn rawDataExpand(view: ViewHandle, id: Int, expanded: CBool) -> CInt symbol "rinzu_macos_data_expand";

    fn rawDataExpanded(view: ViewHandle, id: Int) -> CInt symbol "rinzu_macos_data_expanded";

    fn rawDataSort(view: ViewHandle, column: Int, ascending: CBool) -> CInt symbol "rinzu_macos_data_sort";

    fn rawDataCell(view: ViewHandle, token: Int, id: Int, column: Int) -> CInt symbol "rinzu_macos_data_cell";

    fn rawAccessibility(
        view: ViewHandle,
        label: ByteArray,
        labelLength: CSize,
        help: ByteArray,
        helpLength: CSize,
        identifier: ByteArray,
        identifierLength: CSize
    ) -> CInt symbol "rinzu_macos_view_accessibility";

    fn rawTooltip(view: ViewHandle, text: ByteArray, length: CSize) -> CInt symbol "rinzu_macos_view_tooltip";

    fn rawWindowTheme(window: WindowHandle, theme: Int) -> CInt symbol "rinzu_macos_window_theme";

    fn rawEffectiveTheme(window: WindowHandle) -> CInt symbol "rinzu_macos_window_effective_theme";
}

class DataColumn {
    const title: String,
    const width: Float,
    const sortable: Bool
}

/// IDs are positive and unique. A tree parent must precede its children; zero is a root.
class DataRow {
    const id: Int,
    const parent: Int,
    const cells: List<String>
}

/// Shared List/Table/Tree interface. Model and AppKit datasource contain native copies only.
class DataView {
    const view: View,
    const columns: Int,
    const control: UiControl

    fn identity(self: DataView) -> Int {
        return self.view.identity();
    }

    fn destroy(self: DataView) -> Int {
        return self.view.destroy();
    }

    fn state(self: DataView) -> DataState {
        let result = DataState(
            rows: 0,
            visibleRows: 0,
            cellViews: 0,
            bytes: 0,
            revision: 0,
            selectedId: 0,
            selectedRow: -1,
            firstVisible: -1,
            lastVisible: -1,
            pendingRows: 0
        );
        let read = checked(Int(rawDataState(self.view.handle, result)), "macos.data.state");
        return result;
    }

    fn accepts(self: DataView, event: UiEvent) -> Bool {
        if event.kind != eventData || event.viewId != self.identity() {
            return false;
        }
        let state = self.state();
        return event.value == Float(state.revision);
    }

    fn select(self: DataView, id: Int, reveal: Bool) -> Int {
        return checked(Int(rawDataSelect(self.view.handle, id, reveal)), "macos.data.select");
    }

    fn scrollTo(self: DataView, id: Int) -> Int {
        return checked(Int(rawDataScroll(self.view.handle, id)), "macos.data.scrollTo");
    }

    fn setExpanded(self: DataView, id: Int, expanded: Bool) -> Int {
        return checked(Int(rawDataExpand(self.view.handle, id, expanded)), "macos.data.expand");
    }

    fn isExpanded(self: DataView, id: Int) -> Bool {
        return checked(Int(rawDataExpanded(self.view.handle, id)), "macos.data.expanded") != 0;
    }

    fn sort(self: DataView, column: Int, ascending: Bool) -> Int {
        return checked(Int(rawDataSort(self.view.handle, column, ascending)), "macos.data.sort");
    }

    fn cell(self: DataView, id: Int, column: Int) -> String {
        let token = checked(rawWaitToken(), "macos.data.cellToken");
        try {
            let ready = checked(Int(rawDataCell(self.view.handle, token, id, column)), "macos.data.cell");
            return utf8Decode(rawWidgetBytes(self.view.handle, token));
        }
        finally {
            if rawWidgetSnapshotOwned(self.view.handle, token) {
                let finished = checked(Int(rawWidgetSnapshotFinish(self.view.handle, token)), "macos.data.cell.finish");
            }
        }
    }

    /// Build offscreen, yield every 256 rows, and publish one complete model.
    async fn generateRows(self: DataView, count: Int, make: fn (Int) -> DataRow) {
        if self.control.closed || self.control.stopping || count < 0 || count > 100000 {
            throw error(-7804, "macos.data.countOrStopping");
        }
        let token = checked(rawWaitToken(), "macos.data.updateToken");
        try {
            let admitted = checked(Int(rawDataBegin(self.view.handle, token)), "macos.data.begin");
            var index = 0;
            while index < count && !self.control.stopping {
                let row = make(index);
                let bytes = dataCells(row.cells, self.columns);
                let added = checked(
                    Int(rawDataAppend(self.view.handle, token, row.id, row.parent, bytes, byteLength(bytes))),
                    "macos.data.row"
                );
                index = index + 1;
                if index % 256 == 0 {
                    await rinzu.timer.sleep(1);
                }
            }
            if !self.control.stopping {
                let committed = checked(Int(rawDataCommit(self.view.handle, token)), "macos.data.commit");
            }
        }
        finally {
            if rawDataOwned(self.view.handle, token) {
                let cancelled = checked(Int(rawDataCancel(self.view.handle, token)), "macos.data.cancel");
            }
        }
    }

    async fn setRows(self: DataView, rows: List<DataRow>) {
        await self.generateRows(
            rinzu.List.length(rows),
            fn (index: Int) -> DataRow {
                switch rinzu.List.get(rows, index) {
                    case Option.Some(row): {
                        return row;
                    }
                    case Option.None: {
                        throw error(-7804, "macos.data.rowIndex");
                    }
                }
            }
        );
    }
}

fn dataCells(cells: List<String>, columns: Int) -> ByteArray {
    if rinzu.List.length(cells) != columns {
        throw error(-7804, "macos.data.columnCount");
    }
    var result = "";
    var index = 0;
    while index < columns {
        switch rinzu.List.get(cells, index) {
            case Option.Some(cell): {
                let bytes = utf8Encode(cell);
                if byteLength(bytes) > 65536 {
                    throw error(-7804, "macos.data.cellLimit");
                }
                result = f"{result}{byteLength(bytes)}:{cell}";
            }
            case Option.None: {}
        }
        index = index + 1;
    }
    let bytes = utf8Encode(result);
    if byteLength(bytes) > 1048576 {
        throw error(-7804, "macos.data.rowLimit");
    }
    return bytes;
}

fn createDataView(scope: UiScope, kind: Int, columns: List<DataColumn>, frame: Rect, action: Int) -> DataView {
    if scope.control.closed
        || scope.control.stopping
        || rinzu.List.length(columns) < 1
        || rinzu.List.length(columns) > 32 {
        throw error(-7804, "macos.data.columnsOrStopping");
    }
    var index = 0;
    while index < rinzu.List.length(columns) {
        switch rinzu.List.get(columns, index) {
            case Option.Some(column): {
                if !(column.width >= 16.0 && column.width <= 4096.0) || byteLength(utf8Encode(column.title)) > 4096 {
                    throw error(-7804, "macos.data.column");
                }
            }
            case Option.None: {}
        }
        index = index + 1;
    }
    let view = View(
        handle: rawView(
            checked(
                rawDataCreate(scope.window.handle, kind, rinzu.List.length(columns), frame, action),
                "macos.data.create"
            )
        )
    );
    var retained = false;
    try {
        index = 0;
        while index < rinzu.List.length(columns) {
            switch rinzu.List.get(columns, index) {
                case Option.Some(column): {
                    let bytes = utf8Encode(column.title);
                    let configured = checked(
                        Int(rawDataColumn(view.handle, index, bytes, byteLength(bytes), column.width, column.sortable)),
                        "macos.data.column"
                    );
                }
                case Option.None: {}
            }
            index = index + 1;
        }
        let data = DataView(view: view, columns: rinzu.List.length(columns), control: scope.control);
        retained = true;
        return data;
    }
    finally {
        if !retained {
            let removed = view.destroy();
        }
    }
}

let eventData = 20;

let dataSelected = 1;

let dataActivated = 2;

let dataExpanded = 3;

let dataCollapsed = 4;

let dataSorted = 5;

let themeSystem = 0;

let themeLight = 1;

let themeDark = 2;

