fn scopedWidget(scope: UiScope, kind: Int, title: String, frame: Rect, action: Int) -> View {
    if scope.control.closed || scope.control.stopping {
        throw error(-7803, "UI scope is stopping");
    }
    let text = utf8Encode(title);
    return View(
        handle: rawView(
            checked(
                rawWidgetScoped(scope.window.handle, CInt(kind), text, byteLength(text), frame, action),
                "macos.widget.scoped"
            )
        )
    );
}

fn widgetSetText(view: View, value: String) -> Int {
    let text = utf8Encode(value);
    return checked(Int(rawWidgetSetText(view.handle, text, byteLength(text))), "macos.widget.setText");
}

fn widgetText(view: View) -> String {
    let token = checked(rawWaitToken(), "macos.widget.snapshotToken");
    try {
        let prepared = checked(Int(rawWidgetSnapshot(view.handle, token)), "macos.widget.text");
        return utf8Decode(rawWidgetBytes(view.handle, token));
    }
    finally {
        if rawWidgetSnapshotOwned(view.handle, token) {
            let finished = checked(Int(rawWidgetSnapshotFinish(view.handle, token)), "macos.widget.text.finish");
        }
    }
}

fn widgetState(view: View) -> WidgetState {
    let output = WidgetState(value: 0.0, enabled: false, hidden: false);
    let status = checked(Int(rawWidgetState(view.handle, output)), "macos.widget.state");
    return output;
}

fn textSelection(view: View) -> Selection {
    let output = Selection(start: 0, end: 0);
    let status = checked(Int(rawSelection(view.handle, output)), "macos.text.selection");
    return output;
}

