let eventStarted = 1;

let eventCloseRequested = 2;

let eventResized = 3;

let eventDraw = 4;

let eventQuitRequested = 5;

let eventKeyDown = 6;

let eventKeyUp = 7;

let eventMouseDown = 8;

let eventMouseUp = 9;

let eventMouseMoved = 10;

let eventStopped = 11;

let eventAction = 12;

let eventTextChanged = 13;

let eventSelectionChanged = 14;

let eventScroll = 15;

let eventFocus = 16;

let eventWindowState = 17;

let eventTaskFinished = 18;

/// An owned event. Text remains valid after the native queue is acknowledged.
class UiEvent {
    const kind: Int,
    const windowId: Int,
    const viewId: Int,
    const sequence: Int,
    const x: Float,
    const y: Float,
    const width: Float,
    const height: Float,
    const scale: Float,
    const keyCode: Int,
    const modifiers: Int,
    const action: Int,
    const selectionStart: Int,
    const selectionEnd: Int,
    const flags: Int,
    const value: Float,
    const deltaX: Float,
    const deltaY: Float,
    const text: String
}

/// Copy the latest Main-thread native diagnostic. Errors include this text.
fn diagnostic() -> String {
    return utf8Decode(rawDiagnostic());
}

fn checked(status: Int, operation: String) -> Int {
    if status < 0 {
        return nativeStatus(status, f"{operation}: {diagnostic()}");
    }
    return status;
}

/// Open one Main-owned application resource scope. Close explicitly.
fn open() -> Session {
    return Session(handle: rawSession(checked(rawOpen(), "macos.open")));
}

/// Measured live payloads and separately retained alias-check controls.
fn statistics() -> Statistics {
    let output = Statistics(
        sessions: 0,
        windows: 0,
        views: 0,
        devices: 0,
        buffers: 0,
        libraries: 0,
        pipelines: 0,
        commands: 0,
        bufferBytes: 0,
        retainedControls: 0,
        queuedEvents: 0,
        eventPayloadBytes: 0,
        snapshotBytes: 0,
        sheets: 0,
        sheetBytes: 0,
        textures: 0,
        samplers: 0,
        textureBytes: 0,
        fonts: 0,
        textLayouts: 0,
        textBytes: 0,
        frameClocks: 0,
        frameTimers: 0,
        frameWaiters: 0,
        dataRows: 0,
        dataBytes: 0,
        dataUpdates: 0
    );
    let status = checked(Int(rawStatistics(output)), "macos.statistics");
    return output;
}

/// Run NSApplication on Main. The handler is synchronous and valid only during run.
async fn run(session: Session, handler: fn (RunContext, Event) -> Unit) -> Int {
    let status = await rawRun(session.handle, { session = session }, handler);
    return checked(Int(status), "macos.run");
}

/// Run the OS loop without a managed native callback. Read with nextEvent.
async fn driveRunEvents(session: Session) -> Int {
    return checked(Int(await rawRunEvents(session.handle)), "macos.runEvents");
}

fn runEvents(session: Session) -> Future<Int> {
    let prepared = checked(Int(rawPrepareEvents(session.handle)), "macos.runEvents.prepare");
    return driveRunEvents(session);
}

/// Wait for one owned event. A single reader may be active per Session.
async fn nextEvent(session: Session) -> UiEvent {
    // A nested Source async wrapper may schedule the reader before the OS call.
    // Startup waits use the existing cancellable timer, never an unowned carrier.
    var startup = checked(Int(rawStreamState(session.handle)), "macos.event.startup");
    while startup == 0 {
        await rinzu.timer.sleep(1);
        startup = checked(Int(rawStreamState(session.handle)), "macos.event.startup");
    }
    while true {
        let token = checked(rawWaitToken(), "macos.event.token");
        try {
            let admitted = checked(Int(rawEventBegin(session.handle, token)), "macos.event.wait");
            await nativeCompleted(rawEventCompletion(session.handle, token));
            let output = Event(
                kind: 0,
                windowId: 0,
                viewId: 0,
                sequence: 0,
                x: 0.0,
                y: 0.0,
                width: 0.0,
                height: 0.0,
                scale: 0.0,
                keyCode: 0,
                modifiers: 0,
                action: 0,
                selectionStart: 0,
                selectionEnd: 0,
                flags: 0,
                value: 0.0,
                deltaX: 0.0,
                deltaY: 0.0
            );
            let taken = checked(Int(rawEventTake(session.handle, token, output)), "macos.event.take");
            if taken != 0 {
                let event = output;
                let text = utf8Decode(rawEventBytes(session.handle, token));
                return UiEvent(
                    kind: event.kind,
                    windowId: event.windowId,
                    viewId: event.viewId,
                    sequence: event.sequence,
                    x: event.x,
                    y: event.y,
                    width: event.width,
                    height: event.height,
                    scale: event.scale,
                    keyCode: event.keyCode,
                    modifiers: event.modifiers,
                    action: event.action,
                    selectionStart: event.selectionStart,
                    selectionEnd: event.selectionEnd,
                    flags: event.flags,
                    value: event.value,
                    deltaX: event.deltaX,
                    deltaY: event.deltaY,
                    text: text
                );
            }
        }
        finally {
            if rawEventOwned(session.handle, token) {
                let cancelled = checked(Int(rawEventCancel(session.handle, token)), "macos.event.cancel");
                await nativeCompleted(rawEventCompletion(session.handle, token));
                let finished = checked(Int(rawEventFinish(session.handle, token)), "macos.event.finish");
            }
        }
    }
    throw error(-7804, "unreachable event loop exit");
}

fn stop(session: Session) -> Int {
    return checked(Int(rawStop(session.handle)), "macos.stop");
}

async fn waitStatus(command: Command) -> Int {
    // Reserving an identity does not acquire a resource. Install finally before
    // native admission, including cancellation before Source receives its result.
    let token = checked(rawWaitToken(), "macos.command.waitToken");
    try {
        let acquired = checked(Int(rawWaitBegin(command.handle, token)), "macos.command.wait");
        await nativeCompleted(rawCompletion(command.handle, token));
        return Int(rawCommandStatus(command.handle));
    }
    finally {
        // Cancellation still awaits the actual GPU publication before releasing leases.
        if rawWaitOwned(command.handle, token) {
            await nativeCompleted(rawCompletion(command.handle, token));
            let finished = checked(Int(rawFinish(command.handle, token)), "macos.command.finish");
        }
    }
}

/// Await and physically settle a submitted command. The handle becomes reusable.
async fn wait(command: Command) -> Int {
    return checked(await waitStatus(command), "macos.command.wait");
}

/// Stop and await run, then join Source children before close. Drain GPU work first.
async fn close(session: Session) -> Int {
    var gpuStatus = 0;
    try {}
    finally {
        let prepared = checked(Int(rawPrepareClose(session.handle)), "macos.close");
        while rawHasPendingCommand(session.handle) {
            let command = Command(handle: rawPendingCommand(session.handle));
            if rawCommandState(command.handle) == 1 {
                let abandoned = checked(Int(rawAbandon(command.handle)), "macos.command.abandon");
            }
            else {
                let status = await waitStatus(command);
                if status < 0 {
                    gpuStatus = status;
                }
            }
        }
        let closed = checked(Int(rawClose(session.handle)), "macos.close");
    }
    return checked(gpuStatus, "macos.close.gpu");
}

/// Owner-scope recovery also closes native acquisitions not yet received by Source.
async fn closeOwnerSessions() -> Int {
    while rawHasOwnerSession() {
        let closed = await close(Session(handle: rawOwnerSession()));
    }
    return 0;
}

