/// Equal cells. Call again on eventResized; coordinates remain AppKit points.
fn layoutStack(parent: View, children: List<View>, padding: Float, gap: Float, vertical: Bool) -> Int {
    let bounds = parent.frame();
    let count = rinzu.List.length(children);
    if padding < 0.0 || gap < 0.0 || bounds.width < padding * 2.0 || bounds.height < padding * 2.0 {
        throw error(-7804, "macos.layout.invalidSpacing");
    }
    if count == 0 {
        return 0;
    }
    var extent = bounds.width - padding * 2.0;
    if vertical {
        extent = bounds.height - padding * 2.0;
    }
    let available = extent - gap * Float(count - 1);
    if available < 0.0 {
        throw error(-7804, "macos.layout.insufficientSpace");
    }
    let cell = available / Float(count);
    var index = 0;
    while index < count {
        switch rinzu.List.get(children, index) {
            case Option.Some(child): {
                var frame = Rect(
                    x: padding + Float(index) * (cell + gap),
                    y: padding,
                    width: cell,
                    height: bounds.height - padding * 2.0
                );
                if vertical {
                    frame = Rect(
                        x: padding,
                        y: bounds.height - padding - cell - Float(index) * (cell + gap),
                        width: bounds.width - padding * 2.0,
                        height: cell
                    );
                }
                let added = parent.addSubview(child);
                let resized = child.setFrame(frame);
            }
            case Option.None: {}
        }
        index = index + 1;
    }
    return 0;
}

fn column(parent: View, children: List<View>, padding: Float, gap: Float) -> Int {
    return layoutStack(parent, children, padding, gap, true);
}

fn row(parent: View, children: List<View>, padding: Float, gap: Float) -> Int {
    return layoutStack(parent, children, padding, gap, false);
}

