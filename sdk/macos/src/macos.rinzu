fn uiStopWindow(window: Window) {
    try {
        let sheets = checked(Int(rawSheetStop(window.handle)), "macos.scope.stopSheets");
    }
    finally {
        let frames = checked(Int(rawFrameStopWindow(window.handle)), "macos.scope.stopFrames");
    }
}

export FrameClock;
export FrameInfo;
export FrameStatistics;

/// A frame begins in AppKit points / top-left; usePixels restores Batch2D pixel units.
class Frame2D {
    const info: FrameInfo,
    const batch: Batch2D,
    const width: Float,
    const height: Float

    fn usePixels(self: Frame2D) {
        self.batch.setTransform(identity2D());
    }

    fn usePoints(self: Frame2D) {
        self.batch.setTransform(scale2D(self.info.scale, self.info.scale));
    }
}

class Canvas2D {
    const view: View,
    const clock: FrameClock,
    const batch: Batch2D,
    clear: Color,
    frames: Int,
    drawing: Bool,
    stopped: Bool,
    disposed: Bool

    fn invalidate(self: Canvas2D) -> Int {
        if self.stopped {
            return 0;
        }
        return self.clock.invalidate();
    }

    fn setAnimating(self: Canvas2D, enabled: Bool) -> Int {
        if self.stopped {
            return 0;
        }
        return self.clock.setAnimating(enabled);
    }

    fn setClear(self: Canvas2D, color: Color) {
        self.clear = color;
        let requested = self.invalidate();
    }

    fn stop(self: Canvas2D) {
        if !self.stopped {
            self.stopped = true;
            let stopped = self.clock.stop();
        }
    }
}

async fn canvasLoop(job: UiJob, canvas: Canvas2D, draw: fn (Frame2D) -> Future<Unit>) {
    try {
        while !job.isStopping() && !canvas.stopped {
            switch await canvas.clock.next() {
                case Option.None: {
                    return;
                }
                case Option.Some(info): {
                    if job.isStopping() || canvas.stopped {
                        return;
                    }
                    canvas.drawing = true;
                    try {
                        canvas.batch.reset(info.width, info.height);
                        canvas.batch.setTransform(scale2D(info.scale, info.scale));
                        await draw(
                            Frame2D(
                                info: info,
                                batch: canvas.batch,
                                width: Float(info.width) / info.scale,
                                height: Float(info.height) / info.scale
                            )
                        );
                        if !job.isStopping() && !canvas.stopped {
                            let rendered = await canvas.batch.render(canvas.view, canvas.clear);
                            let completed = canvas.clock.presented();
                            canvas.frames = canvas.frames + 1;
                        }
                    }
                    catch errors {
                        var index = 0;
                        while index < rinzu.List.length(errors) {
                            switch rinzu.List.get(errors, index) {
                                case Option.None: {}
                                case Option.Some(problem): {
                                    if errorCode(problem) != -7810 {
                                        throw problem;
                                    }
                                }
                            }
                            index = index + 1;
                        }
                        if !job.isStopping() && !canvas.stopped {
                            let retry = canvas.clock.retry();
                        }
                    }
                    finally {
                        canvas.drawing = false;
                    }
                }
            }
        }
    }
    finally {
        canvas.stopped = true;
        try {
            let stopped = canvas.clock.stop();
        }
        finally {
            // Also recover a command left by a failing custom draw callback.
            if rawCommandState(canvas.batch.command.handle) == 1 {
                let abandoned = canvas.batch.command.abandon();
            }
            else if rawCommandState(canvas.batch.command.handle) == 2 {
                let settled = await canvas.batch.command.wait();
            }
        }
    }
}

/// Source-only handler storage. A binding admits one active job at a time.
class UiAction {
    const action: Int,
    const handler: fn (UiJob, UiEvent) -> Future<Unit>,
    busy: Bool
}

class UiActions {
    bindings: List<UiAction>

    fn on(self: UiActions, action: Int, handler: fn (UiJob, UiEvent) -> Future<Unit>) {
        if rinzu.List.length(self.bindings) >= 256 {
            throw error(-7803, "macos.actions.limit");
        }
        var index = 0;
        while index < rinzu.List.length(self.bindings) {
            switch rinzu.List.get(self.bindings, index) {
                case Option.None: {}
                case Option.Some(binding): {
                    if binding.action == action {
                        throw error(-7804, "macos.actions.duplicate");
                    }
                }
            }
            index = index + 1;
        }
        self.bindings = rinzu.List.append(self.bindings, UiAction(action: action, handler: handler, busy: false));
    }

    fn handle(self: UiActions, scope: UiScope, event: UiEvent) {
        if event.kind == eventQuitRequested {
            scope.requestStop();
            return;
        }
        if event.windowId != scope.windowId {
            return;
        }
        if event.kind == eventCloseRequested {
            scope.requestStop();
            return;
        }
        if (event.kind != eventAction && event.kind != eventData) || scope.control.stopping {
            return;
        }
        var index = 0;
        while index < rinzu.List.length(self.bindings) {
            switch rinzu.List.get(self.bindings, index) {
                case Option.None: {}
                case Option.Some(binding): {
                    if binding.action == event.action && !binding.busy {
                        binding.busy = true;
                        var handed = false;
                        try {
                            let registered = scope.start(
                                async fn (job: UiJob) {
                                    try {
                                        await binding.handler(job, event);
                                    }
                                    finally {
                                        binding.busy = false;
                                    }
                                }
                            );
                            handed = true;
                        }
                        finally {
                            if !handed {
                                binding.busy = false;
                            }
                        }
                        return;
                    }
                }
            }
            index = index + 1;
        }
    }
}

fn actions() -> UiActions {
    return UiActions(bindings: []);
}

/// Fixed extent plus a nonnegative proportional share of remaining space.
class LayoutItem {
    const view: View,
    const fixed: Float,
    const grow: Float
}

fn weightedStack(parent: View, children: List<LayoutItem>, padding: Float, gap: Float, vertical: Bool) -> Int {
    if !(padding >= 0.0 && padding <= 32768.0 && gap >= 0.0 && gap <= 32768.0) || rinzu.List.length(children) > 256 {
        throw error(-7804, "macos.layout.spacing");
    }
    let bounds = parent.frame();
    var extent = bounds.width - padding * 2.0;
    var cross = bounds.height - padding * 2.0;
    if vertical {
        extent = bounds.height - padding * 2.0;
        cross = bounds.width - padding * 2.0;
    }
    let count = rinzu.List.length(children);
    if count == 0 {
        return 0;
    }
    var remaining = extent - Float(count - 1) * gap;
    var weights = 0.0;
    var index = 0;
    while index < count {
        switch rinzu.List.get(children, index) {
            case Option.None: {}
            case Option.Some(item): {
                if !(item.fixed >= 0.0 && item.fixed <= 32768.0 && item.grow >= 0.0 && item.grow <= 32768.0) {
                    throw error(-7804, "macos.layout.item");
                }
                let valid = item.view.identity();
                remaining = remaining - item.fixed;
                weights = weights + item.grow;
            }
        }
        index = index + 1;
    }
    if remaining < 0.0 || cross < 0.0 {
        throw error(-7804, "macos.layout.insufficientSpace");
    }
    var offset = padding;
    index = 0;
    while index < count {
        switch rinzu.List.get(children, index) {
            case Option.None: {}
            case Option.Some(item): {
                var size = item.fixed;
                if weights > 0.0 {
                    size = size + remaining * item.grow / weights;
                }
                var frame = Rect(x: offset, y: padding, width: size, height: cross);
                if vertical {
                    frame = Rect(x: padding, y: bounds.height - offset - size, width: cross, height: size);
                }
                let attached = parent.addSubview(item.view);
                let laid = item.view.setFrame(frame);
                offset = offset + size + gap;
            }
        }
        index = index + 1;
    }
    return count;
}

fn weightedRow(parent: View, items: List<LayoutItem>, padding: Float, gap: Float) -> Int {
    return weightedStack(parent, items, padding, gap, false);
}

fn weightedColumn(parent: View, items: List<LayoutItem>, padding: Float, gap: Float) -> Int {
    return weightedStack(parent, items, padding, gap, true);
}

