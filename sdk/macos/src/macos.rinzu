import rinzu.List;
import rinzu.timer;
import "./document.rinzu" as documents;
import "./document_files.rinzu" as documentFiles;
import "./image_files.rinzu" as imageFiles;
import rinzu.shutdown;

class Buffer {
    const handle: BufferHandle

    fn write(self: Buffer, offset: Int, bytes: ByteArray) -> Int {
        return checked(Int(rawBufferWrite(self.handle, offset, bytes, byteLength(bytes))), "macos.buffer.write");
    }

    fn read(self: Buffer, offset: Int, length: Int) -> ByteArray {
        let status = checked(Int(rawBufferRead(self.handle, offset, length)), "macos.buffer.read");
        return rawBufferBytes(self.handle);
    }

    fn destroy(self: Buffer) -> Int {
        return checked(Int(rawBufferDestroy(self.handle)), "macos.buffer.destroy");
    }

    fn writeVertex2D(self: Buffer, index: Int, vertex: Vertex2D) -> Int {
        return checked(Int(rawBufferVertex(self.handle, index, vertex)), "macos.buffer.vertex2D");
    }

    fn writeQuad2D(self: Buffer, index: Int, quad: Quad2D) -> Int {
        let data = QuadData2D(
            x: quad.destination.x,
            y: quad.destination.y,
            width: quad.destination.width,
            height: quad.destination.height,
            u: quad.uv.x,
            v: quad.uv.y,
            uvWidth: quad.uv.width,
            uvHeight: quad.uv.height,
            red: quad.tint.red,
            green: quad.tint.green,
            blue: quad.tint.blue,
            alpha: quad.tint.alpha,
            a: quad.transform.a,
            b: quad.transform.b,
            c: quad.transform.c,
            d: quad.transform.d,
            tx: quad.transform.tx,
            ty: quad.transform.ty
        );
        return checked(Int(rawBufferQuad(self.handle, index, data)), "macos.buffer.quad2D");
    }
}

class Command {
    const handle: CommandHandle

    fn beginCompute(self: Command, pipeline: ComputePipeline) -> Int {
        return checked(Int(rawBeginCompute(self.handle, pipeline.handle)), "macos.command.beginCompute");
    }

    fn beginRender(self: Command, view: View, clear: Color) -> Int {
        return checked(Int(rawBeginRender(self.handle, view.handle, clear)), "macos.command.beginRender");
    }

    fn setRenderPipeline(self: Command, pipeline: RenderPipeline) -> Int {
        return checked(Int(rawSetPipeline(self.handle, pipeline.handle)), "macos.command.renderPipeline");
    }

    fn setComputeBuffer(self: Command, index: Int, buffer: Buffer, offset: Int) -> Int {
        return checked(
            Int(rawSetBuffer(self.handle, buffer.handle, offset, index, CInt(0))),
            "macos.command.computeBuffer"
        );
    }

    fn setVertexBuffer(self: Command, index: Int, buffer: Buffer, offset: Int) -> Int {
        return checked(
            Int(rawSetBuffer(self.handle, buffer.handle, offset, index, CInt(1))),
            "macos.command.vertexBuffer"
        );
    }

    fn setFragmentBuffer(self: Command, index: Int, buffer: Buffer, offset: Int) -> Int {
        return checked(
            Int(rawSetBuffer(self.handle, buffer.handle, offset, index, CInt(2))),
            "macos.command.fragmentBuffer"
        );
    }

    fn dispatch(self: Command, x: Int, y: Int, z: Int, tx: Int, ty: Int, tz: Int) -> Int {
        return checked(Int(rawDispatch(self.handle, x, y, z, tx, ty, tz)), "macos.command.dispatch");
    }

    fn drawTriangles(self: Command, start: Int, count: Int) -> Int {
        return checked(Int(rawDraw(self.handle, start, count)), "macos.command.drawTriangles");
    }

    fn commit(self: Command) -> Int {
        return checked(Int(rawCommit(self.handle)), "macos.command.commit");
    }

    fn abandon(self: Command) -> Int {
        return checked(Int(rawAbandon(self.handle)), "macos.command.abandon");
    }

    async fn wait(self: Command) -> Int {
        return await wait(self);
    }

    fn destroy(self: Command) -> Int {
        return checked(Int(rawCommandDestroy(self.handle)), "macos.command.destroy");
    }

    fn beginRenderTexture(self: Command, texture: Texture, clear: Color) -> Int {
        return checked(Int(rawRenderTexture(self.handle, texture.handle, clear)), "macos.command.beginRenderTexture");
    }

    /// Render state uses pixels with top-left origin, independently of AppKit points.
    fn setViewport(self: Command, viewport: Rect) -> Int {
        return checked(Int(rawViewport(self.handle, viewport)), "macos.command.viewport");
    }

    fn setScissor(self: Command, scissor: Scissor) -> Int {
        return checked(Int(rawScissor(self.handle, scissor)), "macos.command.scissor");
    }

    fn setComputeTexture(self: Command, index: Int, texture: Texture) -> Int {
        return checked(Int(rawSetTexture(self.handle, texture.handle, index, CInt(0))), "macos.command.computeTexture");
    }

    fn setVertexTexture(self: Command, index: Int, texture: Texture) -> Int {
        return checked(Int(rawSetTexture(self.handle, texture.handle, index, CInt(1))), "macos.command.vertexTexture");
    }

    fn setFragmentTexture(self: Command, index: Int, texture: Texture) -> Int {
        return checked(
            Int(rawSetTexture(self.handle, texture.handle, index, CInt(2))),
            "macos.command.fragmentTexture"
        );
    }

    fn setComputeSampler(self: Command, index: Int, sampler: Sampler) -> Int {
        return checked(Int(rawSetSampler(self.handle, sampler.handle, index, CInt(0))), "macos.command.computeSampler");
    }

    fn setVertexSampler(self: Command, index: Int, sampler: Sampler) -> Int {
        return checked(Int(rawSetSampler(self.handle, sampler.handle, index, CInt(1))), "macos.command.vertexSampler");
    }

    fn setFragmentSampler(self: Command, index: Int, sampler: Sampler) -> Int {
        return checked(
            Int(rawSetSampler(self.handle, sampler.handle, index, CInt(2))),
            "macos.command.fragmentSampler"
        );
    }
}

class ComputePipeline {
    const handle: ComputePipelineHandle

    fn destroy(self: ComputePipeline) -> Int {
        return checked(Int(rawComputeDestroy(self.handle)), "macos.computePipeline.destroy");
    }
}

class Device {
    const handle: DeviceHandle

    fn buffer(self: Device, bytes: ByteArray) -> Buffer {
        return Buffer(
            handle: rawBuffer(checked(rawBufferCreate(self.handle, bytes, byteLength(bytes)), "macos.buffer"))
        );
    }

    fn allocateBuffer(self: Device, length: Int) -> Buffer {
        return Buffer(handle: rawBuffer(checked(rawBufferAllocate(self.handle, length), "macos.buffer.allocate")));
    }

    fn library(self: Device, source: String) -> Library {
        let bytes = utf8Encode(source);
        return Library(
            handle: rawLibrary(checked(rawLibraryCreate(self.handle, bytes, byteLength(bytes), false), "macos.library"))
        );
    }

    fn loadLibrary(self: Device, path: String) -> Library {
        let bytes = utf8Encode(path);
        return Library(
            handle: rawLibrary(
                checked(rawLibraryCreate(self.handle, bytes, byteLength(bytes), true), "macos.library.load")
            )
        );
    }

    fn surface(self: Device, rect: Rect) -> View {
        return View(handle: rawView(checked(rawSurfaceCreate(self.handle, rect), "macos.surface")));
    }

    /// Allocate a reusable command handle, normally once per in-flight frame slot.
    fn command(self: Device) -> Command {
        return Command(handle: rawCommand(checked(rawCommandCreate(self.handle), "macos.command")));
    }

    fn destroy(self: Device) -> Int {
        return checked(Int(rawDeviceDestroy(self.handle)), "macos.device.destroy");
    }

    /// Single-level RGBA8 / BGRA8 unorm texture. Usage is a sum of distinct flags.
    fn texture2D(self: Device, width: Int, height: Int, format: Int, usage: Int) -> Texture {
        return Texture(
            handle: rawTexture(checked(rawTextureCreate(self.handle, width, height, format, usage), "macos.texture2D"))
        );
    }

    /// Decode frame zero, normalize EXIF orientation and premultiplied sRGB RGBA8.
/// Encoded input <=64 MiB, dimensions <=8192, decoded pixels <=256 MiB.
    fn imageTexture(self: Device, encoded: ByteArray) -> Texture {
        return Texture(
            handle: rawTexture(
                checked(rawTextureImage(self.handle, encoded, byteLength(encoded)), "macos.imageTexture")
            )
        );
    }

    fn sampler(self: Device, filter: Int, address: Int) -> Sampler {
        return Sampler(handle: rawSampler(checked(rawSamplerCreate(self.handle, filter, address), "macos.sampler")));
    }

    /// Allocate packed float32 x,y,u,v,r,g,b,a vertices (32 bytes each).
    fn vertexBuffer2D(self: Device, capacity: Int) -> Buffer {
        if capacity <= 0 || capacity > 8388608 {
            throw error(-7804, "macos.vertexBuffer2D.capacity");
        }
        return self.allocateBuffer(capacity * 32);
    }

    fn batch2D(self: Device, capacity: Int) -> Batch2D {
        if capacity <= 0 || capacity > 65536 {
            throw error(-7804, "macos.batch2D.capacity");
        }
        let shader = r#"
#include <metal_stdlib>
using namespace metal;
struct Vertex { float2 position; float2 uv; float4 color; };
struct Raster { float4 position [[position]]; float2 uv; float4 color; };
vertex Raster vertex2d(uint i [[vertex_id]], const device Vertex *vertices [[buffer(0)]]) {
    Vertex v = vertices[i];
    return {float4(v.position, 0, 1), v.uv, v.color};
}
fragment float4 fragment2d(Raster v [[stage_in]], texture2d<float> image [[texture(0)]], sampler filter [[sampler(0)]]) {
    return image.sample(filter, v.uv) * float4(v.color.rgb * v.color.a, v.color.a);
}
"#;
        let library = self.library(shader);
        try {
            let rgba = library.renderPipelineWithOptions("vertex2d", "fragment2d", pixelRGBA8, blendPremultiplied);
            let bgra = library.renderPipelineWithOptions("vertex2d", "fragment2d", pixelBGRA8, blendPremultiplied);
            let white = self.texture2D(1, 1, pixelRGBA8, textureSampled);
            let uploaded = white.write(Scissor(x: 0, y: 0, width: 1, height: 1), 4, byteArray(b"\xff\xff\xff\xff"));
            return Batch2D(
                vertices: self.vertexBuffer2D(capacity * 6),
                rgba: rgba,
                bgra: bgra,
                nearest: self.sampler(filterNearest, addressClamp),
                linear: self.sampler(filterLinear, addressClamp),
                white: white,
                command: self.command(),
                capacity: capacity,
                width: 0,
                height: 0,
                count: 0,
                draws: [],
                transform: identity2D(),
                clip: Scissor(x: 0, y: 0, width: 1, height: 1),
                filter: filterLinear,
                closed: false,
                rendering: false
            );
        }
        finally {
            let closed = library.destroy();
        }
    }

    /// Stream the encoded file with a 64 MiB limit, then decode on Main.
/// Decode/upload is synchronous; cooperative async decode is a later extension.
    async fn loadImageTexture(self: Device, path: String) -> Texture {
        let bytes = await imageFiles.readImageBytes(path);
        return self.imageTexture(bytes);
    }

    fn rasterText(self: Device, layout: TextLayout, scale: Float) -> Texture {
        return Texture(
            handle: rawTexture(checked(rawTextTexture(self.handle, layout.handle, scale), "macos.text.raster"))
        );
    }

    fn text2D(self: Device, font: Font, text: String, width: Float, alignment: Int, scale: Float) -> Text2D {
        let layout = font.layout(text, width, alignment);
        var retained = false;
        try {
            let texture = self.rasterText(layout, scale);
            let info = texture.info();
            let result = Text2D(
                layout: layout,
                texture: texture,
                metrics: layout.metrics(),
                scale: scale,
                width: info.width,
                height: info.height
            );
            retained = true;
            return result;
        }
        finally {
            if !retained {
                let released = layout.destroy();
            }
        }
    }
}

class Font {
    const handle: FontHandle

    /// UTF8 <=64 KiB. Width zero is natural; positive width wraps. Alignment 0/1/2.
    fn layout(self: Font, text: String, width: Float, alignment: Int) -> TextLayout {
        let bytes = utf8Encode(text);
        return TextLayout(
            handle: rawText(
                checked(rawTextCreate(self.handle, bytes, byteLength(bytes), width, alignment), "macos.text.layout")
            )
        );
    }

    fn destroy(self: Font) -> Int {
        return checked(Int(rawFontDestroy(self.handle)), "macos.font.destroy");
    }
}

class FrameClock {
    const handle: FrameClockHandle

    fn invalidate(self: FrameClock) -> Int {
        return checked(Int(rawFrameRequest(self.handle)), "macos.frame.invalidate");
    }

    fn setAnimating(self: FrameClock, enabled: Bool) -> Int {
        return checked(Int(rawFrameAnimating(self.handle, enabled)), "macos.frame.animating");
    }

    fn retry(self: FrameClock) -> Int {
        return checked(Int(rawFrameRetry(self.handle)), "macos.frame.retry");
    }

    fn presented(self: FrameClock) -> Int {
        return checked(Int(rawFramePresented(self.handle)), "macos.frame.presented");
    }

    fn stop(self: FrameClock) -> Int {
        return checked(Int(rawFrameStop(self.handle)), "macos.frame.stop");
    }

    fn destroy(self: FrameClock) -> Int {
        return checked(Int(rawFrameDestroy(self.handle)), "macos.frame.destroy");
    }

    fn statistics(self: FrameClock) -> FrameStatistics {
        let output = FrameStatistics(
            requests: 0,
            coalesced: 0,
            ticks: 0,
            retries: 0,
            pending: false,
            visible: false,
            animating: false,
            stopped: false
        );
        let status = checked(Int(rawFrameStatistics(self.handle, output)), "macos.frame.statistics");
        return output;
    }

    /// One reader. Cancellation disarms this wait and acknowledges physical publication.
    async fn next(self: FrameClock) -> Option<FrameInfo> {
        var startup = checked(Int(rawFrameState(self.handle)), "macos.frame.startup");
        while startup == 0 {
            await rinzu.timer.sleep(1);
            startup = checked(Int(rawFrameState(self.handle)), "macos.frame.startup");
        }
        if startup == 2 {
            return Option<FrameInfo>.None();
        }
        let token = checked(rawWaitToken(), "macos.frame.token");
        try {
            let admitted = checked(Int(rawFrameBegin(self.handle, token)), "macos.frame.wait");
            await nativeCompleted(rawFrameCompletion(self.handle, token));
            let output = FrameInfo(sequence: 0, width: 0, height: 0, scale: 1.0, time: 0.0, delta: 0.0);
            let available = checked(Int(rawFrameTake(self.handle, token, output)), "macos.frame.take");
            if available == 0 {
                return Option<FrameInfo>.None();
            }
            return Option<FrameInfo>.Some(value: output);
        }
        finally {
            if rawFrameOwned(self.handle, token) {
                let cancelled = checked(Int(rawFrameCancel(self.handle, token)), "macos.frame.cancel");
                await nativeCompleted(rawFrameCompletion(self.handle, token));
                let finished = checked(Int(rawFrameFinish(self.handle, token)), "macos.frame.finish");
            }
        }
    }
}

class Library {
    const handle: LibraryHandle

    fn computePipeline(self: Library, name: String) -> ComputePipeline {
        let bytes = utf8Encode(name);
        return ComputePipeline(
            handle: rawCompute(
                checked(rawComputeCreate(self.handle, bytes, byteLength(bytes)), "macos.computePipeline")
            )
        );
    }

    fn renderPipeline(self: Library, vertex: String, fragment: String) -> RenderPipeline {
        let vertexBytes = utf8Encode(vertex);
        let fragmentBytes = utf8Encode(fragment);
        return RenderPipeline(
            handle: rawRender(
                checked(
                    rawRenderCreate(
                        self.handle,
                        vertexBytes,
                        byteLength(vertexBytes),
                        fragmentBytes,
                        byteLength(fragmentBytes)
                    ),
                    "macos.renderPipeline"
                )
            )
        );
    }

    fn destroy(self: Library) -> Int {
        return checked(Int(rawLibraryDestroy(self.handle)), "macos.library.destroy");
    }

    fn renderPipelineWithOptions(self: Library, vertex: String, fragment: String, format: Int, blend: Int)
        -> RenderPipeline {
        let v = utf8Encode(vertex);
        let f = utf8Encode(fragment);
        return RenderPipeline(
            handle: rawRender(
                checked(
                    rawRenderOptions(self.handle, v, byteLength(v), f, byteLength(f), format, blend),
                    "macos.renderPipeline.options"
                )
            )
        );
    }
}

class Menu {
    const handle: MenuHandle

    fn addAction(self: Menu, title: String, action: Int, key: String, modifiers: Int) -> Int {
        let bytes = utf8Encode(title);
        let shortcut = utf8Encode(key);
        return checked(
            Int(
                rawMenuItem(self.handle, bytes, byteLength(bytes), shortcut, byteLength(shortcut), modifiers, action, 0)
            ),
            "macos.menu.action"
        );
    }

    fn addStandard(self: Menu, title: String, command: Int, key: String, modifiers: Int) -> Int {
        let bytes = utf8Encode(title);
        let shortcut = utf8Encode(key);
        return checked(
            Int(
                rawMenuItem(
                    self.handle,
                    bytes,
                    byteLength(bytes),
                    shortcut,
                    byteLength(shortcut),
                    modifiers,
                    0,
                    CInt(command)
                )
            ),
            "macos.menu.standard"
        );
    }

    fn addSubmenu(self: Menu, child: Menu) -> Int {
        return checked(Int(rawMenuSubmenu(self.handle, child.handle)), "macos.menu.submenu");
    }

    fn addSeparator(self: Menu) -> Int {
        return checked(Int(rawMenuSeparator(self.handle)), "macos.menu.separator");
    }

    fn setState(self: Menu, action: Int, enabled: Bool, isChecked: Bool) -> Int {
        return checked(Int(rawMenuState(self.handle, action, enabled, isChecked)), "macos.menu.state");
    }

    fn destroy(self: Menu) -> Int {
        return checked(Int(rawMenuDestroy(self.handle)), "macos.menu.destroy");
    }
}

class RenderPipeline {
    const handle: RenderPipelineHandle

    fn destroy(self: RenderPipeline) -> Int {
        return checked(Int(rawRenderDestroy(self.handle)), "macos.renderPipeline.destroy");
    }
}

class Sampler {
    const handle: SamplerHandle

    fn destroy(self: Sampler) -> Int {
        return checked(Int(rawSamplerDestroy(self.handle)), "macos.sampler.destroy");
    }
}

class Session {
    const handle: SessionHandle

    /// Owned absolute app-resource root; None in an ordinary JIT/console host.
    fn resourceRoot(self: Session) -> Option<String> {
        let length = checked(rawResourceRootSize(self.handle), "macos.resourceRoot");
        if length == 0 {
            return Option<String>.None();
        }
        return Option<String>.Some(value: utf8Decode(rawResourceRootBytes(self.handle)));
    }

    /// Resolve a normalized app-relative resource name without changing cwd.
    fn resourcePath(self: Session, relative: String) -> String {
        let bytes = utf8Encode(relative);
        let valid = checked(Int(rawResourceRelative(bytes, byteLength(bytes))), "macos.resourcePath");
        switch self.resourceRoot() {
            case Option.Some(root): {
                return f"{root}/{relative}";
            }
            case Option.None: {
                throw error(-7804, "macos.resourcePath.notBundled");
            }
        }
    }

    fn isRunning(self: Session) -> Bool {
        return rawRunning(self.handle);
    }

    fn runEvents(self: Session) -> Future<Int> {
        return runEvents(self);
    }

    async fn nextEvent(self: Session) -> UiEvent {
        return await nextEvent(self);
    }

    fn window(self: Session, title: String, width: Float, height: Float) -> Window {
        let bytes = utf8Encode(title);
        return Window(
            handle: rawWindow(
                checked(rawWindowCreate(self.handle, bytes, byteLength(bytes), width, height), "macos.window")
            )
        );
    }

    fn view(self: Session, rect: Rect) -> View {
        return View(handle: rawView(checked(rawViewCreate(self.handle, rect), "macos.view")));
    }

    fn device(self: Session) -> Device {
        return Device(handle: rawDevice(checked(rawDeviceCreate(self.handle), "macos.device")));
    }

    async fn run(self: Session, handler: fn (RunContext, Event) -> Unit) -> Int {
        return await run(self, handler);
    }

    fn stop(self: Session) -> Int {
        return stop(self);
    }

    async fn close(self: Session) -> Int {
        return await close(self);
    }

    fn label(self: Session, title: String, frame: Rect) -> Label {
        return Label(view: newWidget(self, 1, title, frame, 0));
    }

    fn button(self: Session, title: String, frame: Rect, action: Int) -> Button {
        return Button(view: newWidget(self, 2, title, frame, action));
    }

    fn checkbox(self: Session, title: String, frame: Rect, action: Int) -> Checkbox {
        return Checkbox(view: newWidget(self, 3, title, frame, action));
    }

    fn textField(self: Session, title: String, frame: Rect, action: Int) -> TextField {
        return TextField(view: newWidget(self, 4, title, frame, action));
    }

    fn textView(self: Session, title: String, frame: Rect) -> TextView {
        return TextView(view: newWidget(self, 5, title, frame, 0));
    }

    fn scrollView(self: Session, frame: Rect) -> ScrollView {
        return ScrollView(view: newWidget(self, 6, "", frame, 0));
    }

    fn setClipboardText(self: Session, value: String) -> Int {
        let bytes = utf8Encode(value);
        return checked(Int(rawClipboardWrite(self.handle, bytes, byteLength(bytes))), "macos.clipboard.write");
    }

    fn clipboardText(self: Session) -> String {
        let token = checked(rawWaitToken(), "macos.clipboard.token");
        try {
            let acquired = checked(Int(rawClipboardSnapshot(self.handle, token)), "macos.clipboard.snapshot");
            return utf8Decode(rawClipboardBytes(self.handle, token));
        }
        finally {
            if rawClipboardOwned(self.handle, token) {
                let released = checked(Int(rawClipboardFinish(self.handle, token)), "macos.clipboard.finish");
            }
        }
    }

    /// Sequence barrier for reconciling a native snapshot with already queued input.
    fn eventSequence(self: Session) -> Int {
        return checked(rawEventSequence(self.handle), "macos.event.sequence");
    }

    fn font(self: Session, name: String, size: Float, bold: Bool) -> Font {
        let bytes = utf8Encode(name);
        return Font(
            handle: rawFont(checked(rawFontCreate(self.handle, bytes, byteLength(bytes), size, bold), "macos.font"))
        );
    }
}

class TextLayout {
    const handle: TextLayoutHandle

    fn metrics(self: TextLayout) -> TextMetrics {
        let output = TextMetrics(
            width: 0.0,
            height: 0.0,
            baseline: 0.0,
            ascent: 0.0,
            descent: 0.0,
            leading: 0.0,
            left: 0.0,
            top: 0.0,
            rasterWidth: 0.0,
            rasterHeight: 0.0,
            lines: 0
        );
        let status = checked(Int(rawTextMetrics(self.handle, output)), "macos.text.metrics");
        return output;
    }

    fn destroy(self: TextLayout) -> Int {
        return checked(Int(rawTextDestroy(self.handle)), "macos.text.destroy");
    }
}

class Texture {
    const handle: TextureHandle

    fn info(self: Texture) -> TextureInfo {
        let output = TextureInfo(width: 0, height: 0, format: 0, usage: 0, bytes: 0);
        let status = checked(Int(rawTextureInfo(self.handle, output)), "macos.texture.info");
        return output;
    }

    fn write(self: Texture, region: Scissor, rowBytes: Int, bytes: ByteArray) -> Int {
        return checked(
            Int(rawTextureWrite(self.handle, region, rowBytes, bytes, byteLength(bytes))),
            "macos.texture.write"
        );
    }

    /// Tightly packed owned bytes, in the texture's channel order; requires no GPU lease.
    fn read(self: Texture, region: Scissor) -> ByteArray {
        let status = checked(Int(rawTextureRead(self.handle, region)), "macos.texture.read");
        return rawTextureBytes(self.handle);
    }

    fn destroy(self: Texture) -> Int {
        return checked(Int(rawTextureDestroy(self.handle)), "macos.texture.destroy");
    }

    fn identity(self: Texture) -> Int {
        return checked(rawTextureId(self.handle), "macos.texture.identity");
    }
}

class View {
    const handle: ViewHandle

    fn setAccessibility(self: View, label: String, help: String, identifier: String) -> Int {
        let a = utf8Encode(label);
        let b = utf8Encode(help);
        let c = utf8Encode(identifier);
        return checked(
            Int(rawAccessibility(self.handle, a, byteLength(a), b, byteLength(b), c, byteLength(c))),
            "macos.accessibility"
        );
    }

    fn setTooltip(self: View, text: String) -> Int {
        let bytes = utf8Encode(text);
        return checked(Int(rawTooltip(self.handle, bytes, byteLength(bytes))), "macos.tooltip");
    }

    fn identity(self: View) -> Int {
        return checked(rawViewId(self.handle), "macos.view.identity");
    }

    fn frame(self: View) -> Rect {
        let output = Rect(x: 0.0, y: 0.0, width: 0.0, height: 0.0);
        let status = checked(Int(rawViewFrame(self.handle, output)), "macos.view.frame");
        return output;
    }

    fn setFrame(self: View, rect: Rect) -> Int {
        return checked(Int(rawViewSetFrame(self.handle, rect)), "macos.view.setFrame");
    }

    fn addSubview(self: View, child: View) -> Int {
        return checked(Int(rawViewAdd(self.handle, child.handle)), "macos.view.add");
    }

    fn removeFromSuperview(self: View) -> Int {
        return checked(Int(rawViewRemove(self.handle)), "macos.view.remove");
    }

    fn destroy(self: View) -> Int {
        return checked(Int(rawViewDestroy(self.handle)), "macos.view.destroy");
    }

    fn requestDraw(self: View) -> Int {
        return checked(Int(rawRequestDraw(self.handle)), "macos.view.requestDraw");
    }

    fn setEnabled(self: View, enabled: Bool) -> Int {
        return checked(Int(rawEnabled(self.handle, enabled)), "macos.view.enabled");
    }

    fn setHidden(self: View, hidden: Bool) -> Int {
        return checked(Int(rawHidden(self.handle, hidden)), "macos.view.hidden");
    }

    fn focus(self: View) -> Int {
        return checked(Int(rawFocus(self.handle)), "macos.view.focus");
    }

    fn isEnabled(self: View) -> Bool {
        let state = widgetState(self);
        return state.enabled;
    }

    fn isHidden(self: View) -> Bool {
        let state = widgetState(self);
        return state.hidden;
    }

    /// AppKit bits: min-X margin 1, width 2, max-X 4, min-Y 8, height 16, max-Y 32.
    fn setAutoresizing(self: View, mask: Int) -> Int {
        return checked(Int(rawAutoresizing(self.handle, mask)), "macos.view.autoresizing");
    }

    /// Attach with constant insets and resize width/height with the parent.
    fn fill(self: View, parent: View, inset: Float) -> Int {
        let bounds = parent.frame();
        if inset < 0.0 || bounds.width < inset * 2.0 || bounds.height < inset * 2.0 {
            throw error(-7804, "macos.layout.invalidInset");
        }
        let attached = parent.addSubview(self);
        let framed = self.setFrame(
            Rect(x: inset, y: inset, width: bounds.width - inset * 2.0, height: bounds.height - inset * 2.0)
        );
        return self.setAutoresizing(18);
    }

    fn drawableSize(self: View) -> Rect {
        let output = Rect(x: 0.0, y: 0.0, width: 0.0, height: 0.0);
        let status = checked(Int(rawSurfaceSize(self.handle, output)), "macos.surface.drawableSize");
        return output;
    }

    fn frameClock(self: View, fps: Int) -> FrameClock {
        return FrameClock(handle: rawFrame(checked(rawFrameCreate(self.handle, fps), "macos.frameClock")));
    }
}

class Window {
    const handle: WindowHandle

    fn identity(self: Window) -> Int {
        return checked(rawWindowId(self.handle), "macos.window.identity");
    }

    fn show(self: Window) -> Int {
        return checked(Int(rawWindowShow(self.handle)), "macos.window.show");
    }

    fn setTitle(self: Window, title: String) -> Int {
        let bytes = utf8Encode(title);
        return checked(Int(rawWindowTitle(self.handle, bytes, byteLength(bytes))), "macos.window.title");
    }

    fn setContentSize(self: Window, width: Float, height: Float) -> Int {
        return checked(Int(rawWindowSize(self.handle, width, height)), "macos.window.size");
    }

    fn contentView(self: Window) -> View {
        return View(handle: rawContentView(self.handle));
    }

    fn destroy(self: Window) -> Int {
        return checked(Int(rawWindowDestroy(self.handle)), "macos.window.destroy");
    }

    fn menu(self: Window, title: String) -> Menu {
        let bytes = utf8Encode(title);
        return Menu(
            handle: rawMenu(checked(rawMenuCreate(self.handle, bytes, byteLength(bytes)), "macos.menu.create"))
        );
    }

    fn setMenu(self: Window, menu: Menu) -> Int {
        return checked(Int(rawWindowMenu(self.handle, menu.handle)), "macos.window.menu");
    }

    fn command(self: Window, command: Int) -> Int {
        return checked(Int(rawWindowCommand(self.handle, CInt(command))), "macos.window.command");
    }

    /// One file, as an owned absolute path. Cancel returns None. Empty directory uses AppKit's default.
    fn openFile(self: Window, title: String, directory: String) -> Future<Option<String>> {
        return filePanel(self, false, title, directory, "");
    }

    /// Choose a destination; writing the file remains a separate operation.
    fn saveFile(self: Window, title: String, directory: String, name: String) -> Future<Option<String>> {
        return filePanel(self, true, title, directory, name);
    }

    /// One to three buttons, numbered 1..3. Empty optional titles omit buttons. Dismissal returns 0.
    async fn alert(self: Window, title: String, message: String, first: String, second: String, third: String) -> Int {
        await sheetReady(self);
        let token = checked(rawWaitToken(), "macos.sheet.token");
        try {
            let heading = utf8Encode(title);
            let body = utf8Encode(message);
            let one = utf8Encode(first);
            let two = utf8Encode(second);
            let three = utf8Encode(third);
            let admitted = checked(
                Int(
                    rawAlertBegin(
                        self.handle,
                        token,
                        heading,
                        byteLength(heading),
                        body,
                        byteLength(body),
                        one,
                        byteLength(one),
                        two,
                        byteLength(two),
                        three,
                        byteLength(three)
                    )
                ),
                "macos.alert.begin"
            );
            await nativeCompleted(rawSheetCompletion(self.handle, token));
            return checked(Int(rawSheetResult(self.handle, token)), "macos.alert.result");
        }
        finally {
            if rawSheetOwned(self.handle, token) {
                try {
                    let dismissed = checked(Int(rawSheetCancel(self.handle, token)), "macos.sheet.cancel");
                }
                finally {
                    await nativeCompleted(rawSheetCompletion(self.handle, token));
                    let finished = checked(Int(rawSheetFinish(self.handle, token)), "macos.sheet.finish");
                }
            }
        }
    }

    /// Dismiss the current sheet without closing the Window or stopping later sheets.
    fn dismissSheet(self: Window) -> Int {
        return checked(Int(rawSheetDismiss(self.handle)), "macos.sheet.dismiss");
    }

    fn state(self: Window) -> Int {
        return checked(Int(rawWindowState(self.handle)), "macos.window.state");
    }

    fn hide(self: Window) -> Int {
        return checked(Int(rawWindowVisibility(self.handle, CInt(1))), "macos.window.hide");
    }

    fn minimize(self: Window) -> Int {
        return checked(Int(rawWindowVisibility(self.handle, CInt(2))), "macos.window.minimize");
    }

    fn restore(self: Window) -> Int {
        return checked(Int(rawWindowVisibility(self.handle, CInt(3))), "macos.window.restore");
    }

    fn setMinimumContentSize(self: Window, width: Float, height: Float) -> Int {
        return checked(Int(rawWindowMinimumSize(self.handle, width, height)), "macos.window.minimumSize");
    }

    fn setTheme(self: Window, theme: Int) -> Int {
        return checked(Int(rawWindowTheme(self.handle, theme)), "macos.window.theme");
    }

    fn effectiveTheme(self: Window) -> Int {
        return checked(Int(rawEffectiveTheme(self.handle)), "macos.window.effectiveTheme");
    }
}

