export diagnostic;
export statistics;
export metalAvailable;
export UiEvent;
export runEvents;
export nextEvent;
export eventStopped;
export eventAction;
export eventTextChanged;
export eventSelectionChanged;
export eventScroll;
export eventFocus;
export eventWindowState;

/// A cooperative job registered with a UI scope. Prefer UiScope.start.
class UiTask {
    pending: Option<Future<Unit>>,
    done: Bool,
    started: Bool
}

/// Shared stop state contains no task handles.
class UiControl {
    stopping: Bool,
    closed: Bool
}

/// A job receives native UI capabilities and stop state, without the job registry.
class UiJob {
    const session: Session,
    const window: Window,
    const windowId: Int,
    const control: UiControl

    fn isStopping(self: UiJob) -> Bool {
        return self.control.stopping;
    }

    fn requestStop(self: UiJob) {
        self.control.stopping = true;
        uiStopWindow(self.window);
    }

    fn wake(self: UiJob) -> Int {
        if self.control.closed {
            throw error(-7803, "UI scope is closed");
        }
        return checked(Int(rawScopeNotify(self.session.handle, self.windowId)), "macos.job.wake");
    }
}

/// Main-owned Window resources and Source jobs. Jobs receive a UiJob context.
class UiScope {
    const session: Session,
    const window: Window,
    const windowId: Int,
    tasks: List<UiTask>,
    canvases: List<Canvas2D>,
    errors: List<Error>,
    reportedErrors: Int,
    const control: UiControl

    fn start(self: UiScope, work: fn (UiJob) -> Future<Unit>) -> Int {
        {
            if self.control.closed || self.control.stopping {
                throw error(-7803, "UI scope is stopping");
            }
            self.tasks = rinzu.List.filter(
                self.tasks,
                fn (job: UiTask) -> Bool {
                    return !job.done;
                }
            );
            if rinzu.List.length(self.tasks) >= 256 {
                throw error(-7803, "UI scope job limit");
            }
            let job = UiTask(pending: Option<Future<Unit>>.None(), done: false, started: false);
            self.tasks = rinzu.List.append(self.tasks, job);
            job.pending = Option<Future<Unit>>.Some(value: uiRunJob(self, job, work));
        }
        return 0;
    }

    fn isStopping(self: UiScope) -> Bool {
        return self.control.stopping;
    }

    fn requestStop(self: UiScope) {
        self.control.stopping = true;
        uiStopWindow(self.window);
    }

    /// Wake the single dispatcher after Source state changes outside an input handler.
    fn wake(self: UiScope) -> Int {
        if self.control.closed {
            throw error(-7803, "UI scope is closed");
        }
        return checked(Int(rawScopeNotify(self.session.handle, self.windowId)), "macos.scope.wake");
    }

    /// Join the current jobs without closing the Window; callers stop job admission first.
    async fn join(self: UiScope) -> Int {
        await uiJoinJobs(self.tasks, 0);
        return uiReportErrors(self);
    }

    /// The Application has one reader. Close/quit policy stays in the Source handler.
    async fn dispatch(self: UiScope, handler: fn (UiScope, UiEvent) -> Future<Unit>) {
        while !self.control.stopping {
            let event = await self.session.nextEvent();
            if event.kind == eventStopped {
                self.control.stopping = true;
            }
            else {
                await handler(self, event);
            }
        }
    }

    async fn close(self: UiScope) -> Int {
        self.control.stopping = true;
        try {
            try {
                uiStopWindow(self.window);
            }
            finally {
                try {
                    await uiJoinJobs(self.tasks, 0);
                }
                finally {
                    uiCloseCanvases(self);
                }
            }
        }
        finally {
            self.control.closed = true;
        }
        return uiReportErrors(self);
    }

    fn surface(self: UiScope, device: Device, frame: Rect) -> View {
        return View(
            handle: rawView(checked(rawSurfaceScoped(device.handle, self.window.handle, frame), "macos.scope.surface"))
        );
    }

    fn listView(self: UiScope, frame: Rect, action: Int) -> DataView {
        return createDataView(self, 1, [DataColumn(title: "", width: 160.0, sortable: false)], frame, action);
    }

    fn tableView(self: UiScope, columns: List<DataColumn>, frame: Rect, action: Int) -> DataView {
        return createDataView(self, 2, columns, frame, action);
    }

    fn treeView(self: UiScope, columns: List<DataColumn>, frame: Rect, action: Int) -> DataView {
        return createDataView(self, 3, columns, frame, action);
    }

    /// A scope-owned drawing job. Draw callbacks stay in Source, never in AppKit.
    fn canvas2D(
        self: UiScope,
        device: Device,
        frame: Rect,
        capacity: Int,
        fps: Int,
        clear: Color,
        draw: fn (Frame2D) -> Future<Unit>
    ) -> Canvas2D {
        if self.control.stopping || rinzu.List.length(self.canvases) >= 256 {
            throw error(-7803, "macos.canvas.limitOrStopping");
        }
        var result: Option<Canvas2D> = Option<Canvas2D>.None();
        // Native-only acquisition is masked. The scope owns the canvas before
        // the ordinary job-admission call, including an unreceived return.
        try {}
        finally {
            let surface = self.surface(device, frame);
            var clock: Option<FrameClock> = Option<FrameClock>.None();
            var batch: Option<Batch2D> = Option<Batch2D>.None();
            var retained = false;
            try {
                let acquiredClock = surface.frameClock(fps);
                clock = Option<FrameClock>.Some(value: acquiredClock);
                let acquiredBatch = device.batch2D(capacity);
                batch = Option<Batch2D>.Some(value: acquiredBatch);
                let canvas = Canvas2D(
                    view: surface,
                    clock: acquiredClock,
                    batch: acquiredBatch,
                    clear: clear,
                    frames: 0,
                    drawing: false,
                    stopped: false,
                    disposed: false
                );
                let root = self.window.contentView();
                let attached = root.addSubview(surface);
                self.canvases = rinzu.List.append(self.canvases, canvas);
                result = Option<Canvas2D>.Some(value: canvas);
                retained = true;
            }
            finally {
                if !retained {
                    try {
                        switch batch {
                            case Option.None: {}
                            case Option.Some(batchValue): {
                                batchValue.destroy();
                            }
                        }
                    }
                    finally {
                        try {
                            switch clock {
                                case Option.None: {}
                                case Option.Some(clockValue): {
                                    let closed = clockValue.destroy();
                                }
                            }
                        }
                        finally {
                            let removed = surface.destroy();
                        }
                    }
                }
            }
        }
        switch result {
            case Option.Some(created): {
                try {
                    let started = self.start(
                        async fn (job: UiJob) {
                            await canvasLoop(job, created, draw);
                        }
                    );
                }
                catch errors {
                    uiDisposeCanvas(created);
                    switch rinzu.List.get(errors, 0) {
                        case Option.Some(problem): {
                            throw problem;
                        }
                        case Option.None: {
                            throw error(-7803, "macos.canvas.jobAdmission");
                        }
                    }
                }
                return created;
            }
            case Option.None: {
                throw error(-7804, "macos.canvas.creation");
            }
        }
    }

    async fn dispatchActions(self: UiScope, actions: UiActions) {
        await self.dispatch(
            async fn (scope: UiScope, event: UiEvent) {
                actions.handle(scope, event);
            }
        );
    }

    fn label(self: UiScope, title: String, frame: Rect) -> Label {
        return Label(view: scopedWidget(self, 1, title, frame, 0));
    }

    fn button(self: UiScope, title: String, frame: Rect, action: Int) -> Button {
        return Button(view: scopedWidget(self, 2, title, frame, action));
    }

    fn checkbox(self: UiScope, title: String, frame: Rect, action: Int) -> Checkbox {
        return Checkbox(view: scopedWidget(self, 3, title, frame, action));
    }

    fn textField(self: UiScope, title: String, frame: Rect, action: Int) -> TextField {
        return TextField(view: scopedWidget(self, 4, title, frame, action));
    }

    fn textView(self: UiScope, title: String, frame: Rect) -> TextView {
        return TextView(view: scopedWidget(self, 5, title, frame, 0));
    }

    fn scrollView(self: UiScope, frame: Rect) -> ScrollView {
        return ScrollView(view: scopedWidget(self, 6, "", frame, 0));
    }

    fn menu(self: UiScope, title: String) -> Menu {
        if self.control.closed || self.control.stopping {
            throw error(-7803, "UI scope is stopping");
        }
        return self.window.menu(title);
    }
}

fn uiStoreErrors(scope: UiScope, errors: List<Error>) {
    try {
        scope.errors = rinzu.List.concatAll([scope.errors, errors]);
    }
    catch [overflow: rinzu.List.LengthOverflow] {
        scope.errors = [overflow];
        scope.reportedErrors = 0;
    }
}

async fn uiRunJob(scope: UiScope, job: UiTask, work: fn (UiJob) -> Future<Unit>) {
    var settledNormally = false;
    try {
        job.started = true;
        if !scope.control.stopping {
            await work(
                UiJob(session: scope.session, window: scope.window, windowId: scope.windowId, control: scope.control)
            );
        }
        settledNormally = true;
    }
    catch errors {
        uiStoreErrors(scope, errors);
        scope.control.stopping = true;
        try {
            if scope.session.isRunning() {
                let stopped = scope.session.stop();
            }
        }
        catch stopErrors {}
        settledNormally = true;
    }
    finally {
        if !settledNormally {
            scope.control.stopping = true;
            try {
                let stopped = checked(Int(rawRequestStop(scope.session.handle)), "macos.job.control.stop");
            }
            catch stopErrors {}
        }
        try {
            let notified = Int(rawScopeNotify(scope.session.handle, scope.windowId));
        }
        catch notificationErrors {}
        job.done = true;
    }
}

/// Register before spawning. A NoFail watcher and started/done handshake cover
/// cancellation before the caller receives its Future. No native callback owns work.
async fn uiJoinJobs(tasks: List<UiTask>, index: Int) {
    switch rinzu.List.get(tasks, index) {
        case Option.Some(job): {
            try {
                switch job.pending {
                    case Option.Some(pending): {
                        await pending;
                    }
                    case Option.None: {
                        while job.started && !job.done {
                            await rinzu.timer.sleep(1);
                        }
                    }
                }
            }
            finally {
                await uiJoinJobs(tasks, index + 1);
            }
        }
        case Option.None: {}
    }
}

/// Request cooperative stop, join every admitted job, then report the first Error.
fn uiScope(session: Session, window: Window) -> UiScope {
    return UiScope(
        session: session,
        window: window,
        windowId: window.identity(),
        tasks: [],
        canvases: [],
        errors: [],
        reportedErrors: 0,
        control: UiControl(stopping: false, closed: false)
    );
}

fn uiReportErrors(scope: UiScope) -> Int {
    let first = scope.reportedErrors;
    scope.reportedErrors = rinzu.List.length(scope.errors);
    switch rinzu.List.get(scope.errors, first) {
        case Option.Some(problem): {
            throw problem;
        }
        case Option.None: {
            return 0;
        }
    }
}

async fn closeWindowScope(session: Session, token: Int) -> Int {
    var gpuStatus = 0;
    try {}
    finally {
        let prepared = checked(Int(rawWindowScopePrepare(session.handle, token)), "macos.window.scope.prepare");
        while rawWindowScopeHasCommand(session.handle, token) {
            let command = Command(handle: rawWindowScopeCommand(session.handle, token));
            if rawCommandState(command.handle) == 1 {
                let abandoned = checked(Int(rawAbandon(command.handle)), "macos.window.scope.abandon");
            }
            else {
                let status = await waitStatus(command);
                if status < 0 {
                    gpuStatus = status;
                }
            }
        }
        let closed = checked(Int(rawWindowScopeClose(session.handle, token)), "macos.window.scope.close");
    }
    return checked(gpuStatus, "macos.window.scope.gpu");
}

/// A Window scope within the running Application. The application has one event reader.
async fn withWindow(session: Session, title: String, width: Float, height: Float, body: fn (UiScope) -> Future<Unit>)
    -> Int {
    let token = checked(rawWaitToken(), "macos.window.scopeToken");
    try {
        let bytes = utf8Encode(title);
        let window = Window(
            handle: rawWindow(
                checked(
                    rawWindowScoped(session.handle, token, bytes, byteLength(bytes), width, height),
                    "macos.window.scope"
                )
            )
        );
        let scope = uiScope(session, window);
        let shown = window.show();
        try {
            await body(scope);
        }
        finally {
            let settled = await scope.close();
        }
    }
    finally {
        let closed = await closeWindowScope(session, token);
    }
    return 0;
}

async fn uiSignals(scope: UiJob) {
    while !scope.control.stopping {
        if rinzu.shutdown.signalRequested() != 0 {
            scope.control.stopping = true;
            if scope.session.isRunning() {
                let stopped = scope.session.stop();
            }
            return;
        }
        await rinzu.timer.sleep(16);
    }
}

async fn uiObserveOsLoop(scope: UiScope) {
    try {
        let result = await scope.session.runEvents();
    }
    catch errors {
        uiStoreErrors(scope, errors);
        scope.control.stopping = true;
        try {
            let stopped = checked(Int(rawRequestStop(scope.session.handle)), "macos.run.failure.stop");
        }
        catch stopErrors {}
    }
}

async fn stopAndDrain(session: Session) {
    let token = checked(rawWaitToken(), "macos.run.waitToken");
    try {
        let admitted = checked(Int(rawRunWaitBegin(session.handle, token)), "macos.run.wait");
    }
    finally {
        if rawRunWaitOwned(session.handle, token) {
            try {
                let stopped = checked(Int(rawRequestStop(session.handle)), "macos.run.stop");
            }
            finally {
                await nativeCompleted(rawRunCompletion(session.handle, token));
                let finished = checked(Int(rawRunWaitFinish(session.handle, token)), "macos.run.finish");
            }
        }
    }
}

/// Application body context. Each Window keeps its own UiScope.
class UiApplication {
    const session: Session,
    const primary: UiScope
}

async fn uiApplication(
    title: String,
    width: Float,
    height: Float,
    body: fn (UiApplication) -> Future<Unit>,
    signals: Bool
) -> Int {
    try {
        let session = open();
        let token = checked(rawWaitToken(), "macos.application.scopeToken");
        try {
            let bytes = utf8Encode(title);
            let window = Window(
                handle: rawWindow(
                    checked(
                        rawWindowScoped(session.handle, token, bytes, byteLength(bytes), width, height),
                        "macos.application.window"
                    )
                )
            );
            let scope = uiScope(session, window);
            let shown = window.show();
            let running = uiObserveOsLoop(scope);
            try {
                if signals {
                    let watcher = scope.start(uiSignals);
                }
                await body(UiApplication(session: session, primary: scope));
            }
            finally {
                try {
                    let settled = await scope.close();
                }
                finally {
                    try {
                        await stopAndDrain(session);
                    }
                    finally {
                        let finished = await running;
                        let observed = uiReportErrors(scope);
                    }
                }
            }
        }
        finally {
            let closed = await closeWindowScope(session, token);
        }
    }
    finally {
        try {
            if rawHasOwnerSession() {
                await stopAndDrain(Session(handle: rawOwnerSession()));
            }
        }
        finally {
            let ownerClosed = await closeOwnerSessions();
        }
    }
    return 0;
}

/// Own the OS loop, Window, jobs and GPU resources; body runs entirely in Rinzu.
async fn application(title: String, width: Float, height: Float, body: fn (UiApplication) -> Future<Unit>) -> Int {
    return await uiApplication(title, width, height, body, false);
}

/// Opt into cooperative process signals, including rinzu dev cooperative restart.
async fn applicationWithSignals(title: String, width: Float, height: Float, body: fn (UiApplication) -> Future<Unit>)
    -> Int {
    try {
        let enabled = rinzu.shutdown.enableSignals();
        return await uiApplication(title, width, height, body, true);
    }
    finally {
        let disabled = rinzu.shutdown.disableSignals();
    }
}

