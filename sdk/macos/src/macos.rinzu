/// A Source document bound to an existing TextView. The Window owns the native View.
class DocumentBinding {
    const session: Session,
    const input: TextView,
    const document: documents.Document,
    barrier: Int

    fn create(session: Session, input: TextView, document: documents.Document) -> DocumentBinding {
        let result = DocumentBinding(session: session, input: input, document: document, barrier: 0);
        try {}
        finally {
            let written = input.setText(document.text);
            let selected = input.select(document.start, document.end);
            result.barrier = session.eventSequence();
        }
        return result;
    }

    fn capture(self: DocumentBinding) -> Bool {
        if self.input.isComposing() {
            throw error(-7803, "finish text composition before capturing a document");
        }
        let text = self.input.text();
        let selection = self.input.selection();
        let changed = self.document.edit(text, selection.start, selection.end);
        self.barrier = self.session.eventSequence();
        return changed;
    }

    /// Replace the document after a successful load, with fresh history and version.
    fn load(self: DocumentBinding, text: String) -> Bool {
        if utf8ByteLength(text) > 1048576 {
            throw error(-7820, "document.textLimit");
        }
        if !self.document.accepting {
            return false;
        }
        if self.input.isComposing() {
            throw error(-7803, "finish text composition before loading a document");
        }
        var changed = false;
        try {}
        finally {
            try {
                let written = self.input.setText(text);
                let selected = self.input.select(0, 0);
                changed = self.document.reset(text, true);
                self.barrier = self.session.eventSequence();
            }
            finally {
                let reconciled = self.capture();
            }
        }
        return changed;
    }

    fn receive(self: DocumentBinding, event: UiEvent) -> Bool {
        if event.viewId != self.input.identity() || event.sequence <= self.barrier || !self.document.accepting {
            return false;
        }
        if event.kind == eventTextChanged || event.kind == eventSelectionChanged {
            if event.flags == textComposing {
                return false;
            }
            // The event owns its text; never replace the view in response to native input.
            var changed = false;
            try {}
            finally {
                changed = self.document.edit(event.text, event.selectionStart, event.selectionEnd);
                self.barrier = event.sequence;
            }
            return changed;
        }
        return false;
    }

    fn replace(self: DocumentBinding, text: String, start: Int, end: Int) -> Bool {
        if utf8ByteLength(text) > 1048576 || start < 0 || end < start || end > stringLength(text) {
            throw error(-7820, "document.invalidReplacement");
        }
        if !self.document.accepting {
            return false;
        }
        var changed = false;
        // No asynchronous work is started in this synchronous transaction.
        // Cancellation cannot separate native text from the Source save model.
        try {}
        finally {
            let captured = self.capture();
            try {
                let written = self.input.setText(text);
                let selected = self.input.select(start, end);
                changed = self.document.edit(text, start, end);
            }
            finally {
                // Also reconcile a native setter/selection Error before it escapes.
                let reconciled = self.capture();
            }
        }
        return changed;
    }

    fn undoEdit(self: DocumentBinding) -> Bool {
        if !self.document.accepting {
            return false;
        }
        var changed = false;
        try {}
        finally {
            let captured = self.capture();
            switch self.document.undo.peek() {
                case Option.Some(snapshot): {
                    try {
                        let written = self.input.setText(snapshot.text);
                        let selected = self.input.select(snapshot.start, snapshot.end);
                        changed = self.document.undoEdit();
                    }
                    finally {
                        let reconciled = self.capture();
                    }
                }
                case Option.None: {}
            }
        }
        return changed;
    }

    fn redoEdit(self: DocumentBinding) -> Bool {
        if !self.document.accepting {
            return false;
        }
        var changed = false;
        try {}
        finally {
            let captured = self.capture();
            switch self.document.redo.peek() {
                case Option.Some(snapshot): {
                    try {
                        let written = self.input.setText(snapshot.text);
                        let selected = self.input.select(snapshot.start, snapshot.end);
                        changed = self.document.redoEdit();
                    }
                    finally {
                        let reconciled = self.capture();
                    }
                }
                case Option.None: {}
            }
        }
        return changed;
    }

    fn setAccepting(self: DocumentBinding, accepting: Bool) -> Int {
        if !accepting && self.input.isComposing() {
            throw error(-7803, "finish text composition before closing a document");
        }
        try {}
        finally {
            let enabled = self.input.setEnabled(accepting);
            let captured = self.capture();
            self.document.accepting = accepting;
            self.barrier = self.session.eventSequence();
        }
        return 0;
    }
}

