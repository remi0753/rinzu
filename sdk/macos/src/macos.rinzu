async fn sheetReady(window: Window) {
    while checked(Int(rawSheetReady(window.handle)), "macos.sheet.ready") == 0 {
        await rinzu.timer.sleep(1);
    }
}

async fn filePanel(window: Window, save: Bool, title: String, directory: String, name: String) -> Option<String> {
    await sheetReady(window);
    let token = checked(rawWaitToken(), "macos.sheet.token");
    try {
        let heading = utf8Encode(title);
        let folder = utf8Encode(directory);
        let filename = utf8Encode(name);
        var kind = 0;
        if save {
            kind = 1;
        }
        let admitted = checked(
            Int(
                rawPanelBegin(
                    window.handle,
                    token,
                    CInt(kind),
                    heading,
                    byteLength(heading),
                    folder,
                    byteLength(folder),
                    filename,
                    byteLength(filename)
                )
            ),
            "macos.panel.begin"
        );
        await nativeCompleted(rawSheetCompletion(window.handle, token));
        let result = checked(Int(rawSheetResult(window.handle, token)), "macos.panel.result");
        if result == 1 {
            return Option<String>.Some(value: utf8Decode(rawSheetBytes(window.handle, token)));
        }
        return Option<String>.None();
    }
    finally {
        if rawSheetOwned(window.handle, token) {
            try {
                let dismissed = checked(Int(rawSheetCancel(window.handle, token)), "macos.sheet.cancel");
            }
            finally {
                await nativeCompleted(rawSheetCompletion(window.handle, token));
                let finished = checked(Int(rawSheetFinish(window.handle, token)), "macos.sheet.finish");
            }
        }
    }
}

