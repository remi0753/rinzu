native {
    fn rawTestSheetReply(window: WindowHandle, choice: CInt, path: ByteArray, length: CSize)
        -> CInt symbol "rinzu_macos_test_sheet_reply";

    fn rawTestSheetVisible(window: WindowHandle) -> CInt symbol "rinzu_macos_test_sheet_visible";
}

fn testSheetReply(window: Window, choice: Int, path: String) throws(Error) -> Int {
    let bytes = textApi.encodeUtf8(path);
    return checked(
        Int(rawTestSheetReply(window.handle, CInt(choice), bytes, bytesApi.byteLength(bytes))),
        "test.sheet.reply"
    );
}

fn testSheetVisible(window: Window) nothrow -> Bool {
    return rawTestSheetVisible(window.handle) != 0;
}

export testSheetReply;
export testSheetVisible;
