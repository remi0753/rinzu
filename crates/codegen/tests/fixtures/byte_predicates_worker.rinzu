fn check(data: ByteArray, members: ByteArray) -> Bool {
    return bytesContainsAny(data, members)
        && !bytesAllIn(data, members)
        && bytesTrim(data, byteArray(b"\x00\x80")) == byteArray(b"\xff")
        && !bytesContainsAny(byteArray(b""), members)
        && bytesAllIn(data, data);
}

fn trimValue(data: ByteArray) -> ByteArray {
    return bytesTrim(data, byteArray(b"\x00\x80"));
}

async fn main() {
    try {
        let input = byteArray(b"\x00\xff\x80");
        let pending = spawn check(input, byteArray(b"\xff"));
        let trimmed = spawn trimValue(input);
        let workerTrim = await trimmed;
        if !await pending || input != byteArray(b"\x00\xff\x80") || workerTrim != byteArray(b"\xff") {
            panic("failed");
        }
    }
    catch errors {
        panic("unexpectedError");
    }
}
