import rinzu.bytes as bytesApi;
import rinzu.core;

fn check(data: ByteArray, members: ByteArray) -> Bool {
    return bytesApi.containsAny(data, members)
        && !bytesApi.allIn(data, members)
        && bytesApi.trim(data, bytesApi.from(b"\x00\x80")) == bytesApi.from(b"\xff")
        && !bytesApi.containsAny(bytesApi.from(b""), members)
        && bytesApi.allIn(data, data);
}

fn trimValue(data: ByteArray) -> ByteArray {
    return bytesApi.trim(data, bytesApi.from(b"\x00\x80"));
}

async fn main() {
    try {
        let input = bytesApi.from(b"\x00\xff\x80");
        let pending = spawn check(input, bytesApi.from(b"\xff"));
        let trimmed = spawn trimValue(input);
        let workerTrim = await trimmed;
        if !await pending || input != bytesApi.from(b"\x00\xff\x80") || workerTrim != bytesApi.from(b"\xff") {
            rinzu.core.panic("failed");
        }
    }
    catch errors {
        rinzu.core.panic("unexpectedError");
    }
}
