import rinzu.List;
import rinzu.stdio;

error Failed {
    payload: Int
}

async fn fail(value: Int) -> Int {
    throw Failed(message: "failure", payload: value);
}

async fn safe() -> Int {
    return 0;
}

class Cell {
    future: Future<Int>
}

async fn fromCell(cell: Cell) {
    try {
        let value = await cell.future;
    }
    catch errors {}
}

async fn receive(value: Future<Int>) {
    try {
        let result = await value;
    }
    catch [error: Failed] {
        try {
            rinzu.stdio.writeLine(error.payload);
        }
        catch errors {}
    }
    catch errors {}
}

fn overwrite(cells: List<Cell>) {
    var index = 0;
    while index < rinzu.List.length(cells) {
        switch rinzu.List.get(cells, index) {
            case Option.Some(cell): {
                cell.future = safe();
            }
            case Option.None: {}
        }
        index = index + 1;
    }
}

async fn main() {
    var cells: List<Cell> = [];
    var index = 0;
    while index < 2 {
        let pending = fail(317 + index * 2);
        let cell = Cell(future: pending);
        let field = fromCell(cell);
        let data = receive(pending);
        cells = rinzu.List.append(cells, cell);
        index = index + 1;
    }
    overwrite(cells);
}
