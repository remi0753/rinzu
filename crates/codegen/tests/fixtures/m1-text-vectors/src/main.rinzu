import rinzu.list;
import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.error as err;
import rinzu.number as num;
import rinzu.string as textApi;

fn requiredErrorCode(problem: Error) nothrow -> Int {
    switch err.code(problem) {
        case Option.Some(value): {
            return value;
        }
        case Option.None: {
            rinzu.core.panic("expected a numeric error code");
            return 0;
        }
    }
}

fn require(condition: Bool) {
    if !condition {
        rinzu.core.panic("failed");
    }
}

fn code<T>(operation: fn () -> T) -> Int {
    try {
        let value = operation();
        return 0;
    }
    catch [problem: Error, ...rest] {
        require(rinzu.list.length(rest) == 0);
        return requiredErrorCode(problem);
    }
}

fn echo(value: String) -> String {
    return value;
}

fn emptyList() -> List<String> {
    return [];
}

fn cases0() {
    require(textApi.length("") == 0);
    require(textApi.utf8ByteLength("") == CSize(0));
    require(textApi.get("", -1) == Option<String>.None());
    require(textApi.find("", "", -1) == Option<Int>.None());
    require(textApi.slice("", -1, -1) == Option<String>.None());
    require(textApi.slice("", -1, 0) == Option<String>.None());
    require(textApi.slice("", -1, 1) == Option<String>.None());
    require(textApi.get("", 0) == Option<String>.None());
    require(textApi.find("", "", 0) == Option<Int>.Some(value: 0));
    require(textApi.slice("", 0, -1) == Option<String>.None());
    require(textApi.slice("", 0, 0) == Option<String>.Some(value: ""));
    require(textApi.slice("", 0, 1) == Option<String>.None());
    require(textApi.get("", 1) == Option<String>.None());
    require(textApi.find("", "", 1) == Option<Int>.None());
    require(textApi.slice("", 1, -1) == Option<String>.None());
    require(textApi.slice("", 1, 0) == Option<String>.None());
    require(textApi.slice("", 1, 1) == Option<String>.None());
    require(
        code<String>(
            fn () -> String {
                return textApi.decodeUtf8(textApi.encodeUtf8(""));
            }
        ) == 0
    );
    require(textApi.length("\u{0}") == 1);
    require(textApi.utf8ByteLength("\u{0}") == CSize(1));
}

