fn cases11() {
    require(textApi.find("日a", "a", 9223372036854775807) == Option<Int>.None());
    require(textApi.split("", "x") == [""]);
    require(textApi.split("", "") == emptyList());
    require(textApi.split("日é\u{0}", "") == ["日", "e", "́", "\u{0}"]);
    require(textApi.split("a,,b,", ",") == ["a", "", "b", ""]);
    require(textApi.split(",a", ",") == ["", "a"]);
    require(textApi.split("aaaaa", "aa") == ["", "", "a"]);
    require(textApi.split("a\u{0}b\u{0}", "\u{0}") == ["a", "b", ""]);
    try {
