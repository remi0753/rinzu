class Layer {
    const apply: fn (Int) -> Int
}

class AsyncLayer {
    const apply: fn (Int) -> Future<Int>
}

fn invoke(layer: Layer) -> Int {
    return layer.apply(42);
}

fn invokeAsync(layer: AsyncLayer) -> Future<Int> {
    return layer.apply(42);
}

async fn main() {
    let layers: List<Layer> = [];
    switch listGet(layers, 0) {
        case Option.Some(layer): {
            let value = invoke(layer);
        }
        case Option.None: {}
    }
    let asynchronous: List<AsyncLayer> = [];
    switch listGet(asynchronous, 0) {
        case Option.Some(asyncLayer): {
            try {
                let asyncValue = await invokeAsync(asyncLayer);
            }
            catch errors {
                panic("unexpected");
            }
        }
        case Option.None: {}
    }
}
