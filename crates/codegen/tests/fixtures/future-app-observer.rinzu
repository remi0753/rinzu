import rinzu.list;
import rinzu.stdio;
import rinzu.core;

error Failed {
    payload: String
}

class State {
    done: Bool,
    errors: List<List<Error>>
}

async fn failing() {
    throw Failed(message: "failure", payload: "retained payload");
}

async fn observe(state: State, pending: Future<Unit>) {
    try {
        await pending;
    }
    catch errors {
        try {
            state.errors = rinzu.list.append(state.errors, errors);
        }
        catch [overflow: rinzu.list.LengthOverflow] {
            state.errors = [[overflow]];
        }
        state.done = true;
    }
}

async fn turn() {}

async fn main() {
    try {
        let state = State(done: false, errors: []);
        let settled = observe(state, failing());
        while !state.done {
            await turn();
        }
        await settled;
        switch rinzu.list.get(state.errors, 0) {
            case Option.Some(group): {
                switch rinzu.list.get(group, 0) {
                    case Option.Some(problem): {
                        if problem is Failed {
                            rinzu.stdio.writeLine(problem.payload);
                        }
                        else {
                            rinzu.core.panic("failed");
                        }
                    }
                    case Option.None: {
                        rinzu.core.panic("failed");
                    }
                }
            }
            case Option.None: {
                rinzu.core.panic("failed");
            }
        }
    }
    catch errors {
        rinzu.core.panic("failed");
    }
}
