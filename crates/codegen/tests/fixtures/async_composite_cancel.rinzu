async fn cancellable(value: Packet) -> Packet {
    let first = spawn work(10);
    let received = await first;
    try {
        while true {
            churn();
        }
    }
    finally {
        if value.text != "日本語\u{0}retained" || value.bytes != b"A\xff\x00\x00" {
            panic("bad_cleanup_root");
        }
        let cleanup_error = CInt8(200);
    }
    return value;
}

async fn main() {
    let kept = make("日本語\u{0}retained");
    let child = cancellable(kept);
    try {
        let impossible = await child;
    }
    finally {
        if kept.high != 18446744073709551615 || kept.bytes != b"A\xff\x00\x00" {
            panic("bad_parent_root");
        }
        let parent_cleanup_error = CInt8(201);
    }
}
