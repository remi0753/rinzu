import rinzu.list;
import rinzu.stdio;

error Failed {
    payload: Int
}

async fn fail(number: Int) -> Int {
    throw Failed(message: "failed", payload: number);
}

fn build(count: Int) -> List<Future<Int>> {
    var values: List<Future<Int>> = [];
    var index = 0;
    while index < count {
        values = rinzu.list.append(values, fail(index));
        index = index + 1;
    }
    return values;
}

async fn observe(value: Future<Int>) {
    try {
        let result = await value;
    }
    catch [error: Failed] {
        try {
            rinzu.stdio.writeLine(error.payload);
        }
        catch outputErrors {}
    }
    catch errors {}
}

async fn observeList(values: List<Future<Int>>) {
    var index = 0;
    while index < rinzu.list.length(values) {
        switch rinzu.list.get(values, index) {
            case Option.Some(value): {
                let observer = observe(value);
            }
            case Option.None: {}
        }
        index = index + 1;
    }
}

async fn main() {
    let values = build(3);
    let observer = observeList(values);
    let next = observeList(build(2));
    let empty = observeList(build(0));
    switch rinzu.list.get(values, 1) {
        case Option.Some(value): {
            try {
                let result = await value;
            }
            catch [error: Failed] {
                try {
                    rinzu.stdio.writeLine(error.payload);
                }
                catch outputErrors {}
            }
            catch errors {}
        }
        case Option.None: {}
    }
}
