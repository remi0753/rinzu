fn cancellable(value: Packet) -> Packet {
    try {
        while true {
            churn();
        }
    }
    finally {
        if value.text != "日本語\u{0}🙂" || bytesApi.byteLength(value.bytes) != 4 || value.high != 18446744073709551615 {
            rinzu.core.panic("lost_worker_root");
        }
        try {
            let worker_cleanup = CInt8(301);
        }
        catch errors {}
    }
    return value;
}

async fn main() {
    try {
        let original = make(0.0);
        try {
            let waiting = spawn cancellable(original);
            let copy = await waiting;
        }
        finally {
            if original.text != "日本語\u{0}🙂" || original.bytes != b"A\xff\x00\x00" {
                rinzu.core.panic("lost_origin_root");
            }
            let origin_cleanup = CInt8(401);
        }
    }
    catch unexpectedErrors {
        rinzu.core.panic("unexpectedFailure");
    }
}
