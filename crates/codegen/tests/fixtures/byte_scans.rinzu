import rinzu.bytes as bytesApi;
import rinzu.core;

fn equal(actual: Int, expected: Int) {
    if actual != expected {
        rinzu.core.panic("failed");
    }
}

fn found(value: Option<Int>, expected: Int) {
    switch value {
        case Option.Some(index): {
            equal(index, expected);
        }
        case Option.None: {
            equal(-1, expected);
        }
    }
}

class Counter {
    value: Int
}

fn argument(counter: Counter, expected: Int, data: ByteArray) -> ByteArray {
    equal(counter.value, expected);
    counter.value = counter.value + 1;
    return data;
}

fn start(counter: Counter) -> Int {
    equal(counter.value, 2);
    counter.value = 3;
    return 0;
}

fn checks() {
    let data = bytesApi.from(b"\x00AZaZ\xff\x80\r\n");
    let original = data;
    let lower = bytesApi.lowerAscii(data);
    if lower != bytesApi.from(b"\x00azaz\xff\x80\r\n") || original != data || data == lower {
        rinzu.core.panic("invalidCase");
    }
    found(bytesApi.findAny(data, bytesApi.from(b"Z"), 0), 2);
    found(bytesApi.findAny(data, bytesApi.from(b"Z"), 3), 4);
    found(bytesApi.findAny(data, bytesApi.from(b"\x00\xff"), 1), 5);
    found(bytesApi.findAny(data, bytesApi.from(b"\x80"), 6), 6);
    found(bytesApi.findAny(data, bytesApi.from(b""), 0), -1);
    found(bytesApi.findAny(data, bytesApi.from(b"\x00"), -1), -1);
    found(bytesApi.findAny(data, data, 9), -1);
    found(bytesApi.findAny(data, data, 9223372036854775807), -1);
    found(bytesApi.findNotAny(data, bytesApi.from(b"AZaZ\x00"), 0), 5);
    found(bytesApi.findNotAny(data, data, 0), -1);
    found(bytesApi.findNotAny(data, bytesApi.from(b""), 4), 4);
    found(bytesApi.findNotAny(data, bytesApi.from(b""), 9), -1);
    found(bytesApi.findNotAny(data, bytesApi.from(b""), -1), -1);
    var index = 0;
    while index < 256 {
        let one = bytesApi.from([CUInt8(index)]);
        if !bytesApi.containsAny(one, one)
            || !bytesApi.allIn(one, one)
            || bytesApi.containsAny(one, bytesApi.from(b""))
            || bytesApi.allIn(one, bytesApi.from(b"")) {
            rinzu.core.panic("badPredicate");
        }
        if bytesApi.trim(one, one) != bytesApi.from(b"") || bytesApi.trim(one, bytesApi.from(b"")) != one {
            rinzu.core.panic("badTrim");
        }
        found(bytesApi.findAny(one, one, 0), 0);
        found(bytesApi.findNotAny(one, one, 0), -1);
        switch bytesApi.get(bytesApi.lowerAscii(one), 0) {
            case Option.Some(byte): {
                if index >= 65 && index <= 90 {
                    equal(Int(byte), index + 32);
                }
                else {
                    equal(Int(byte), index);
                }
            }
            case Option.None: {
                rinzu.core.panic("missingByte");
            }
        }
        index = index + 1;
    }
    if bytesApi.containsAny(bytesApi.from(b""), data)
        || !bytesApi.allIn(bytesApi.from(b""), data)
        || !bytesApi.containsAny(data, bytesApi.from(b"\xff"))
        || bytesApi.allIn(data, bytesApi.from(b"AZ")) {
        rinzu.core.panic("invalidPredicate");
    }
    let predicateCounter = Counter(value: 0);
    if !bytesApi.allIn(argument(predicateCounter, 0, data), argument(predicateCounter, 1, data)) {
        rinzu.core.panic("missingPredicate");
    }
    equal(predicateCounter.value, 2);
    if bytesApi.trim(bytesApi.from(b" \tA\x00\xff\t "), bytesApi.from(b" \t")) != bytesApi.from(b"A\x00\xff")
        || bytesApi.trim(data, bytesApi.from(b"")) != data
        || bytesApi.trim(bytesApi.from(b"\x00\xff\x00"), bytesApi.from(b"\x00\xff")) != bytesApi.from(b"")
        || bytesApi.trim(bytesApi.from(b""), data) != bytesApi.from(b"") {
        rinzu.core.panic("invalidTrim");
    }
    let longEdges = bytesApi.concat(
        bytesApi.from(b"                                \t"),
        bytesApi.concat(data, bytesApi.from(b"\t                                "))
    );
    if bytesApi.trim(longEdges, bytesApi.from(b" \t")) != data {
        rinzu.core.panic("invalidWordTrim");
    }
    let trimCounter = Counter(value: 0);
    if bytesApi.trim(argument(trimCounter, 0, data), argument(trimCounter, 1, data)) != bytesApi.from(b"") {
        rinzu.core.panic("missingTrim");
    }
    equal(trimCounter.value, 2);
    let counter = Counter(value: 0);
    found(bytesApi.findAny(argument(counter, 0, data), argument(counter, 1, data), start(counter)), 0);
    equal(counter.value, 3);
    found(bytesApi.findAny(bytesApi.from(b""), data, 0), -1);
    found(bytesApi.findNotAny(bytesApi.from(b""), data, 0), -1);
    if bytesApi.lowerAscii(bytesApi.from(b"")) != bytesApi.from(b"") {
        rinzu.core.panic("invalidEmpty");
    }
}

fn main() {
    try {
        checks();
    }
    catch errors {
        rinzu.core.panic("unexpectedError");
    }
}
