import rinzu.core;

let width = 2 + 2;

fn raw() -> Bytes(2) {
    return b"A\xff";
}

fn four(value: Bytes(width)) -> CSize {
    var iteration = 0;
    while iteration < 20 {
        let temporary: List<Bytes(4)> = [value];
        iteration = iteration + 1;
    }
    if value != b"A\xff\x00\x00" {
        panic("bad_argument");
    }
    return 40;
}

fn apply(measure: fn (Bytes(4)) -> CSize, value: Bytes(4)) -> CSize {
    return measure(value);
}

fn invalid(value: Bytes(4)) -> CSize {
    let converted = CInt8(200);
    return byteLength(value);
}

fn verify() -> Int {
    let original = raw();
    let measure: fn (Bytes(width)) -> CUInt64 = rinzu.core.byteLength;
    let alias = measure;
    if alias(original) != 4 || apply(alias, original) != 4 || apply(four, original) != 40 {
        panic("bad_reference");
    }
    if original != b"A\xff" {
        panic("changed_argument");
    }
    var selection: fn (Bytes(4)) -> CSize = byteLength;
    if selection(original) != 4 {
        panic("bad_initial_target");
    }
    selection = four;
    if selection(original) != 40 {
        panic("bad_selected_target");
    }
    let zero: fn (Bytes(0)) -> CSize = byteLength;
    if zero(b"") != 0 {
        panic("bad_zero");
    }
    let text = utf8ByteLength;
    let imported = rinzu.core.utf8ByteLength;
    try {
        if text("日本語\u{0}🙂") != 14 || imported("a\u{0}b") != 3 {
            panic("bad_text");
        }
    }
    catch errors {
        return 0;
    }
    var caught = 0;
    let failing = invalid;
    try {
        let result = failing(original);
    }
    catch [error: Error, ...errorRest] {
        caught = 1;
        let message = error.message;
    }
    if caught != 1 {
        panic("missing_error");
    }
    // The failing argument runs once, before the indirect target is entered.
    var argument_caught = 0;
    try {
        let skipped = alias(raw_failure());
    }
    catch argument_error {
        argument_caught = 1;
    }
    if argument_caught != 1 {
        panic("bad_evaluation");
    }
    return 42;
}

fn raw_failure() -> Bytes(2) {
    let failure = CInt8(201);
    return b"A\xff";
}

fn main() {
    if verify() != 42 {
        panic("bad_result");
    }
}
