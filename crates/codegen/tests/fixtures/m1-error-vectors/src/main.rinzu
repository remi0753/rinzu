import rinzu.list;
import rinzu.stdio;

async fn failCleanup() -> Int {
    try {
        let failed = CInt8(128);
    }
    finally {
        let cleanupFailed = CInt8(129);
    }
    return 0;
}

fn showStatus(status: Int) {
    try {
        let resultValue3 = nativeStatus(status, "native domain");
        rinzu.stdio.writeLine(resultValue3);
    }
    catch [resultError3: Error, ...resultRest3] {
        rinzu.stdio.writeLine(errorNativeStatus(resultError3));
    }
}

async fn main() {
    try {
        var chain = error(1000, "root");
        var count = 1;
        while count < 64 {
            try {
                let resultValue2 = errorWithCause(error(1001, "wrap"), chain);
                chain = resultValue2;
            }
            catch [resultError2: Error, ...resultRest2] {
                rinzu.stdio.writeLine(errorCode(resultError2));
            }
            count = count + 1;
        }
        try {
            let resultValue1 = errorWithCause(error(1002, "limit"), chain);
            rinzu.stdio.writeLine(false);
        }
        catch [resultError1: Error, ...resultRest1] {
            rinzu.stdio.writeLine(errorCode(resultError1));
        }
        rinzu.stdio.writeLine(errorMessage(errorWithContext(error(1200, "日本語\u{0}tail"), "context")));
        rinzu.stdio.writeLine(errorCode(chain));
        rinzu.stdio.writeLine(errorCause(error(1000, "no cause")));
        showStatus(0);
        showStatus(-9223372036854775808);
        showStatus(9223372036854775807);
        try {
            let pending = failCleanup();
            let result = await pending;
        }
        catch [primary: Error, ...primaryRest] {
            rinzu.stdio.writeLine(errorCode(primary));
            let cleanup = primaryRest;
            rinzu.stdio.writeLine(rinzu.list.length(cleanup));
            switch rinzu.list.get(cleanup, 0) {
                case Option.Some(extra): {
                    rinzu.stdio.writeLine(errorCode(extra));
                    switch errorSourceStart(extra) {
                        case Option.Some(start): {
                            rinzu.stdio.writeLine(start >= 0);
                        }
                        case Option.None: {
                            rinzu.stdio.writeLine(false);
                        }
                    }
                }
                case Option.None: {}
            }
        }
        finally {
            rinzu.stdio.writeLine("origin cleanup");
        }
    }
    catch unexpectedEntryErrors {
        panic("unexpectedEntryFailure");
    }
}
