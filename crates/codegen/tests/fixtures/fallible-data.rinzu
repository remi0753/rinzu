import rinzu.list;
import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.error as err;
import rinzu.native as bridge;
import rinzu.number as num;
import rinzu.string as textApi;

fn addErrorCause(problem: Error, cause: Error) -> Error {
    switch err.withCause(problem, cause) {
        case Option.Some(value): {
            return value;
        }
        case Option.None: {
            return problem;
        }
    }
}

fn requiredErrorCode(problem: Error) nothrow -> Int {
    switch err.code(problem) {
        case Option.Some(value): {
            return value;
        }
        case Option.None: {
            rinzu.core.panic("expected a numeric error code");
            return 0;
        }
    }
}

async fn main() {
    try {
        rinzu.stdio.writeLine(num.parseInt("42"));
        rinzu.stdio.writeLine(textApi.decodeUtf8(bytesApi.from(b"hello")));
        rinzu.stdio.writeLine(num.checkedAdd(20, 22));
        rinzu.stdio.writeLine(num.checkedSub(44, 2));
        rinzu.stdio.writeLine(num.checkedMul(6, 7));
        rinzu.stdio.writeLine(num.shiftLeft(21, 1));
        rinzu.stdio.writeLine(num.shiftRight(84, 1));
        rinzu.stdio.writeLine(bridge.checkStatus(0, "success"));
        let enriched = addErrorCause(err.create(1, "outer"), err.create(2, "inner"));
        rinzu.stdio.writeLine(requiredErrorCode(enriched));
        try {
            let invalidNumber = num.parseInt("x");
        }
        catch [numberError: Error] {
            rinzu.stdio.writeLine(requiredErrorCode(numberError));
        }
        try {
            let overflowNumber = num.parseInt("9223372036854775808");
        }
        catch [overflowError: Error] {
            rinzu.stdio.writeLine(requiredErrorCode(overflowError));
        }
        try {
            let invalidText = textApi.decodeUtf8(bytesApi.from(b"\xff"));
        }
        catch [textError: Error] {
            rinzu.stdio.writeLine(requiredErrorCode(textError));
        }
        try {
            let invalidShift = num.shiftLeft(1, 64);
        }
        catch [shiftError: Error] {
            rinzu.stdio.writeLine(requiredErrorCode(shiftError));
        }
        try {
            let overflowAdd = num.checkedAdd(9223372036854775807, 1);
        }
        catch [addError: Error] {
            rinzu.stdio.writeLine(requiredErrorCode(addError));
        }
        try {
            let overflowSub = num.checkedSub(-9223372036854775807, 2);
        }
        catch [subError: Error] {
            rinzu.stdio.writeLine(requiredErrorCode(subError));
        }
        try {
            let overflowMul = num.checkedMul(9223372036854775807, 2);
        }
        catch [mulError: Error] {
            rinzu.stdio.writeLine(requiredErrorCode(mulError));
        }
        try {
            let failedNative = bridge.checkStatus(-7, "native failure");
        }
        catch [nativeError: Error] {
            rinzu.stdio.writeLine(requiredErrorCode(nativeError));
            switch err.nativeStatus(nativeError) {
                case Option.Some(status): {
                    rinzu.stdio.writeLine(status);
                }
                case Option.None: {}
            }
        }
        var chain = err.create(3, "first");
        var count = 1;
        while count < 64 {
            chain = addErrorCause(err.create(4, "outer"), chain);
            count = count + 1;
        }
        try {
            let tooDeep = addErrorCause(err.create(5, "overflow"), chain);
        }
        catch [causeError: Error] {
            rinzu.stdio.writeLine(requiredErrorCode(causeError));
        }
        try all {
            let a = num.parseInt("bad");
            let b = textApi.decodeUtf8(bytesApi.from(b"\xff"));
        }
        catch errors {
            rinzu.stdio.writeLine(rinzu.list.length(errors));
        }
    }
    catch errors {
        rinzu.core.panic("unexpected");
    }
}
