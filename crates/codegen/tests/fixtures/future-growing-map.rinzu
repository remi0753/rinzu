import rinzu.list;
import rinzu.map;
import rinzu.stdio;

error Failed {
    payload: Int
}

async fn fail(number: Int) -> Int {
    throw Failed(message: "failed", payload: number);
}

fn build(count: Int) -> Map<Int, Future<Int>> {
    var values: Map<Int, Future<Int>> = {};
    var index = 0;
    while index < count {
        values = rinzu.map.insert(values, index, fail(index));
        index = index + 1;
    }
    return values;
}

async fn observe(value: Future<Int>) {
    try {
        let result = await value;
    }
    catch [error: Failed] {
        try {
            rinzu.stdio.writeLine(error.payload);
        }
        catch outputErrors {}
    }
    catch errors {}
}

async fn observeMap(values: Map<Int, Future<Int>>) {
    let keys = rinzu.map.keys(values);
    var index = 0;
    while index < rinzu.list.length(keys) {
        switch rinzu.list.get(keys, index) {
            case Option.Some(key): {
                switch rinzu.map.get(values, key) {
                    case Option.Some(value): {
                        let observer = observe(value);
                    }
                    case Option.None: {}
                }
            }
            case Option.None: {}
        }
        index = index + 1;
    }
}

async fn main() {
    let values = build(3);
    let observer = observeMap(values);
    let next = observeMap(build(2));
    let empty = observeMap(build(0));
    switch rinzu.map.get(values, 1) {
        case Option.Some(value): {
            try {
                let result = await value;
            }
            catch [error: Failed] {
                try {
                    rinzu.stdio.writeLine(error.payload);
                }
                catch outputErrors {}
            }
            catch errors {}
        }
        case Option.None: {}
    }
}
