import rinzu.map;
import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;

enum Tag {
    Empty,
    Flag(value: Bool),
    Packet(value: ByteArray)
}

class Inner {
    const flag: Bool,
    const bytes: ByteArray
}

class Key<T> {
    const inner: Inner,
    const fixed: Bytes(4),
    const tag: Tag,
    const value: T
}

class Empty {}

fn require(condition: Bool) {
    if !condition {
        rinzu.core.panic("failed");
    }
}

fn same<T: Key + Equality + Transferable>(left: T, right: T) -> Bool {
    return left == right;
}

fn echo<T: Transferable>(value: T) -> T {
    return value;
}

async fn main() {
    try {
        let flags: Map<CBool, String> = {
            false: "first", true: "second", false: "last"
        };
        require(rinzu.map.length(flags) == 2 && rinzu.map.keys(flags) == [false, true]);
        require(rinzu.map.get(flags, false) == Option<String>.Some(value: "last"));
        let changedFlags = rinzu.map.insert(flags, true, "updated");
        require(rinzu.map.get(flags, true) == Option<String>.Some(value: "second"));
        require(rinzu.map.keys(rinzu.map.insert(rinzu.map.remove(flags, false), false, "again")) == [true, false]);
        let first: Bytes(4) = b"A";
        let second: Bytes(4) = b"AB";
        let fixed: Map<Bytes(4), Int> = {
            first: 1, second: 2, b"A\x00\x00\x00": 3
        };
        require(rinzu.map.length(fixed) == 2 && rinzu.map.keys(fixed) == [first, second]);
        require(rinzu.map.get(fixed, first) == Option<Int>.Some(value: 3));
        let invalid: List<CUInt8> = [0, 255, 128];
        let data = bytesApi.from(invalid);
        let empty = bytesApi.from(b"");
        let binary: Map<ByteArray, Int> = {
            empty: 0, data: 1, bytesApi.copy(data): 2
        };
        require(rinzu.map.keys(binary) == [empty, data] && rinzu.map.length(binary) == 2);
        require(rinzu.map.get(binary, bytesApi.copy(data)) == Option<Int>.Some(value: 2));
        require(rinzu.map.get(binary, bytesApi.from(b"missing")) == Option<Int>.None());
        let original = Key<Int>(
            inner: Inner(flag: true, bytes: data),
            fixed: first,
            tag: Tag.Packet(value: data),
            value: 1
        );
        let copy = Key<Int>(
            inner: Inner(flag: true, bytes: bytesApi.copy(data)),
            fixed: b"A",
            tag: Tag.Packet(value: bytesApi.copy(data)),
            value: 1
        );
        let changed = Key<Int>(inner: original.inner, fixed: original.fixed, tag: original.tag, value: 2);
        let changedChild = Key<Int>(
            inner: Inner(flag: false, bytes: original.inner.bytes),
            fixed: original.fixed,
            tag: original.tag,
            value: original.value
        );
        require(same<Key<Int>>(original, copy));
        require(same<Bool>(true, true) && same<ByteArray>(data, bytesApi.copy(data)));
        let records: Map<Key<Int>, String> = {
            original: "old", changed: "changed", copy: "last", changedChild: "child"
        };
        require(rinzu.map.length(records) == 3 && rinzu.map.keys(records) == [original, changed, changedChild]);
        require(rinzu.map.get(records, copy) == Option<String>.Some(value: "last"));
        require(rinzu.map.get(records, changed) == Option<String>.Some(value: "changed"));
        require(rinzu.map.get(records, changedChild) == Option<String>.Some(value: "child"));
        require(original.value == 1 && original.inner.flag);
        let tags: Map<Tag, Int> = {
            Tag.Empty(): 1, Tag.Flag(value: false): 2, Tag.Flag(value: true): 3
        };
        require(
            rinzu.map.length(tags) == 3 && rinzu.map.get(tags, Tag.Flag(value: true)) == Option<Int>.Some(value: 3)
        );
        let zero: Map<Bytes(0), Int> = {
            b"": 1, b"": 2
        };
        let emptyRecords: Map<Empty, Int> = {
            Empty(): 1, Empty(): 2
        };
        require(rinzu.map.length(zero) == 1 && rinzu.map.get(zero, b"") == Option<Int>.Some(value: 2));
        require(
            rinzu.map.length(emptyRecords) == 1 && rinzu.map.get(emptyRecords, Empty()) == Option<Int>.Some(value: 2)
        );
        var many: Map<ByteArray, Int> = {};
        var index = 0;
        while index < 64 {
            let one: List<CUInt8> = [CUInt8(index)];
            many = rinzu.map.insert(many, bytesApi.from(one), index);
            index = index + 1;
        }
        index = 0;
        while index < 64 {
            let query: List<CUInt8> = [CUInt8(index)];
            require(rinzu.map.get(many, bytesApi.from(query)) == Option<Int>.Some(value: index));
            index = index + 1;
        }
        let flagFuture = spawn echo<Map<Bool, String>>(changedFlags);
        let fixedFuture = spawn echo<Map<Bytes(4), Int>>(fixed);
        let binaryFuture = spawn echo<Map<ByteArray, Int>>(binary);
        let recordFuture = spawn echo<Map<Key<Int>, String>>(records);
        let later = rinzu.map.insert(records, original, "later");
        let copiedFlags = await flagFuture;
        let copiedFixed = await fixedFuture;
        let copiedBinary = await binaryFuture;
        let copiedRecords = await recordFuture;
        require(
            copiedFlags == changedFlags && copiedFixed == fixed && copiedBinary == binary && copiedRecords == records
        );
        require(rinzu.map.get(copiedRecords, copy) == Option<String>.Some(value: "last"));
        require(rinzu.map.get(later, original) == Option<String>.Some(value: "later"));
        require(rinzu.map.keys(copiedRecords) == rinzu.map.keys(records));
        rinzu.stdio.writeLine("keys ok");
    }
    catch errors {}
}
