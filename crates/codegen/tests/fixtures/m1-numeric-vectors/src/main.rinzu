fn floats() {
    require(mathSqrt(CFloat(2.0)) == CFloat(1.4142135381698608));
    require(mathSqrt(2.0) == 1.4142135623730951);
    require(mathAbs(CFloat(-16777217.0)) == CFloat(16777216.0));
    require(floatIsNan(mathSqrt(CFloat(-1.0))));
    require(floatIsNan(mathAbs(mathSqrt(-1.0))));
    require(!floatIsNan(mathSqrt(CDouble(4.0))));
    require(1.0 / mathAbs(-0.0) > 0.0);
    require(CFloat(1.0) / mathAbs(CFloat(-0.0)) > CFloat(0.0));
    let infinity = 1.0 / 0.0;
    require(mathSqrt(infinity) == infinity);
    let small: CFloat = 0.0;
    require(mathSqrt(small) == small);
}

