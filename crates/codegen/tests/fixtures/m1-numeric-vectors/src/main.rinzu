import rinzu.List;
import rinzu.stdio;

fn require(condition: Bool) {
    if !condition {
        panic("failed");
    }
}

fn ok<T: Equality>(value: T, expected: T) {
    require(value == expected);
}

fn width0() {
    let low: CInt8 = -128;
    let high: CInt8 = 127;
    let zero: CInt8 = 0;
    let one: CInt8 = 1;
    let two: CInt8 = 2;
    require(wrappingAdd(high, one) == low);
    require(wrappingSub(low, one) == high);
    require(wrappingMul(high, two) == CInt8(-2));
    require(bitNot(zero) == wrappingSub(zero, one));
    require(bitXor(high, high) == zero);
    require(bitAnd(high, zero) == zero);
    require(bitOr(high, zero) == high);
    ok<CInt8>(checkedAdd(low, zero), low);
    ok<CInt8>(checkedMul(low, zero), zero);
    try {
        let unexpected1 = checkedAdd(high, one);
        require(false);
    }
    catch [problem1: Error, ...rest1] {
        require(errorCode(problem1) == 300);
        require(rinzu.List.length(rest1) == 0);
    }
    try {
        let unexpected2 = checkedSub(low, one);
        require(false);
    }
    catch [problem2: Error, ...rest2] {
        require(errorCode(problem2) == 300);
        require(rinzu.List.length(rest2) == 0);
    }
    try {
        let unexpected3 = checkedMul(high, two);
        require(false);
    }
    catch [problem3: Error, ...rest3] {
        require(errorCode(problem3) == 300);
        require(rinzu.List.length(rest3) == 0);
    }
    ok<CInt8>(shiftLeft(one, 0), one);
    ok<CInt8>(shiftRight(high, 0), high);
    ok<CInt8>(shiftLeft(one, 7), CInt8(-128));
    ok<CInt8>(shiftRight(low, 7), CInt8(-1));
    try {
        let unexpected4 = shiftLeft(one, -1);
        require(false);
    }
    catch [problem4: Error, ...rest4] {
        require(errorCode(problem4) == 301);
        require(rinzu.List.length(rest4) == 0);
    }
    try {
        let unexpected5 = shiftRight(one, -1);
        require(false);
    }
    catch [problem5: Error, ...rest5] {
        require(errorCode(problem5) == 301);
        require(rinzu.List.length(rest5) == 0);
    }
    try {
        let unexpected6 = shiftLeft(one, 8);
        require(false);
    }
    catch [problem6: Error, ...rest6] {
        require(errorCode(problem6) == 301);
        require(rinzu.List.length(rest6) == 0);
    }
    try {
        let unexpected7 = shiftRight(one, 8);
        require(false);
    }
    catch [problem7: Error, ...rest7] {
        require(errorCode(problem7) == 301);
        require(rinzu.List.length(rest7) == 0);
    }
    try {
        let unexpected8 = shiftLeft(one, 9);
        require(false);
    }
    catch [problem8: Error, ...rest8] {
        require(errorCode(problem8) == 301);
        require(rinzu.List.length(rest8) == 0);
    }
    try {
        let unexpected9 = shiftRight(one, 9);
        require(false);
    }
    catch [problem9: Error, ...rest9] {
        require(errorCode(problem9) == 301);
        require(rinzu.List.length(rest9) == 0);
    }
    try {
        let unexpected10 = shiftLeft(one, 9223372036854775807);
        require(false);
    }
    catch [problem10: Error, ...rest10] {
        require(errorCode(problem10) == 301);
        require(rinzu.List.length(rest10) == 0);
    }
    try {
        let unexpected11 = shiftRight(one, 9223372036854775807);
        require(false);
    }
    catch [problem11: Error, ...rest11] {
        require(errorCode(problem11) == 301);
        require(rinzu.List.length(rest11) == 0);
    }
    try {
        let unexpected12 = shiftLeft(one, -9223372036854775808);
        require(false);
    }
    catch [problem12: Error, ...rest12] {
        require(errorCode(problem12) == 301);
        require(rinzu.List.length(rest12) == 0);
    }
    try {
        let unexpected13 = shiftRight(one, -9223372036854775808);
        require(false);
    }
    catch [problem13: Error, ...rest13] {
        require(errorCode(problem13) == 301);
