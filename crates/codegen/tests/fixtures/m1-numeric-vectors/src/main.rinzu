fn floats() {
    require(num.sqrt(CFloat(2.0)) == CFloat(1.4142135381698608));
    require(num.sqrt(2.0) == 1.4142135623730951);
    require(num.abs(CFloat(-16777217.0)) == CFloat(16777216.0));
    require(num.isNaN(num.sqrt(CFloat(-1.0))));
    require(num.isNaN(num.abs(num.sqrt(-1.0))));
    require(!num.isNaN(num.sqrt(CDouble(4.0))));
    require(1.0 / num.abs(-0.0) > 0.0);
    require(CFloat(1.0) / num.abs(CFloat(-0.0)) > CFloat(0.0));
    let infinity = 1.0 / 0.0;
    require(num.sqrt(infinity) == infinity);
    let small: CFloat = 0.0;
    require(num.sqrt(small) == small);
}

fn main() {
    try {
        width0();
        width1();
        width2();
        width3();
        width4();
        width5();
        width6();
        width7();
        width8();
        width9();
        width10();
        width11();
        floats();
        rinzu.stdio.writeLine("numeric vectors ok");
    }
    catch unexpectedEntryErrors {
        rinzu.core.panic("unexpectedEntryFailure");
    }
}
