import rinzu.list;
import rinzu.stdio;
import rinzu.core;
import rinzu.error as err;
import rinzu.number as num;

fn require(condition: Bool) {
    if !condition {
        rinzu.core.panic("failed");
    }
}

fn ok<T: Equality>(value: T, expected: T) {
    require(value == expected);
}

fn width0() {
    let low: CInt8 = -128;
    let high: CInt8 = 127;
    let zero: CInt8 = 0;
    let one: CInt8 = 1;
    let two: CInt8 = 2;
    require(num.wrappingAdd(high, one) == low);
    require(num.wrappingSub(low, one) == high);
    require(num.wrappingMul(high, two) == CInt8(-2));
    require(num.bitNot(zero) == num.wrappingSub(zero, one));
    require(num.bitXor(high, high) == zero);
    require(num.bitAnd(high, zero) == zero);
    require(num.bitOr(high, zero) == high);
    ok<CInt8>(num.checkedAdd(low, zero), low);
    ok<CInt8>(num.checkedMul(low, zero), zero);
    try {
        let unexpected1 = num.checkedAdd(high, one);
        require(false);
    }
    catch [problem1: Error, ...rest1] {
        require(err.code(problem1) == Option<Int>.Some(value: 300));
        require(rinzu.list.length(rest1) == 0);
    }
    try {
        let unexpected2 = num.checkedSub(low, one);
        require(false);
    }
    catch [problem2: Error, ...rest2] {
        require(err.code(problem2) == Option<Int>.Some(value: 300));
        require(rinzu.list.length(rest2) == 0);
    }
    try {
        let unexpected3 = num.checkedMul(high, two);
        require(false);
    }
    catch [problem3: Error, ...rest3] {
        require(err.code(problem3) == Option<Int>.Some(value: 300));
        require(rinzu.list.length(rest3) == 0);
    }
    ok<CInt8>(num.shiftLeft(one, 0), one);
    ok<CInt8>(num.shiftRight(high, 0), high);
    ok<CInt8>(num.shiftLeft(one, 7), CInt8(-128));
    ok<CInt8>(num.shiftRight(low, 7), CInt8(-1));
    try {
        let unexpected4 = num.shiftLeft(one, -1);
        require(false);
    }
    catch [problem4: Error, ...rest4] {
        require(err.code(problem4) == Option<Int>.Some(value: 301));
        require(rinzu.list.length(rest4) == 0);
    }
    try {
        let unexpected5 = num.shiftRight(one, -1);
        require(false);
    }
    catch [problem5: Error, ...rest5] {
        require(err.code(problem5) == Option<Int>.Some(value: 301));
        require(rinzu.list.length(rest5) == 0);
    }
    try {
        let unexpected6 = num.shiftLeft(one, 8);
        require(false);
    }
    catch [problem6: Error, ...rest6] {
        require(err.code(problem6) == Option<Int>.Some(value: 301));
        require(rinzu.list.length(rest6) == 0);
    }
    try {
        let unexpected7 = num.shiftRight(one, 8);
        require(false);
    }
    catch [problem7: Error, ...rest7] {
        require(err.code(problem7) == Option<Int>.Some(value: 301));
        require(rinzu.list.length(rest7) == 0);
    }
    try {
        let unexpected8 = num.shiftLeft(one, 9);
        require(false);
    }
    catch [problem8: Error, ...rest8] {
        require(err.code(problem8) == Option<Int>.Some(value: 301));
        require(rinzu.list.length(rest8) == 0);
    }
    try {
        let unexpected9 = num.shiftRight(one, 9);
        require(false);
    }
    catch [problem9: Error, ...rest9] {
        require(err.code(problem9) == Option<Int>.Some(value: 301));
        require(rinzu.list.length(rest9) == 0);
    }
    try {
        let unexpected10 = num.shiftLeft(one, 9223372036854775807);
        require(false);
    }
    catch [problem10: Error, ...rest10] {
        require(err.code(problem10) == Option<Int>.Some(value: 301));
        require(rinzu.list.length(rest10) == 0);
    }
    try {
        let unexpected11 = num.shiftRight(one, 9223372036854775807);
        require(false);
    }
    catch [problem11: Error, ...rest11] {
        require(err.code(problem11) == Option<Int>.Some(value: 301));
        require(rinzu.list.length(rest11) == 0);
    }
    try {
        let unexpected12 = num.shiftLeft(one, -9223372036854775808);
        require(false);
    }
    catch [problem12: Error, ...rest12] {
        require(err.code(problem12) == Option<Int>.Some(value: 301));
        require(rinzu.list.length(rest12) == 0);
    }
    try {
        let unexpected13 = num.shiftRight(one, -9223372036854775808);
        require(false);
    }
    catch [problem13: Error, ...rest13] {
        require(err.code(problem13) == Option<Int>.Some(value: 301));
        require(rinzu.list.length(rest13) == 0);
    }
    let bits: CInt8 = 0x7F;
    require(bits == CInt8(127));
}

