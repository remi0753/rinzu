fn width11() {
    let low: CSize = 0;
    let high: CSize = 18446744073709551615;
    let zero: CSize = 0;
    let one: CSize = 1;
    let two: CSize = 2;
    require(num.wrappingAdd(high, one) == low);
    require(num.wrappingSub(low, one) == high);
    require(num.wrappingMul(high, two) == 18446744073709551614);
    require(num.bitNot(zero) == num.wrappingSub(zero, one));
    require(num.bitXor(high, high) == zero);
    require(num.bitAnd(high, zero) == zero);
    require(num.bitOr(high, zero) == high);
    ok<CSize>(num.checkedAdd(low, zero), low);
    ok<CSize>(num.checkedMul(low, zero), zero);
    try {
        let unexpected144 = num.checkedAdd(high, one);
