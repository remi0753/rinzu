import rinzu.io;
import rinzu.process;
import rinzu.http;
import rinzu.socket;
import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.error as err;

fn requiredErrorCode(problem: Error) nothrow -> Int {
    switch err.code(problem) {
        case Option.Some(value): {
            return value;
        }
        case Option.None: {
            rinzu.core.panic("expected a numeric error code");
            return 0;
        }
    }
}

fn status(problem: Error) -> Int {
    switch err.nativeStatus(problem) {
        case Option.Some(value): {
            return value;
        }
        case Option.None: {
            rinzu.core.panic("missing");
        }
    }
    return 0;
}

async fn main() {
    try {
        try {
            let invalidName = rinzu.process.environment("");
        }
        catch [environmentError: Error, ...environmentRest] {
            rinzu.stdio.writeLine(requiredErrorCode(environmentError));
        }
        try {
            let invalidFile = await rinzu.io.openRead("");
        }
        catch [fileError: Error, ...fileRest] {
            rinzu.stdio.writeLine(status(fileError));
        }
        try {
            let invalidAddress = rinzu.socket.address("\u{0}", 80);
        }
        catch [addressError: Error, ...addressRest] {
            rinzu.stdio.writeLine(status(addressError));
        }
        let client = rinzu.http.newClient();
        try {
            let response = await rinzu.http.request(client, "\u{0}", bytesApi.from(b""), false, 100);
            rinzu.core.panic("unexpectedlySucceeded");
        }
        catch [requestError: rinzu.http.HttpFailure, ...requestRest] {
            rinzu.stdio.writeLine(status(requestError.payload.cause));
            rinzu.stdio.writeLine(requestError.payload.status);
            rinzu.stdio.writeLine(bytesApi.length(requestError.payload.partial));
            rinzu.stdio.writeLine(requestError.payload.sent);
        }
        catch errors {
            rinzu.core.panic("unexpectedType");
        }
        finally {
            let closed = await rinzu.http.close(client);
        }
        rinzu.stdio.writeLine(rinzu.http.liveClients());
        rinzu.stdio.writeLine(rinzu.http.liveBuffers());
        rinzu.stdio.writeLine(rinzu.io.liveFiles());
    }
    catch errors {
        rinzu.core.panic("unexpected");
    }
}
