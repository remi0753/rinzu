import rinzu.list;

class Box {
    value: Int
}

error Problem {
    payload: Box
}

fn integer(values: List<Int>, index: Int) -> Int {
    switch rinzu.list.get(values, index) {
        case Option.Some(value): {
            return value;
        }
        case Option.None: {
            panic("assertionFailure0");
            return 0;
        }
    }
}

fn checks() {
    let empty: List<Int> = [];
    let one = rinzu.list.append(empty, 11);
    let two = rinzu.list.append(one, 22);
    if empty != [] || one != [11] || two != [11, 22] {
        panic("assertionFailure1");
    }
    switch rinzu.list.set(one, 0, 33) {
        case Option.Some(updated): {
            if updated != [33] || one != [11] {
                panic("assertionFailure2");
            }
        }
        case Option.None: {
            panic("assertionFailure3");
        }
    }
    switch rinzu.list.remove(one, 0) {
        case Option.Some(updated): {
            if updated != [] || one != [11] {
                panic("assertionFailure4");
            }
        }
        case Option.None: {
            panic("assertionFailure5");
        }
    }
    switch rinzu.list.remove(two, 0) {
        case Option.Some(updated): {
            if updated != [22] {
                panic("assertionFailure6");
            }
        }
        case Option.None: {
            panic("assertionFailure7");
        }
    }
    switch rinzu.list.remove(two, 1) {
        case Option.Some(updated): {
            if updated != [11] {
                panic("assertionFailure8");
            }
        }
        case Option.None: {
            panic("assertionFailure9");
        }
    }
    var index = -1;
    while index < 3 {
        if index != 0 {
            switch rinzu.list.set(one, index, 99) {
                case Option.None: {}
                case Option.Some(unexpected): {
                    panic("assertionFailure10");
                }
            }
            switch rinzu.list.remove(one, index) {
                case Option.None: {}
                case Option.Some(unexpected): {
                    panic("assertionFailure11");
                }
            }
        }
        index = index + 1;
    }
    switch rinzu.list.remove(empty, 9223372036854775807) {
        case Option.None: {}
        case Option.Some(unexpected): {
            panic("assertionFailure12");
        }
    }
    var values: List<Int> = [];
    index = 0;
    while index < 130 {
        values = rinzu.list.append(values, index);
        index = index + 1;
    }
    switch rinzu.list.set(values, 64, 999) {
        case Option.Some(updated): {
            index = 0;
            while index < 130 {
                var setExpected = index;
                if index == 64 {
                    setExpected = 999;
                }
                if integer(updated, index) != setExpected || integer(values, index) != index {
                    panic("assertionFailure13");
                }
                index = index + 1;
            }
        }
        case Option.None: {
            panic("assertionFailure14");
        }
    }
    switch rinzu.list.remove(values, 64) {
        case Option.Some(updated): {
            if rinzu.list.length(updated) != 129 {
                panic("assertionFailure15");
            }
            index = 0;
            while index < 129 {
                var removeExpected = index;
                if index >= 64 {
                    removeExpected = index + 1;
                }
                if integer(updated, index) != removeExpected {
                    panic("assertionFailure16");
                }
                index = index + 1;
            }
        }
        case Option.None: {
            panic("assertionFailure17");
        }
    }
    let strings = ["日本語", "tail"];
    let appended = rinzu.list.append(strings, "third");
    switch rinzu.list.set(appended, 1, "changed") {
        case Option.Some(updated): {
            if updated != ["日本語", "changed", "third"] || strings != ["日本語", "tail"] {
                panic("assertionFailure18");
            }
        }
        case Option.None: {
            panic("assertionFailure19");
        }
    }
    let bytes = [byteArray(b"\x00\xff"), byteArray(b"\x80")];
    let more = rinzu.list.append(bytes, byteArray(b"end"));
    switch rinzu.list.remove(more, 1) {
        case Option.Some(updated): {
            if updated != [byteArray(b"\x00\xff"), byteArray(b"end")]
                || bytes != [byteArray(b"\x00\xff"), byteArray(b"\x80")] {
                panic("assertionFailure20");
            }
        }
        case Option.None: {
            panic("assertionFailure21");
        }
    }
    let box = Box(value: 7);
    let boxes = [box];
    let shared = rinzu.list.append(boxes, box);
    box.value = 8;
    switch rinzu.list.get(shared, 1) {
        case Option.Some(value): {
            if value.value != 8 {
                panic("assertionFailure22");
            }
        }
        case Option.None: {
            panic("assertionFailure23");
        }
    }
    let noErrors: List<Error> = [];
    let problems = rinzu.list.append(noErrors, Problem(message: "first", payload: box));
    switch rinzu.list.set(problems, 0, Problem(message: "second", payload: box)) {
        case Option.Some(replacedProblems): {
            if rinzu.list.length(replacedProblems) != 1 || rinzu.list.length(problems) != 1 {
                panic("errorListFailure");
            }
        }
        case Option.None: {
            panic("missingErrorList");
        }
    }
    let nested = [one, two];
    switch rinzu.list.set(nested, 0, [44]) {
        case Option.Some(updated): {
            if updated != [[44], [11, 22]] || nested != [[11], [11, 22]] {
                panic("assertionFailure24");
            }
        }
        case Option.None: {
            panic("assertionFailure25");
        }
    }
}

fn worker() -> Int {
    try {
        checks();
        return 42;
    }
    catch errors {
        panic("assertionFailure26");
        return 0;
    }
}

async fn number(value: Int) -> Int {
    return value;
}

async fn main() {
    try {
        checks();
        let result = await spawn worker();
        if result != 42 {
            panic("assertionFailure27");
        }
        let first = number(41);
        let second = number(42);
        let futures = [first];
        switch rinzu.list.set(futures, 0, second) {
            case Option.Some(updated): {
                switch rinzu.list.get(updated, 0) {
                    case Option.Some(future): {
                        let value = await future;
                        if value != 42 {
                            panic("assertionFailure28");
                        }
                    }
                    case Option.None: {
                        panic("assertionFailure29");
                    }
                }
            }
            case Option.None: {
                panic("assertionFailure30");
            }
        }
        let old = await first;
        let new = await second;
        if old != 41 || new != 42 {
            panic("assertionFailure31");
        }
    }
    catch errors {
        panic("assertionFailure32");
    }
}
