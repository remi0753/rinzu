import rinzu.process;
import rinzu.stdio;
import rinzu.core;

fn showArguments() {
    let args = rinzu.process.arguments();
    for value in args {
        rinzu.stdio.writeLine(f"<{value}>");
    }
    if args != rinzu.process.arguments() {
        rinzu.core.panic("argument snapshot changed");
    }
}

fn main() {
    try {
        showArguments();
    }
    catch [problem: rinzu.process.InvalidArgumentEncoding] {
        try {
            rinzu.stdio.writeLine(f"invalid {problem.payload.index}/{problem.payload.byteOffset}");
        }
        catch output {
            rinzu.core.panic("stdout failed");
        }
    }
    catch other {
        rinzu.core.panic("stdout failed");
    }
}
