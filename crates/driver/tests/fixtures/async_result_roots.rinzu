import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;

class Kept {
    text: String,
    bytes: ByteArray
}

fn check(condition: Bool) {
    if !condition {
        rinzu.core.panic("bad");
    }
}

fn churn() {
    var i = 0;
    while i < 12 {
        let moved = Kept(text: f"moved {i}", bytes: bytesApi.from(b"temporary"));
        i = i + 1;
    }
}

fn retained(value: Kept) -> Kept {
    try {
        return value;
    }
    finally {
        churn();
    }
}

fn nested() -> Kept {
    try {
        return retained(Kept(text: "日本語\u{0}held", bytes: bytesApi.from(b"\x00\x80\xff")));
    }
    finally {
        churn();
    }
}

async fn produce() -> Kept {
    return nested();
}

async fn turn() {
    churn();
}

async fn main() {
    try {
        let pending = produce();
        try {
            let first = await pending;
            var i = 0;
            while i < 12 {
                await turn();
                i = i + 1;
            }
            let again = await pending;
            check(first.text == "日本語\u{0}held" && again.text == first.text);
            check(
                bytesApi.length(again.bytes) == 3
                    && bytesApi.get(again.bytes, 2) == bytesApi.get(bytesApi.from(b"\xff"), 0)
            );
        }
        finally {
            let settled = await pending;
            churn();
        }
        rinzu.stdio.writeLine("A02:future-result:alias:finally-return:OK");
    }
    catch unexpected {
        rinzu.core.panic("failed");
    }
}
