import rinzu.stdio;

class Kept {
    text: String,
    bytes: ByteArray
}

fn check(condition: Bool) {
    if !condition {
        panic("bad");
    }
}

fn churn() {
    var i = 0;
    while i < 12 {
        let moved = Kept(text: f"moved {i}", bytes: byteArray(b"temporary"));
        i = i + 1;
    }
}

fn retained(value: Kept) -> Kept {
    try {
        return value;
    }
    finally {
        churn();
    }
}

fn nested() -> Kept {
    try {
        return retained(Kept(text: "日本語\u{0}held", bytes: byteArray(b"\x00\x80\xff")));
    }
    finally {
        churn();
    }
}

async fn produce() -> Kept {
    return nested();
}

async fn turn() {
    churn();
}

async fn main() {
    try {
        let pending = produce();
        try {
            let first = await pending;
            var i = 0;
            while i < 12 {
                await turn();
                i = i + 1;
            }
            let again = await pending;
            check(first.text == "日本語\u{0}held" && again.text == first.text);
            check(bytesLength(again.bytes) == 3 && bytesGet(again.bytes, 2) == bytesGet(byteArray(b"\xff"), 0));
        }
        finally {
            let settled = await pending;
            churn();
        }
        rinzu.stdio.writeLine("A02:future-result:alias:finally-return:OK");
    }
    catch unexpected {
        panic("failed");
    }
}
