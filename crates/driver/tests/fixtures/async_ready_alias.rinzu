import rinzu.list;

class Trace {
    values: List<Int>
}

async fn value() -> Int {
    return 42;
}

async fn gate() -> Int {
    return await value();
}

async fn observe(shared: Future<Int>, trace: Trace, index: Int) -> Int {
    let result = await shared;
    try {
        trace.values = rinzu.list.append(trace.values, index);
    }
    catch [overflow: rinzu.list.LengthOverflow] {
        panic(overflow.message);
    }
    return result;
}

async fn main() {
    let trace = Trace(values: []);
    let shared = gate();
    var futures: List<Future<Int>> = [];
    var index = 0;
    while index < 96 {
        futures = rinzu.list.append(futures, observe(shared, trace, index));
        index = index + 1;
    }
    if rinzu.list.length(trace.values) != 0 {
        panic("ranBeforeTurn");
    }
    index = 0;
    while index < 96 {
        switch rinzu.list.get(futures, index) {
            case Option.Some(future): {
                let result = await future;
                if result != 42 {
                    panic("wrongResult");
                }
            }
            case Option.None: {
                panic("missingFuture");
            }
        }
        switch rinzu.list.get(trace.values, index) {
            case Option.Some(value): {
                if value != index {
                    panic("changedOrder");
                }
            }
            case Option.None: {
                panic("missingTrace");
            }
        }
        index = index + 1;
    }
}
