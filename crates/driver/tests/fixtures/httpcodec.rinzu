import rinzu.httpcodec;
import rinzu.bytes as bytesApi;
import rinzu.core;

fn valid(data: ByteArray, method: String, target: String) {
    let line = rinzu.httpcodec.requestLine(data);
    if line.method != method || line.target != target {
        rinzu.core.panic("invalidLine");
    }
}

fn invalid(data: ByteArray, expected: Int) {
    try {
        let accepted = rinzu.httpcodec.requestLine(data);
        rinzu.core.panic("invalidAccept");
    }
    catch [problem: rinzu.httpcodec.InvalidRequestLine, ...rest] {
        if problem.payload != expected {
            rinzu.core.panic("invalidStatus");
        }
    }
}

fn main() {
    try {
        valid(bytesApi.from(b"GET /plaintext HTTP/1.1"), "GET", "/plaintext");
        valid(bytesApi.from(b"!#$ /x?y=%2f+z HTTP/1.1"), "!#$", "/x?y=%2f+z");
        invalid(bytesApi.from(b"GET  HTTP/1.1"), 400);
        invalid(bytesApi.from(b"GET /#fragment HTTP/1.1"), 400);
        invalid(bytesApi.from(b"GET /\x80 HTTP/1.1"), 400);
        invalid(bytesApi.from(b"G\x00T / HTTP/1.1"), 400);
        invalid(bytesApi.from(b"GET / HTTP/1.0"), 400);
        invalid(bytesApi.from(b"GET / HTTP/1.1 "), 400);
        invalid(bytesApi.from(b""), 400);
    }
    catch errors {
        rinzu.core.panic("unexpectedError");
    }
}
