import rinzu.list;
import rinzu.map;
import rinzu.stdio;

class Box {
    value: Int
}

fn check(value: Bool) {
    if !value {
        panic("lengthFailure");
    }
}

fn checks() {
    let empty = byteArray(b"");
    let binary = byteArray(b"\x00\xff\x80z");
    let text = "A日本😀é\u{0}";
    check(bytesLength(empty) == 0 && bytesLength(binary) == 4);
    check(stringLength("") == 0 && stringLength("ASCII\u{0}") == 6);
    check(stringLength(text) == 7 && bytesLength(utf8Encode(text)) == 15);
    let noInts: List<Int> = [];
    let noStrings: List<String> = [];
    let noMap: Map<String, Int> = {};
    check(rinzu.list.length(noInts) == 0 && rinzu.list.length(noStrings) == 0 && rinzu.map.length(noMap) == 0);
    let words = ["日本語", "second"];
    let nested = [[1, 2], []];
    let box = Box(value: 7);
    let boxes = [box, box];
    let values = {
        "left": binary, "right": empty
    };
    check(rinzu.list.length(words) == 2 && rinzu.list.length(nested) == 2 && rinzu.list.length(boxes) == 2);
    check(rinzu.map.length(values) == 2 && rinzu.map.length(rinzu.map.insert(values, "left", empty)) == 2);
    var bytes = binary;
    var ints = noInts;
    var map = noMap;
    var index = 0;
    while index < 96 {
        bytes = bytesConcat(bytes, binary);
        ints = rinzu.list.append(ints, index);
        map = rinzu.map.insert(map, f"key-{index}", index);
        check(bytesLength(bytes) == (index + 2) * 4);
        check(rinzu.list.length(ints) == index + 1 && rinzu.map.length(map) == index + 1);
        check(stringLength(text) == 7 && rinzu.list.length(boxes) == 2);
        index = index + 1;
    }
    box.value = 9;
    check(rinzu.list.length(boxes) == 2);
}

fn worker() -> Int {
    try {
        checks();
    }
    catch [overflow: rinzu.list.LengthOverflow] {
        panic(overflow.message);
    }
    catch [overflow: rinzu.map.LengthOverflow] {
        panic(overflow.message);
    }
    return 42;
}

async fn main() {
    try {
        checks();
        let result = await spawn worker();
        check(result == 42);
        rinzu.stdio.writeLine("scalar-lengths-ok");
    }
    catch errors {
        panic("unexpectedLengthError");
    }
}
