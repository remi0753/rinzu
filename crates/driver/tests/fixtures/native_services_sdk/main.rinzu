import rinzu.timer;
import services;

async fn retainedTimer(milliseconds: Int) -> Int {
    try {
        let retained = ["timer roots 日本語", "pending future"];
        await rinzu.timer.sleep(milliseconds);
        var index = 0;
        while index < 256 {
            let temporary = ["moving collection", "timer continuation"];
            index = index + 1;
        }
        if retained != ["timer roots 日本語", "pending future"] {
            panic("invalidRoots");
        }
        return milliseconds;
    }
    catch unexpectedErrors {
        panic("unexpectedFailure");
        return 0;
    }
}

async fn main() {
    try {
        let slow = retainedTimer(500);
        let fast = retainedTimer(0);
        let fastResult = await fast;
        if fastResult != 0 {
            panic("invalidZero");
        }
        let fileSize = await services.readSize("data/input.txt");
        if fileSize != 5 {
            panic("invalidFile");
        }
        var caught = 0;
        try {
            await rinzu.timer.sleep(-1);
        }
        catch [error: Error, ...errorRest] {
            if error.message != "numeric conversion is out of range or loses required integer precision" {
                panic("invalidError");
            }
            caught = caught + 1;
        }
        finally {
            caught = caught + 10;
        }
        if caught != 11 {
            panic("invalidCleanup");
        }
        let slowResult = await slow;
        if slowResult != 500 {
            panic("invalidSlow");
        }
    }
    catch unexpectedErrors {
        panic("unexpectedFailure");
    }
}
