import rinzu.list;
import rinzu.map;
import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;

class Kept {
    text: String,
    bytes: ByteArray,
    next: Option<Kept>
}

fn check(value: Bool) {
    if !value {
        rinzu.core.panic("gcFailure");
    }
}

fn pressure() {
    var index = 0;
    while index < 2048 {
        let dead = Kept(text: f"discarded {index}", bytes: bytesApi.from(b"temporary"), next: Option<Kept>.None());
        index = index + 1;
    }
}

async fn produce() -> Kept {
    let root = Kept(text: "日本語\u{0}held", bytes: bytesApi.from(b"\x00\x80\xff"), next: Option<Kept>.None());
    root.next = Option<Kept>.Some(value: root);
    return root;
}

async fn main() {
    try {
        let pending = produce();
        try {
            let first = await pending;
            let words = [first.text, "second"];
            let kept = {
                "binary": first.bytes
            };
            pressure();
            let again = await pending;
            check(first.text == "日本語\u{0}held" && again.text == first.text);
            check(
                bytesApi.length(again.bytes) == 3
                    && bytesApi.get(again.bytes, 2) == bytesApi.get(bytesApi.from(b"\xff"), 0)
            );
            switch rinzu.list.get(words, 0) {
                case Option.Some(word): {
                    check(word == first.text);
                }
                case Option.None: {
                    check(false);
                }
            }
            switch rinzu.map.get(kept, "binary") {
                case Option.Some(binary): {
                    check(bytesApi.length(binary) == 3);
                }
                case Option.None: {
                    check(false);
                }
            }
            switch again.next {
                case Option.Some(alias): {
                    alias.text = "changed";
                    check(first.text == "changed");
                }
                case Option.None: {
                    check(false);
                }
            }
        }
        finally {
            let settled = await pending;
        }
        rinzu.stdio.writeLine("R01:pressure:cycle:future-result:alias:bytes:list:map:OK");
    }
    catch errors {
        rinzu.core.panic("unexpectedGcFailure");
    }
}
