import rinzu.list;
import rinzu.map;
import rinzu.core;

error Failed {}

async fn fail(value: Int) -> Int {
    throw Failed(message: f"{value}");
}

fn start(value: Int) -> Future<Int> {
    return fail(value);
}

async fn main() {
    let tasks = rinzu.list.map([1, 2, 3], start);
    var failures = 0;
    for task in tasks {
        try {
            let unexpected = await task;
            rinzu.core.panic("task succeeded");
        }
        catch [problem: Failed] {
            failures = failures + 1;
        }
    }
    if failures != 3 {
        rinzu.core.panic("missing map futures");
    }
    let pending = fail(7);
    let input: List<{ key: Int, value: Future<Int> }> = [{ key = 7, value = pending }];
    try {
        let table = rinzu.map.fromEntries(input);
        for entry in rinzu.map.entries(table) {
            try {
                let unexpected = await entry.value;
                rinzu.core.panic("task succeeded");
            }
            catch errors {
                failures = failures + 1;
            }
        }
    }
    catch [duplicate: rinzu.map.DuplicateKey<Int>] {
        for entry in input {
            try {
                let unexpected = await entry.value;
            }
            catch errors {}
        }
        rinzu.core.panic("duplicate accepted");
    }
    if failures != 4 {
        rinzu.core.panic("missing entry futures");
    }
}
