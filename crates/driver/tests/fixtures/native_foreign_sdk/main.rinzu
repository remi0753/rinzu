import foreign;
import rinzu.core;
import rinzu.bytes as bytesApi;

async fn child() -> Int {
    try {
        let root = ["foreign Origin child", "after capsule close"];
        let bytes = await foreign.readSize("data/proof.bin");
        if bytes != 8193 || root != ["foreign Origin child", "after capsule close"] {
            rinzu.core.panic("lostChild");
        }
        return bytes;
    }
    catch unexpectedErrors {
        rinzu.core.panic("unexpectedFailure");
        return 0;
    }
}

fn scalar(
    a: CInt8,
    b: CInt16,
    c: CInt32,
    d: CInt64,
    e: CUInt8,
    f: CUInt16,
    g: CUInt32,
    h: CUInt64,
    i: CFloat,
    j: CDouble,
    k: CBool,
    label: String,
    data: Bytes(4)
) -> CDouble fallback 0.0 {
    let root = [label, "foreign mixed ABI"];
    try {
        var index = 0;
        while index < 16 {
            let temporary = ["GC", label];
            if temporary != ["GC", label] {
                rinzu.core.panic("lostScalar");
            }
            index = index + 1;
        }
        if a != -17
            || b != -2001
            || c != -1234567
            || d != -4000000000
            || e != 255
            || f != 65535
            || g != 4294967295
            || h != 18446744073709551615
            || i != 0.0
            || j != 42.5
            || !k
            || label != "foreign 日本語"
            || data != b"\x00\xaa\x00\x7f"
            || root != [label, "foreign mixed ABI"] {
            rinzu.core.panic("wrongScalar");
        }
        return j;
    }
    finally {
        let cleanup = [label, "finally stays masked"];
        if cleanup != ["foreign 日本語", "finally stays masked"] {
            rinzu.core.panic("lostCleanup");
        }
    }
}

fn unit(label: String, data: Bytes(0)) -> Unit fallback () {
    if label == "nested" {
        foreign.nested();
    }
    if label != "unit 日本語" || data != b"" {
        rinzu.core.panic("wrongUnit");
    }
    let pending = child();
}

fn text(label: String) -> String fallback "fallback 日本語" {
    if label == "closed" {
        foreign.bodyMarker();
    }
    if label == "settled 日本語" {
        foreign.afterReturn();
        let pending = child();
    }
    let root = [label, "keep input across moving GC"];
    var index = 0;
    while index < 16 {
        let temporary = ["text GC", label];
        if temporary != ["text GC", label] {
            rinzu.core.panic("lostText");
        }
        index = index + 1;
    }
    if root != [label, "keep input across moving GC"] || (label != "foreign 日本語" && label != "settled 日本語") {
        rinzu.core.panic("wrongText");
    }
    return "foreign result 🧭";
}

fn bytes(value: Bytes(4)) -> Bytes(4) fallback b"" {
    if value != b"\x00\xaa\x00\x7f" {
        rinzu.core.panic("wrongBytes");
    }
    return value;
}

fn failed(label: String) -> CInt fallback -7 {
    try {
        let invalid = CInt8(500);
    }
    finally {
        let root = [label, "finally before result"];
    }
    return 1;
}

fn failedText(label: String) -> String fallback "fallback 日本語" {
    foreign.bodyMarker();
    return label;
}

fn failedBytes(label: String) -> Bytes(4) fallback b"\xfe" {
    foreign.bodyMarker();
    return b"";
}

fn unsupported(handle: foreign.Handle) -> CInt fallback -7 {
    foreign.bodyMarker();
    return 1;
}

async fn main() {
    try {
        foreign.reset(0);
        try {
            let result = await foreign.run(
                scalar,
                unit,
                text,
                bytes,
                failed,
                failedText,
                failedBytes,
                bytesApi.byteLength,
                unsupported,
                0
            );
            var index = 0;
            while index < 32 {
                let root = ["after native return", "all accepted calls settled"];
                if root != ["after native return", "all accepted calls settled"] {
                    rinzu.core.panic("lostMain");
                }
                index = index + 1;
            }
            if result != 23 {
                rinzu.core.panic("wrongResult");
            }
        }
        finally {
            if foreign.finish() != 1 {
                rinzu.core.panic("wrongFinish");
            }
        }
    }
    catch unexpectedErrors {
        rinzu.core.panic("unexpectedFailure");
    }
}
