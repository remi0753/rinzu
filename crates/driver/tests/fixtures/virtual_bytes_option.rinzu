import rinzu.stdio;
import rinzu.process;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.string as textApi;

class Garbage {
    value: Int,
    label: String
}

fn check(value: Bool) {
    if !value {
        rinzu.core.panic("optionFailure");
    }
}

fn leaf(data: ByteArray, start: Int, end: Int) -> ByteArray {
    switch bytesApi.slice(data, start, end) {
        case Option.Some(piece): {
            return piece;
        }
        case Option.None: {
            return bytesApi.from(b"invalid");
        }
    }
}

fn aliased(data: ByteArray, start: Int, end: Int) -> ByteArray {
    let candidate = bytesApi.slice(data, start, end);
    switch candidate {
        case Option.Some(aliasPiece): {
            return aliasPiece;
        }
        case Option.None: {
            return bytesApi.from(b"invalid");
        }
    }
}

fn escaping(data: ByteArray, start: Int, end: Int) -> Option<ByteArray> {
    return bytesApi.slice(data, start, end);
}

fn pressure() {
    var index = 0;
    while index < 2048 {
        let garbage = Garbage(value: index, label: f"discarded {index}");
        index = index + 1;
    }
}

fn worker() -> ByteArray {
    return leaf(bytesApi.from(b"\x00\x80\xffabc"), 1, 3);
}

async fn main() {
    try {
        // A real native dependency also exercises the compiled C-JIT entry.
        let environment = rinzu.process.environment("PATH");
        switch environment {
            case Option.Some(environmentText): {
                check(textApi.length(environmentText) >= 0);
            }
            case Option.None: {}
        }
        let input = bytesApi.from(b"\x00\x80\xffabc");
        var start = -2;
        while start <= 8 {
            var end = -2;
            while end <= 8 {
                let expected = aliased(input, start, end);
                let actual = leaf(input, start, end);
                check(actual == expected);
                switch escaping(input, start, end) {
                    case Option.Some(escapedPiece): {
                        check(escapedPiece == actual);
                    }
                    case Option.None: {
                        check(actual == bytesApi.from(b"invalid"));
                    }
                }
                end = end + 1;
            }
            start = start + 1;
        }
        let empty = bytesApi.from(b"");
        check(leaf(empty, 0, 0) == empty);
        check(leaf(input, 0, bytesApi.length(input)) == input);
        check(bytesApi.length(leaf(input, 2, 2)) == 0);
        check(leaf(input, 0 - 9223372036854775807 - 1, 0) == bytesApi.from(b"invalid"));
        check(leaf(input, 0, 9223372036854775807) == bytesApi.from(b"invalid"));
        let kept = leaf(input, 1, 3);
        pressure();
        check(kept == bytesApi.from(b"\x80\xff"));
        let pending = spawn worker();
        try {
            let workerFirst = await pending;
            pressure();
            let workerAgain = await pending;
            check(workerFirst == kept && workerAgain == kept);
        }
        finally {
            let settledWorker = await pending;
        }
        rinzu.stdio.writeLine("C06:bytes-option:bounds:escape:gc:worker:alias:OK");
    }
    catch errors {
        rinzu.core.panic("unexpectedOptionFailure");
    }
}
