import spans;
import rinzu.core;

async fn main() {
    if spans.exercise() != 65540 {
        rinzu.core.panic("wrongMain");
    }
    let first = spawn spans.exercise();
    let second = spawn spans.exercise();
    if await first != 65540 || await second != 65540 {
        rinzu.core.panic("wrongWorker");
    }
}
