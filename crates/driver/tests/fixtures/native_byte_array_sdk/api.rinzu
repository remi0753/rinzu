import rinzu.bytes as bytesApi;
import rinzu.core;

native {
    fn take(kind: CInt) -> ByteArray symbol "span_result";

    fn mutate() -> Unit symbol "span_mutate";

    fn empty() -> ByteArray symbol "span_empty";

    fn withCallback(measure: fn (Bytes(4)) -> CSize) -> ByteArray symbol "span_callback";
}

fn exercise() -> Int {
    try {
        let small = take(1);
        let emptyValue = empty();
        let unreadableEmpty = take(3);
        let large = take(4);
        let measure: fn (Bytes(4)) -> CSize = bytesApi.byteLength;
        let callbackValue = withCallback(measure);
        mutate();
        if small != bytesApi.from(b"\x00\xff\x80\x00")
            || bytesApi.length(emptyValue) != 0
            || callbackValue != small
            || bytesApi.length(unreadableEmpty) != 0
            || bytesApi.length(large) != 65536
            || bytesApi.get(large, 0) != Option<CUInt8>.Some(value: CUInt8(0))
            || bytesApi.get(large, 32768) != Option<CUInt8>.Some(value: CUInt8(0))
            || bytesApi.get(large, 65535) != Option<CUInt8>.Some(value: CUInt8(117)) {
            rinzu.core.panic("wrongSnapshot");
        }
        var caught = 0;
        try {
            let missing = take(0);
        }
        catch [problem: Error, ...rest] {
            if problem.message != "native value is NULL" {
                rinzu.core.panic("wrongNull");
            }
            caught = caught + 1;
        }
        if caught != 1 {
            rinzu.core.panic("missingError");
        }
        return bytesApi.length(large) + bytesApi.length(small);
    }
    catch errors {
        rinzu.core.panic("unexpected");
        return 0;
    }
}

export exercise;
