import rinzu.stdio;
import rinzu.process;
import rinzu.bytes as bytesApi;
import rinzu.core;

class Held {
    text: String,
    bytes: ByteArray
}

error Expected {}

fn check(value: Bool) {
    if !value {
        rinzu.core.panic("bad");
    }
}

fn churn() {
    var i = 0;
    while i < 32 {
        let discarded = Held(text: f"moved {i}", bytes: bytesApi.from(b"garbage"));
        i = i + 1;
    }
}

async fn leaf() -> Held {
    return Held(text: "日本語\u{0}held", bytes: bytesApi.from(b"\x00\x80\xff"));
}

async fn failing() -> Held {
    throw Expected(message: "expected");
}

fn direct() -> Future<Held> {
    return leaf();
}

fn chain() -> Future<Held> {
    return direct();
}

fn choose(flag: Bool) -> Future<Held> {
    if flag {
        return chain();
    }
    return leaf();
}

fn failWrapper() -> Future<Held> {
    return failing();
}

fn identity(value: Future<Held>) -> Future<Held> {
    return value;
}

fn cleanup() -> Future<Held> {
    try {
        return direct();
    }
    finally {
        churn();
    }
}

fn identityBytes(value: Future<ByteArray>) -> Future<ByteArray> {
    return value;
}

fn worker() -> ByteArray {
    churn();
    return bytesApi.from(b"\x00\xff");
}

async fn main() {
    try {
        let environment = rinzu.process.environment("PATH");
        let a = await chain();
        churn();
        check(a.text == "日本語\u{0}held" && bytesApi.length(a.bytes) == 3);
        let b = await choose(true);
        let c = await choose(false);
        churn();
        check(a.bytes == b.bytes && b.bytes == c.bytes);
        let aliasFuture = direct();
        let first = await identity(aliasFuture);
        churn();
        let again = await aliasFuture;
        check(first.text == again.text && first.bytes == again.bytes);
        try {
            let bad = await failWrapper();
            rinzu.core.panic("expected failure was not thrown");
        }
        catch [Expected] {
            churn();
        }
        let held = await cleanup();
        churn();
        check(held.bytes == a.bytes);
        let job = spawn worker();
        let result = await identityBytes(job);
        churn();
        let resultAgain = await job;
        check(result == bytesApi.from(b"\x00\xff") && resultAgain == result);
        try {
            let inner = await direct();
            check(inner.bytes == a.bytes);
        }
        finally {
            let final = await choose(false);
            check(final.text == a.text);
            churn();
        }
        rinzu.stdio.writeLine("A13:fresh-wrapper:alias:reawait:finally:error:gc:worker:OK");
    }
    catch unexpected {
        rinzu.core.panic("failed");
    }
}
