import rinzu.bytes as bytesApi;
import rinzu.core;

fn leaf(data: ByteArray, start: Int, end: Int) -> ByteArray {
    switch bytesApi.slice(data, start, end) {
        case Option.Some(piece): {
            return piece;
        }
        case Option.None: {
            return bytesApi.from(b"invalid");
        }
    }
}

class Check {
    const value: Int
}

fn main() {
    let input = bytesApi.from(b"abcd");
    let checked = Check(value: bytesApi.length(leaf(input, 1, 3)));
    if checked.value != 2 {
        rinzu.core.panic("wrongSlice");
    }
}
