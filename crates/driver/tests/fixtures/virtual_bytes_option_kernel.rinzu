fn leaf(data: ByteArray, start: Int, end: Int) -> ByteArray {
    switch bytesSlice(data, start, end) {
        case Option.Some(piece): {
            return piece;
        }
        case Option.None: {
            return byteArray(b"invalid");
        }
    }
}

class Check {
    const value: Int
}

fn main() {
    let input = byteArray(b"abcd");
    let checked = Check(value: bytesLength(leaf(input, 1, 3)));
    if checked.value != 2 {
        panic("wrongSlice");
    }
}
