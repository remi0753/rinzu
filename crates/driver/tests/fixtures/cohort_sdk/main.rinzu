import cohort;
import rinzu.future as future;
import rinzu.native as bridge;

fn answer() -> CSize fallback 0 {
    return CSize(7183);
}

async fn main() {
    try {
        let controlled = cohort.controlled();
        let count = cohort.count();
        let c0 = cohort.start(0, answer);
        let f00 = bridge.transferred(c0);
        let f01 = bridge.transferred(c0);
        if controlled == CInt(1) {
            let cancelled = future.cancel(f00);
            if !cancelled {
                panic("cancel lost");
            }
        }
        let c1 = cohort.start(1, answer);
        if cohort.early() == CInt(1) {
            let earlyPublish = cohort.publish(1);
        }
        let f10 = bridge.transferred(c1);
        let f11 = bridge.transferred(c1);
        if controlled == CInt(1) && cohort.early() == CInt(0) {
            let timed = future.timeout(f11);
            if !timed {
                panic("timeout lost");
            }
        }
        if cohort.polling() == CInt(1) {
            let pollingCarrier = cohort.pollStart(answer);
            let pollingFuture = bridge.completed(pollingCarrier);
            let pollingPublish = cohort.pollPublish();
            await pollingFuture;
            let pollingRetire = cohort.pollRetire();
        }
        let p0 = cohort.publish(0);
        let v0 = await f01;
        if v0 != 7183 {
            panic("old payload");
        }
        let r0 = cohort.retire(0);
        if count == CInt(3) {
            let c2 = cohort.start(2, answer);
            let f20 = bridge.transferred(c2);
            let f21 = bridge.transferred(c2);
            let lateCancel = future.cancel(f00);
            let lateTimeout = future.timeout(f01);
            if lateCancel || lateTimeout {
                panic("old control won");
            }
            let cached = await f01;
            let checked = cohort.alias(cached);
            let status = cohort.status();
            let p1 = cohort.publish(1);
            let v1 = await f10;
            if v1 != 29 {
                panic("second payload");
            }
            let r1 = cohort.retire(1);
            let p2 = cohort.publish(2);
            let v20 = await f20;
            let v21 = await f21;
            if v20 != 65537 || v21 != 65537 {
                panic("replacement payload");
            }
            let r2 = cohort.retire(2);
        }
        else {
            let lateCancelAlt = future.cancel(f00);
            let lateTimeoutAlt = future.timeout(f01);
            if lateCancelAlt || lateTimeoutAlt {
                panic("old control won");
            }
            let cachedAlt = await f01;
            let checkedAlt = cohort.alias(cachedAlt);
            let p1Alt = cohort.publish(1);
            let v1Alt = await f10;
            if v1Alt != 29 {
                panic("second payload");
            }
            let r1Alt = cohort.retire(1);
        }
        let finished = cohort.finish();
        try {
            let last = await f00;
        }
        finally {
            let lastSecond = await f11;
        }
    }
    catch errors {
        panic("cohort failed");
    }
}
