import loops;
import rinzu.core;

fn callback(seed: CInt) -> CInt fallback -19 {
    try {
        let retained = ["root until physical return"];
        return 41;
    }
    finally {
        loops.checkInner();
    }
}

async fn main() {
    try {
        loops.checkReset(0);
        var caught = 0;
        try {
            let rejected = await loops.checkRun(callback, "queued argument 日本語", b"\x00\xAA\x00\x7F", 2);
        }
        catch [nullResult: Error, ...nullResultRest] {
            if nullResult.message == "native value is NULL" {
                caught = caught + 1;
            }
        }
        let result = await loops.checkRun(callback, "queued argument 日本語", b"\x00\xAA\x00\x7F", 3);
        if caught != 1 || result != "fresh result after settlement 日本語" {
            rinzu.core.panic("failed");
        }
        loops.checkOuter(2);
    }
    catch errors {
        rinzu.core.panic("unexpectedMainError");
    }
}
