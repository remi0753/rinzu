import rinzu.stdio;
import rinzu.process;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.string as textApi;

class Held {
    text: String,
    bytes: ByteArray
}

fn check(value: Bool) {
    if !value {
        rinzu.core.panic("badRoot");
    }
}

fn pair(value: String) -> ByteArray {
    // The first operand must survive allocation of the second operand.
    return bytesApi.concat(textApi.encodeUtf8(value), textApi.encodeUtf8(":tail"));
}

fn churn() {
    var index = 0;
    while index < 24 {
        let discarded = Held(text: f"discarded {index}", bytes: pair("garbage"));
        index = index + 1;
    }
}

fn returning(value: String) -> ByteArray {
    try {
        return pair(value);
    }
    finally {
        churn();
    }
}

fn sliced(value: ByteArray) -> ByteArray {
    switch bytesApi.slice(value, 1, bytesApi.length(value) - 1) {
        case Option.Some(piece): {
            return piece;
        }
        case Option.None: {
            return bytesApi.from(b"invalid");
        }
    }
}

fn looped(value: Held) -> ByteArray {
    var kept = value;
    var index = 0;
    while index < 8 {
        let garbage = pair("discarded");
        if index % 2 == 0 {
            kept.bytes = returning(kept.text);
        }
        else {
            churn();
        }
        index = index + 1;
    }
    return kept.bytes;
}

fn worker() -> ByteArray {
    return returning("worker");
}

error LocalFailure {}

fn failLocal(flag: Bool) {
    if flag {
        throw LocalFailure(message: "expected");
    }
}

fn caughtLocal(seed: ByteArray, flag: Bool) -> ByteArray {
    var original = bytesApi.concat(seed, bytesApi.from(b":internal"));
    let discarded = pair("dead");
    try {
        failLocal(flag);
        original = pair("new");
    }
    catch errors {
        churn();
        return original;
    }
    return original;
}

fn carriedLocal(seed: ByteArray, flag: Bool) -> ByteArray {
    var kept = seed;
    var round = 0;
    while round < 24 {
        let disposable = pair("unused");
        if flag {
            kept = bytesApi.concat(kept, bytesApi.from(b"x"));
        }
        else {
            churn();
        }
        round = round + 1;
    }
    return kept;
}

async fn main() {
    try {
        let seedLocal = bytesApi.from(b"kept\x00\xff");
        check(caughtLocal(seedLocal, true) == bytesApi.from(b"kept\x00\xff:internal"));
        check(caughtLocal(seedLocal, false) == bytesApi.from(b"new:tail"));
        check(carriedLocal(seedLocal, false) == seedLocal);
        check(bytesApi.length(carriedLocal(seedLocal, true)) == 30);
        let environment = rinzu.process.environment("PATH");
        let held = Held(text: "日本語\u{0}held", bytes: bytesApi.from(b"initial"));
        let alias = held;
        let expected = textApi.encodeUtf8("日本語\u{0}held:tail");
        check(looped(held) == expected);
        check(alias.bytes == expected);
        let left = sliced(bytesApi.from(b"\x00\x80\xffabc"));
        churn();
        check(left == bytesApi.from(b"\x80\xffab"));
        check(returning("final") == bytesApi.from(b"final:tail"));
        let pending = spawn worker();
        try {
            let first = await pending;
            churn();
            let again = await pending;
            check(first == bytesApi.from(b"worker:tail") && again == first);
        }
        finally {
            let settled = await pending;
        }
        rinzu.stdio.writeLine("C06-local:cfg:overwrite:error:loop:finally:alias:gc:worker:OK");
    }
    catch unexpected {
        rinzu.core.panic("failedRoot");
    }
}
