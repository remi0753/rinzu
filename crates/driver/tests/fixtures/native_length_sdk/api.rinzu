import rinzu.core;

let width: CSize = 4;

native {
    fn invoke(callback: fn (Bytes(width)) -> CSize, data: Bytes(width)) -> CSize symbol "invoke";

    fn invokeZero(callback: fn (Bytes(0)) -> CSize, data: Bytes(0)) -> CSize symbol "invoke_zero";

    fn invokeText(callback: fn (String) -> CSize, data: String) -> CSize symbol "invoke_text";

    fn touch() -> Unit symbol "touch";

    fn count() -> CSize symbol "count";

    fn signed8(value: CInt8) -> CInt8 symbol "signed8";

    fn fireLate() -> CSize symbol "fire_late";

    fn badBytes(callback: fn (Bytes(width)) -> CSize, kind: CInt) -> CSize symbol "bad_bytes";

    fn badText(callback: fn (String) -> CSize, kind: CInt) -> CSize symbol "bad_text";
}

fn textLength(text: String) -> CSize fallback 0 {
    return utf8ByteLength(text);
}

fn apply(callback: fn (Bytes(width)) -> CSize, data: Bytes(width)) -> CSize {
    return invoke(callback, data);
}

fn measure(data: Bytes(width), text: String) -> Int {
    try {
        let constant: fn (Bytes(width)) -> CSize = byteLength;
        var selected: fn (Bytes(width)) -> CSize = constant;
        selected = byteLength;
        let bytes = apply(selected, data);
        let zero: fn (Bytes(0)) -> CSize = byteLength;
        let empty = invokeZero(zero, b"");
        let utf8: fn (String) -> CSize = textLength;
        let textSize = invokeText(utf8, text);
        touch();
        if bytes != 4 || empty != 0 || textSize != 9 || signed8(-128) != -128 {
            panic("bad_native_result");
        }
        if data != b"A\xff\x00\x00" || text != "日本語\u{0}🙂" {
            panic("lost_caller_root");
        }
        return Int(bytes + textSize);
    }
    catch unexpectedErrors {
        panic("unexpectedFailure");
        return 0;
    }
}

fn late() -> Int {
    try {
        let beforeClose = measure(b"A\xff", "日本語\u{0}🙂");
        return Int(fireLate());
    }
    catch unexpectedErrors {
        panic("unexpectedFailure");
        return 0;
    }
}

fn calls() -> Int {
    try {
        return Int(count());
    }
    catch unexpectedErrors {
        panic("unexpectedFailure");
        return 0;
    }
}

fn fatal(kind: CInt) -> Int {
    try {
        if kind < 3 {
            let bytes: fn (Bytes(width)) -> CSize = byteLength;
            return Int(badBytes(bytes, kind));
        }
        let text: fn (String) -> CSize = textLength;
        return Int(badText(text, kind));
    }
    catch unexpectedErrors {
        panic("unexpectedFailure");
        return 0;
    }
}

export measure;
export late;
export calls;
export fatal;
