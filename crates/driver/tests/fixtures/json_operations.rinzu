import rinzu.json;
import rinzu.list;
import rinzu.map;
import rinzu.stdio;

type Row = {
    id: Int,
    amount: Int,
    note: Option<String>,
    rate: Float
};

type Rows = Map<String, List<Row>>;

fn check(condition: Bool, label: String) nothrow {
    if !condition {
        panic(label);
    }
}

error Absent {}

fn need<T>(value: Option<T>) throws(Absent) -> T {
    switch value {
        case Option.Some(item): {
            return item;
        }
        case Option.None: {
            throw Absent(message: "expected Some");
        }
    }
}

fn fragment() -> rinzu.json.Value {
    let root = rinzu.json.parse(utf8Encode(r#"  {"payload":[1, {"a\u0000":"\uD83D\uDE00"}]}  "#));
    return need(rinzu.json.at(need(rinzu.json.field(root, "payload")), 1));
}

fn decodeError(source: ByteArray, reason: rinzu.json.DecodeReason, offset: Int, first: Option<Int>) {
    try {
        let unused1 = rinzu.json.parse(source);
        panic("expected DecodeFailed");
    }
    catch [problem: rinzu.json.DecodeFailed] {
        check(problem.payload.reason == reason, "decode reason");
        check(problem.payload.byteOffset == offset, "decode offset");
        check(problem.payload.firstOffset == first, "first duplicate offset");
    }
    catch other {
        panic("unexpected decode Error");
    }
}

fn schemaError(source: String, reason: rinzu.json.SchemaReason, offset: Int, path: String, key: Option<String>) {
    try {
        let unused2 = rinzu.json.parseStringWithTy<List<Row>>(source);
        panic("expected SchemaMismatch");
    }
    catch [problem: rinzu.json.SchemaMismatch] {
        check(problem.payload.reason == reason, "schema reason");
        check(problem.payload.byteOffset == offset, "schema offset");
        check(problem.payload.path == path && problem.payload.key == key, "schema path and key");
        if reason == rinzu.json.SchemaReason.WrongKind() {
            check(
                problem.payload.expected == Option<rinzu.json.Kind>.Some(value: rinzu.json.Kind.Number()),
                "expected kind"
            );
            check(problem.payload.actual == Option<rinzu.json.Kind>.Some(value: rinzu.json.Kind.Text()), "actual kind");
        }
    }
    catch other {
        panic("unexpected schema Error");
    }
}

fn numberError(token: String, asInteger: Bool, reason: rinzu.json.NumberReason) {
    try {
        let number = rinzu.json.parseString(token);
        if asInteger {
            let unused3 = rinzu.json.asInt(number);
        }
        else {
            let unused4 = rinzu.json.asFloat(number);
        }
        panic("expected NumberError");
    }
    catch [problem: rinzu.json.NumberError] {
        check(problem.payload.reason == reason, "number reason");
    }
    catch other {
        panic("unexpected number Error");
    }
}

fn verifyLimits() {
    let bounds: rinzu.json.ParseLimits = {
        maxInputBytes = 3,
        maxDepth = 1,
        maxNodes = 2
    };
    let ok = rinzu.json.parseStringWithLimits("[0]", bounds);
    check(rinzu.json.arrayLength(ok) == 1, "parse limits allow equality");
    try {
        let unused5 = rinzu.json.parseStringWithLimits("[0] ", bounds);
        panic("expected input byte limit");
    }
    catch [problem: rinzu.json.LimitExceeded] {
        check(problem.payload.kind == rinzu.json.LimitKind.InputBytes() && problem.payload.limit == 3, "input limit");
        check(need<Int>(problem.payload.byteOffset) == 3, "input limit offset");
    }
    catch other {
        panic("unexpected input limit Error");
    }
    try {
        let unused6 = rinzu.json.parseStringWithLimits("[[]]", { ...bounds, maxInputBytes = 4 });
        panic("expected depth limit");
    }
    catch [problem: rinzu.json.LimitExceeded] {
        check(
            problem.payload.kind == rinzu.json.LimitKind.Depth() && need<Int>(problem.payload.byteOffset) == 1,
            "depth limit"
        );
    }
    catch other {
        panic("unexpected depth Error");
    }
    try {
        let unused7 = rinzu.json.parseStringWithLimits(r#"{"a":0}"#, { ...bounds, maxInputBytes = 7 });
        panic("expected nodes limit");
    }
    catch [problem: rinzu.json.LimitExceeded] {
        check(
            problem.payload.kind == rinzu.json.LimitKind.Nodes() && need<Int>(problem.payload.byteOffset) == 5,
            "nodes count keys"
        );
    }
    catch other {
        panic("unexpected nodes Error");
    }
    try {
        let unused8 = rinzu.json.parseStringWithLimits(
            "n",
            {
                maxInputBytes = 0,
                maxDepth = -1,
                maxNodes = 0
            }
        );
        panic("expected invalid limits");
    }
    catch [problem: rinzu.json.InvalidLimits] {
        let p = problem.payload;
        check(
            p.kind == rinzu.json.LimitKind.InputBytes() && p.supplied == 0 && p.minimum == 1 && p.maximum == 268435456,
            "invalid limits order"
        );
    }
    catch other {
        panic("unexpected invalid limits Error");
    }
    let encoded: rinzu.json.EncodeLimits = {
        maxOutputBytes = 3,
        maxDepth = 1,
        maxNodes = 2
    };
    check(rinzu.json.stringifyWithLimits(ok, encoded) == "[0]", "encode limits allow equality");
    try {
        let unused9 = rinzu.json.encodeWithLimits(ok, { ...encoded, maxOutputBytes = 2 });
        panic("expected encode limit");
    }
    catch [problem: rinzu.json.LimitExceeded] {
        check(
            problem.payload.kind == rinzu.json.LimitKind.OutputBytes()
                && problem.payload.byteOffset == Option<Int>.None(),
            "encode limit payload"
        );
    }
    catch other {
        panic("unexpected encode Error");
    }
    check(rinzu.json.defaultParseLimits.maxInputBytes == 134217728, "default input limit");
    check(rinzu.json.defaultEncodeLimits.maxNodes == 16777216, "default output nodes");
}

fn checkValues() {
    let slice = fragment();
    let ignored = rinzu.json.parseString("[1,2,3]");
    check(rinzu.json.kind(slice) == rinzu.json.Kind.Object(), "retained subtree");
    let entry = need(rinzu.json.entryAt(slice, 0));
    check(entry.key == "a\u{0}" && rinzu.json.asString(entry.value) == "😀", "decoded NUL and surrogate");
    check(rinzu.json.stringify(slice) == r#"{"a\u0000":"\uD83D\uDE00"}"#, "subtree uses original source");
    let original = " \t[true, null, 1E+002] \r\n";
    let root = rinzu.json.parseString(original);
    check(rinzu.json.stringify(root) == original, "root whitespace");
    check(rinzu.json.encode(root) == utf8Encode(original), "cross representation output");
    check(rinzu.json.asBool(need(rinzu.json.at(root, 0))), "boolean");
    check(rinzu.json.kind(need(rinzu.json.at(root, 1))) == rinzu.json.Kind.Null(), "array null");
    check(rinzu.json.numberText(need(rinzu.json.at(root, 2))) == "1E+002", "number token");
    switch rinzu.json.at(root, -1) {
        case Option.Some(item): {
            panic("negative index");
        }
        case Option.None: {}
    }
    let wide = rinzu.json.parseString(r#"{"a":0,"b":1,"c":2,"d":3,"e":4,"f":5,"g":6,"h":7,"\u0069":8,"j":null}"#);
    check(rinzu.json.objectLength(wide) == 10 && need(rinzu.json.intField(wide, "i")) == 8, "large object hash");
    let wideEntry = need(rinzu.json.entryAt(wide, 8));
    check(wideEntry.key == "i", "insertion order");
    check(rinzu.json.kind(need(rinzu.json.field(wide, "j"))) == rinzu.json.Kind.Null(), "present null");
    check(rinzu.json.intField(wide, "missing") == Option<Int>.None(), "missing field");
    let object = rinzu.json.object(
        {
            "z": rinzu.json.array([rinzu.json.nullValue(), rinzu.json.boolean(false), slice]), "a": rinzu.json.text(
                "a\n\u{0}"
            ), "n": rinzu.json.number("1e400"), "i": rinzu.json.intValue(-7)
        }
    );
    let rendered = rinzu.json.stringify(object);
    check(
        rendered == r#"{"z":[null,false,{"a\u0000":"\uD83D\uDE00"}],"a":"a\n\u0000","n":1e400,"i":-7}"#,
        "construct and stringify"
    );
    check(rinzu.json.stringify(rinzu.json.parse(rinzu.json.encode(object))) == rendered, "encode round trip");
    check(need(rinzu.json.intField(object, "i")) == -7, "built object numeric lookup");
    try {
        let unused10 = rinzu.json.intField(wide, "j");
        panic("expected TypeMismatch");
    }
    catch [problem: rinzu.json.TypeMismatch] {
        check(
            problem.payload.expected == rinzu.json.Kind.Number() && problem.payload.actual == rinzu.json.Kind.Null(),
            "TypeMismatch payload"
        );
    }
    catch other {
        panic("unexpected kind Error");
    }
}

fn checkNumbers() {
    check(rinzu.json.asInt(rinzu.json.parseString("-9223372036854775808")) == -9223372036854775808, "minimum Int");
    check(rinzu.json.asInt(rinzu.json.parseString("9223372036854775807")) == 9223372036854775807, "maximum Int");
    check(rinzu.json.asInt(rinzu.json.number("-0")) == 0, "integer signed zero");
    check(rinzu.json.asFloat(rinzu.json.number("9007199254740993")) == 9007199254740992.0, "binary64 ties to even");
    check(
        rinzu.json.asFloat(rinzu.json.number("1.7976931348623157e308")) == 1.7976931348623157e308,
        "maximum finite Float"
    );
    let zero = rinzu.json.asFloat(rinzu.json.number("-1e-4000000000000000000000000000"));
    check(rinzu.json.numberText(rinzu.json.floatValue(zero)) == "-0.0", "signed underflow");
    let subnormal = rinzu.json.parseStringWithTy<Float>("4.9406564584124654e-324");
    check(rinzu.json.numberText(rinzu.json.floatValue(subnormal)) == "5e-324", "minimum subnormal");
    let floats = rinzu.json.array(
        [
            rinzu.json.floatValue(1.0),
            rinzu.json.floatValue(1e-6),
            rinzu.json.floatValue(1e-7),
            rinzu.json.floatValue(1e20),
            rinzu.json.floatValue(1e21),
            rinzu.json.floatValue(-0.0)
        ]
    );
    check(
        rinzu.json.stringify(floats) == "[1.0,0.000001,1e-7,100000000000000000000.0,1e+21,-0.0]",
        "Float output boundaries"
    );
    numberError("1.0", true, rinzu.json.NumberReason.ExpectedInteger());
    numberError("1e2", true, rinzu.json.NumberReason.ExpectedInteger());
    numberError("9223372036854775808", true, rinzu.json.NumberReason.OutOfRange());
    numberError("1e400", false, rinzu.json.NumberReason.OutOfRange());
    try {
        let unused11 = rinzu.json.floatValue(mathSqrt(-1.0));
        panic("expected NonFinite");
    }
    catch [problem: rinzu.json.NumberError] {
        check(problem.payload.reason == rinzu.json.NumberReason.NonFinite(), "nonfinite constructor");
    }
    catch other {
        panic("unexpected nonfinite Error");
    }
}

fn checkSchemas() {
    let model: Rows = rinzu.json.parseWithTy(
        utf8Encode(
            r#"{"食費":[{"rate":0.5,"amount":2,"\u0069d":9007199254740993},{"note":null,"id":9,"amount":4,"rate":1}]}"#
        )
    );
    switch rinzu.map.get(model, "食費") {
        case Option.Some(rows): {
            var i = 0;
            for row in rows {
                if i == 0 {
                    check(
                        row.id == 9007199254740993 && row.amount == 2 && row.rate == 0.5,
                        "typed aliases and inferred target"
                    );
                }
                check(row.note == Option<String>.None(), "missing and explicit null Option");
                i = i + 1;
            }
            check(i == 2, "typed list length");
        }
        case Option.None: {
            panic("typed map key");
        }
    }
    let nested = rinzu.json.parseStringWithTy<List<Option<Option<String>>>>(r#"["\u0000", null]"#);
    check(
        need<String>(need<Option<String>>(need<Option<Option<String>>>(rinzu.list.get(nested, 0)))) == "\u{0}",
        "nested Option"
    );
    schemaError(
        r#"[{"a/~":0}]"#,
        rinzu.json.SchemaReason.UnknownField(),
        2,
        "/0/a~1~0",
        Option<String>.Some(value: "a/~")
    );
    schemaError("[{}]", rinzu.json.SchemaReason.MissingField(), 2, "/0/amount", Option<String>.Some(value: "amount"));
    schemaError(r#"[{"amount":"0"}]"#, rinzu.json.SchemaReason.WrongKind(), 11, "/0/amount", Option<String>.None());
    schemaError(
        r#"[{"amount":1.0}]"#,
        rinzu.json.SchemaReason.ExpectedInteger(),
        11,
        "/0/amount",
        Option<String>.None()
    );
    schemaError(
        r#"[{"amount":9223372036854775808}]"#,
        rinzu.json.SchemaReason.IntegerOutOfRange(),
        11,
        "/0/amount",
        Option<String>.None()
    );
    schemaError(r#"[{"rate":1e400}]"#, rinzu.json.SchemaReason.FloatOutOfRange(), 9, "/0/rate", Option<String>.None());
    try {
        let unused12 = rinzu.json.parseStringWithTy<Row>(r#"{"id":1,"\u0069d":2}"#);
        panic("expected typed duplicate key");
    }
    catch [problem: rinzu.json.DecodeFailed] {
        check(
            problem.payload.reason == rinzu.json.DecodeReason.DuplicateKey()
                && problem.payload.byteOffset == 8
                && need<Int>(problem.payload.firstOffset) == 1,
            "typed duplicate precedes missing"
        );
    }
    catch other {
        panic("unexpected typed duplicate Error");
    }
}

fn exercise() {
    checkValues();
    checkNumbers();
    checkSchemas();
    verifyLimits();
    decodeError(utf8Encode("true false"), rinzu.json.DecodeReason.TrailingData(), 5, Option<Int>.None());
    decodeError(utf8Encode("1e"), rinzu.json.DecodeReason.UnexpectedEnd(), 2, Option<Int>.None());
    decodeError(utf8Encode("01"), rinzu.json.DecodeReason.InvalidNumber(), 1, Option<Int>.None());
    decodeError(
        utf8Encode(r#"{"a":1,"\u0061":2}"#),
        rinzu.json.DecodeReason.DuplicateKey(),
        7,
        Option<Int>.Some(value: 1)
    );
    decodeError(utf8Encode(r#""\uD800""#), rinzu.json.DecodeReason.UnpairedSurrogate(), 1, Option<Int>.None());
    decodeError(byteArray(b"\"x\xe0\x80\x80\""), rinzu.json.DecodeReason.InvalidUtf8(), 2, Option<Int>.None());
    decodeError(byteArray(b"\"a\x00\""), rinzu.json.DecodeReason.ControlCharacter(), 2, Option<Int>.None());
    decodeError(byteArray(b"\xef\xbb\xbfnull"), rinzu.json.DecodeReason.UnexpectedToken(), 0, Option<Int>.None());
    decodeError(utf8Encode(r#"{"a":1,"a":}"#), rinzu.json.DecodeReason.UnexpectedToken(), 11, Option<Int>.None());
}

fn main() {
    try {
        exercise();
        rinzu.stdio.writeLine("json ok");
    }
    catch problems {
        panic(f"{problems}");
    }
}
