import rinzu.list;
import rinzu.map;

export fold;
export findFirst;
export frequencies;

fn fold<T, A>(values: List<T>, initial: A, combine: fn (A, T) -> A) -> A {
    var output = initial;
    var index = 0;
    let count = rinzu.list.length(values);
    while index < count {
        switch rinzu.list.get(values, index) {
            case Option.Some(value): {
                output = combine(output, value);
            }
            case Option.None: {}
        }
        index = index + 1;
    }
    return output;
}

fn findFirst<T: Equality>(values: List<T>, wanted: T) -> Option<Int> {
    var index = 0;
    let count = rinzu.list.length(values);
    while index < count {
        switch rinzu.list.get(values, index) {
            case Option.Some(value): {
                if value == wanted {
                    return Option<Int>.Some(value: index);
                }
            }
            case Option.None: {}
        }
        index = index + 1;
    }
    return Option<Int>.None();
}

fn frequencies(words: List<String>) -> Map<String, Int> {
    var counts: Map<String, Int> = {};
    var index = 0;
    let length = rinzu.list.length(words);
    while index < length {
        switch rinzu.list.get(words, index) {
            case Option.Some(word): {
                var count = 0;
                switch rinzu.map.get(counts, word) {
                    case Option.Some(value): {
                        count = value;
                    }
                    case Option.None: {}
                }
                counts = rinzu.map.insert(counts, word, count + 1);
            }
            case Option.None: {}
        }
        index = index + 1;
    }
    return counts;
}
