import rinzu.list;
import rinzu.map;
import rinzu.option;

export findFirst;
export frequencies;

fn findFirst<T: Equality>(values: List<T>, wanted: T) -> Option<Int> {
    var index = 0;
    let count = rinzu.list.length(values);
    while index < count {
        switch rinzu.list.get(values, index) {
            case Option.Some(value): {
                if value == wanted {
                    return Option<Int>.Some(value: index);
                }
            }
            case Option.None: {}
        }
        index = index + 1;
    }
    return Option<Int>.None();
}

fn frequencies(words: List<String>) -> Map<String, Int> {
    var counts: Map<String, Int> = {};
    for word in words {
        let previous = rinzu.map.get(counts, word);
        let count = rinzu.option.getOrElse(
            previous,
            fn () -> Int {
                return 0;
            }
        );
        counts = rinzu.map.insert(counts, word, count + 1);
    }
    return counts;
}
