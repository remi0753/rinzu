import algorithms;
import rinzu.list;
import rinzu.stdio;

fn double(value: Int) -> Int {
    return value + value;
}

fn positive(value: Int) -> Bool {
    return value > 0;
}

fn add(total: Int, value: Int) -> Int {
    return total + value;
}

fn appendText(total: String, value: String) -> String {
    return f"{total}{value}";
}

fn failOnLarge(value: Int) -> Int {
    return Int(CInt8(value));
}

fn main() {
    try {
        let values = [3, -1, 3, 2];
        rinzu.stdio.writeLine(rinzu.list.fold(values, 0, add));
        rinzu.stdio.writeLine(rinzu.list.map(values, double));
        rinzu.stdio.writeLine(rinzu.list.filter(values, positive));
        rinzu.stdio.writeLine(algorithms.findFirst<Int>(values, 3));
        rinzu.stdio.writeLine(algorithms.findFirst<Int>(values, 99));
        rinzu.stdio.writeLine(values);
        rinzu.stdio.writeLine(algorithms.frequencies(["a", "b", "a", "日本語", ""]));
        rinzu.stdio.writeLine(rinzu.list.fold(["日本語", "\u{0}tail"], "", appendText));
        try {
            let failed = rinzu.list.map([1, 300], failOnLarge);
        }
        catch conversion {
            rinzu.stdio.writeLine("callback caught");
        }
        finally {
            rinzu.stdio.writeLine("cleanup");
        }
    }
    catch errors {}
}
