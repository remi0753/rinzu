import rinzu.stdio;
import rinzu.bytes as bytesApi;

fn copy<T: Transferable>(value: T) -> T {
    return value;
}

fn length(value: ByteArray, measure: fn (ByteArray) -> CSize) -> CSize {
    return measure(value);
}

async fn main() {
    try {
        let values: List<CUInt8> = [0, 255, 65];
        let data = bytesApi.from(values);
        let padded: Bytes(8) = b"A";
        let fixed = bytesApi.from(padded);
        rinzu.stdio.writeLine(bytesApi.length(data));
        rinzu.stdio.writeLine(length(data, bytesApi.byteLength));
        rinzu.stdio.writeLine(bytesApi.length(fixed));
        rinzu.stdio.writeLine(bytesApi.get(data, 0));
        rinzu.stdio.writeLine(bytesApi.get(data, 3));
        rinzu.stdio.writeLine(bytesApi.slice(data, 0, 2));
        rinzu.stdio.writeLine(bytesApi.slice(data, 3, 3));
        rinzu.stdio.writeLine(bytesApi.slice(data, -1, 2));
        let empty: List<CUInt8> = [];
        let combined = bytesApi.concat(bytesApi.from(empty), bytesApi.copy(data));
        rinzu.stdio.writeLine(combined == data);
        let pending = spawn copy<List<ByteArray>>([combined, fixed]);
        rinzu.stdio.writeLine(await pending);
        rinzu.stdio.writeLine(f"data={data}");
    }
    catch errors {}
}
