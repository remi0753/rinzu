import rinzu.list;
import rinzu.map;
import rinzu.stdio;

fn countMatches<T: Equality>(values: List<T>, wanted: T) -> Int {
    var count = 0;
    var index = 0;
    let length = rinzu.list.length(values);
    while index < length {
        switch rinzu.list.get(values, index) {
            case Option.Some(value): {
                if value == wanted {
                    count = count + 1;
                }
            }
            case Option.None: {}
        }
        index = index + 1;
    }
    return count;
}

fn sumMap<K: Key>(values: Map<K, Int>) -> Int {
    var total = 0;
    for entry in rinzu.map.entries(values) {
        total = total + entry.value;
    }
    return total;
}

fn sumSnapshot(values: List<Int>) -> Int {
    let snapshot = values;
    var changed = values;
    var total = 0;
    var index = 0;
    let count = rinzu.list.length(snapshot);
    while index < count {
        changed = rinzu.list.append(changed, index);
        switch rinzu.list.get(snapshot, index) {
            case Option.Some(value): {
                total = total + value;
            }
            case Option.None: {}
        }
        index = index + 1;
    }
    if rinzu.list.length(changed) != count + count {
        panic("wrongSnapshot");
    }
    return total;
}

async fn main() {
    try {
        rinzu.stdio.writeLine(countMatches<Int>([3, -1, 3, 2], 3));
        rinzu.stdio.writeLine(countMatches<String>(["日本語", "other", "日本語"], "日本語"));
        rinzu.stdio.writeLine(sumSnapshot([3, -1, 3, 2]));
        let table: Map<String, Int> = {
            "first": 2, "second": 3, "first": 4
        };
        rinzu.stdio.writeLine(rinzu.map.keys(table));
        let pending = spawn sumMap<String>(table);
        rinzu.stdio.writeLine(await pending);
    }
    catch errors {}
}
