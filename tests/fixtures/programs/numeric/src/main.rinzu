import rinzu.stdio;

let MASK: CUInt8 = bitOr(0xf0, 0b0000_1111);

let NEXT: CUInt8 = wrappingAdd(MASK, 1);

fn echo(value: CUInt8) -> CUInt8 {
    return value;
}

async fn main() {
    try {
        try {
            let data: CUInt8 = 0xAA;
            rinzu.stdio.writeLine(bitAnd(data, 0x0f));
            rinzu.stdio.writeLine(bitXor(data, MASK));
            rinzu.stdio.writeLine(bitNot(data));
            rinzu.stdio.writeLine(NEXT);
            rinzu.stdio.writeLine(wrappingSub(CUInt8(0), 1));
            rinzu.stdio.writeLine(wrappingMul(CInt8(100), 2));
            rinzu.stdio.writeLine(shiftRight(CInt8(-128), 7));
            rinzu.stdio.writeLine(shiftLeft(CUInt8(1), 7));
            try {
                let resultValue3 = checkedAdd(data, 0xff);
                rinzu.stdio.writeLine(resultValue3);
            }
            catch [resultError3: Error, ...resultRest3] {
                rinzu.stdio.writeLine(errorCode(resultError3));
            }
            try {
                let resultValue2 = shiftLeft(data, -1);
                rinzu.stdio.writeLine(resultValue2);
            }
            catch [resultError2: Error, ...resultRest2] {
                rinzu.stdio.writeLine(errorCode(resultError2));
            }
            try {
                let resultValue1 = checkedMul(CUInt8(12), 2);
                let pending = spawn echo(resultValue1);
                rinzu.stdio.writeLine((await pending));
            }
            catch [resultError1: Error, ...resultRest1] {
                rinzu.stdio.writeLine((resultError1));
            }
            rinzu.stdio.writeLine(mathAbs(CFloat(-1.5)));
            rinzu.stdio.writeLine(mathSqrt(4.0));
            rinzu.stdio.writeLine(floatIsNan(mathSqrt(-1.0)));
        }
        catch errors {}
    }
    catch unexpectedEntryErrors {
        panic("unexpectedEntryFailure");
    }
}
