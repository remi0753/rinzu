import rinzu.timer;
import rinzu.macos;
import rinzu.process;
import rinzu.stdio;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.error as err;

class Viewer {
    const device: rinzu.macos.Device,
    canvas: Option<rinzu.macos.Canvas2D>,
    const status: rinzu.macos.Label,
    image: rinzu.macos.Texture,
    path: String,
    fit: Bool,
    zoom: Float,
    filter: Int,
    loading: Bool

    private fn canvasNow(self: Viewer) -> rinzu.macos.Canvas2D {
        switch self.canvas {
            case Option.Some(canvas): {
                return canvas;
            }
            case Option.None: {
                throw err.create(-7803, "viewer canvas is not ready");
            }
        }
    }

    fn changed(self: Viewer) {
        let canvas = self.canvasNow();
        let invalidated = canvas.invalidate();
    }

    private fn fitScale(self: Viewer, size: rinzu.macos.Rect, info: rinzu.macos.TextureInfo) -> Float {
        var scale = (size.width - 32.0) / Float(info.width);
        let vertical = (size.height - 32.0) / Float(info.height);
        if scale > vertical {
            scale = vertical;
        }
        if scale < 0.001 {
            scale = 0.001;
        }
        return scale;
    }

    fn zoomBy(self: Viewer, factor: Float) {
        if self.fit {
            let canvas = self.canvasNow();
            let size = canvas.view.drawableSize();
            let info = self.image.info();
            self.zoom = self.fitScale(size, info);
        }
        self.fit = false;
        self.zoom = self.zoom * factor;
        if self.zoom < 0.0001 {
            self.zoom = 0.0001;
        }
        if self.zoom > 65536.0 {
            self.zoom = 65536.0;
        }
        self.changed();
    }

    async fn load(self: Viewer, job: rinzu.macos.UiJob, path: String) {
        let fresh = await self.device.loadImageTexture(path);
        var installed = false;
        try {
            let canvas = self.canvasNow();
            while canvas.drawing && !job.isStopping() {
                await rinzu.timer.sleep(1);
            }
            if !job.isStopping() {
                let old = self.image;
                self.image = fresh;
                installed = true;
                self.path = path;
                self.fit = true;
                let destroyed = old.destroy();
                self.changed();
                let info = fresh.info();
                let title = job.window.setTitle(f"Rinzu Image Viewer — {path}");
                let message = self.status.setText(f"{info.width} × {info.height} px  ·  {path}");
                rinzu.stdio.writeLine(f"VIEWER:image:{info.width}x{info.height}");
            }
        }
        finally {
            if !installed {
                let discarded = fresh.destroy();
            }
        }
    }

    async fn open(self: Viewer, job: rinzu.macos.UiJob, initial: String) {
        try {
            if initial != "" {
                await self.load(job, initial);
            }
            else {
                switch await job.window.openFile("Open image", "") {
                    case Option.None: {}
                    case Option.Some(path): {
                        await self.load(job, path);
                    }
                }
            }
        }
        catch errors {
            if !job.isStopping() {
                let message = self.status.setText(
                    "Could not open image. Check that the file is readable and uses a supported image format."
                );
            }
        }
        finally {
            self.loading = false;
        }
    }

    async fn paint(self: Viewer, frame: rinzu.macos.Frame2D) {
        frame.usePixels();
        let size = rinzu.macos.Rect(x: 0.0, y: 0.0, width: Float(frame.info.width), height: Float(frame.info.height));
        // A checkerboard exposes the decoded image's transparency.
        var tile = 32.0;
        while (size.width / tile + 1.0) * (size.height / tile + 1.0) > 4096.0 {
            tile = tile * 2.0;
        }
        var y = 0.0;
        var row = 0;
        while y < size.height {
            var x = 0.0;
            var column = 0;
            while x < size.width {
                var shade = 0.20;
                if (row + column) % 2 == 0 {
                    shade = 0.26;
                }
                frame.batch.fillRect(
                    rinzu.macos.Rect(x: x, y: y, width: tile, height: tile),
                    rinzu.macos.Color(red: shade, green: shade, blue: shade, alpha: 1.0)
                );
                x = x + tile;
                column = column + 1;
            }
            y = y + tile;
            row = row + 1;
        }
        let info = self.image.info();
        var scale = self.zoom;
        if self.fit {
            scale = self.fitScale(size, info);
        }
        let width = Float(info.width) * scale;
        let height = Float(info.height) * scale;
        frame.batch.setFilter(self.filter);
        frame.batch.image(
            self.image,
            rinzu.macos.Rect(
                x: (size.width - width) / 2.0,
                y: (size.height - height) / 2.0,
                width: width,
                height: height
            ),
            rinzu.macos.Color(red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0)
        );
    }

    async fn receive(self: Viewer, scope: rinzu.macos.UiScope, event: rinzu.macos.UiEvent) {
        if event.kind == rinzu.macos.eventCloseRequested || event.kind == rinzu.macos.eventQuitRequested {
            scope.requestStop();
        }
        else if event.kind == rinzu.macos.eventAction {
            if event.action == 10 && !self.loading {
                self.loading = true;
                let reader = scope.start(
                    async fn (job: rinzu.macos.UiJob) {
                        await self.open(job, "");
                    }
                );
            }
            else if event.action == 11 {
                self.fit = true;
                self.changed();
            }
            else if event.action == 12 {
                self.fit = false;
                self.zoom = 1.0;
                self.changed();
            }
            else if event.action == 13 {
                self.zoomBy(1.25);
            }
            else if event.action == 14 {
                self.zoomBy(0.8);
            }
            else if event.action == 15 {
                self.filter = 1 - self.filter;
                self.changed();
                var name = "Nearest";
                if self.filter == rinzu.macos.filterLinear {
                    name = "Linear";
                }
                let message = self.status.setText(f"{name} filtering  ·  {self.path}");
            }
        }
    }

    async fn exercise(self: Viewer, job: rinzu.macos.UiJob) {
        let canvas = self.canvasNow();
        var ticks = 0;
        while (self.loading || canvas.frames < 1) && !job.isStopping() {
            if ticks > 1000 {
                rinzu.core.panic("viewer did not draw its initial image");
            }
            await rinzu.timer.sleep(10);
            ticks = ticks + 1;
        }
        let frames = canvas.frames;
        let resized = job.window.setContentSize(840.0, 600.0);
        self.filter = rinzu.macos.filterNearest;
        let zoomSize = canvas.view.drawableSize();
        let imageInfo = self.image.info();
        let fitted = self.fitScale(zoomSize, imageInfo);
        self.zoomBy(1.25);
        if self.fit || self.zoom <= fitted {
            rinzu.core.panic("zoom-in from Fit must increase the displayed scale");
        }
        while canvas.frames <= frames && !job.isStopping() {
            await rinzu.timer.sleep(10);
        }
        let size = canvas.view.frame();
        if size.width != 816.0 || size.height != 502.0 {
            rinzu.core.panic("viewer surface did not resize");
        }
        rinzu.stdio.writeLine("VIEWER:resize:zoom:nearest");
        job.requestStop();
    }
}

async fn screen(app: rinzu.macos.UiApplication) {
    let scope = app.primary;
    let minimum = scope.window.setMinimumContentSize(420.0, 240.0);
    let root = scope.window.contentView();
    let toolbar = scope.session.view(rinzu.macos.Rect(x: 12.0, y: 530.0, width: 736.0, height: 30.0));
    let attachedToolbar = root.addSubview(toolbar);
    let flexibleToolbar = toolbar.setAutoresizing(10);
    let buttonFrame = rinzu.macos.Rect(x: 0.0, y: 0.0, width: 100.0, height: 28.0);
    let open = scope.button("Open…", buttonFrame, 10);
    let fit = scope.button("Fit", buttonFrame, 11);
    let actual = scope.button("100%", buttonFrame, 12);
    let zoomIn = scope.button("+", buttonFrame, 13);
    let zoomOut = scope.button("−", buttonFrame, 14);
    let filter = scope.button("Linear / Nearest", buttonFrame, 15);
    let layout = rinzu.macos.row(
        toolbar,
        [open.view, fit.view, actual.view, zoomIn.view, zoomOut.view, filter.view],
        0.0,
        6.0
    );
    let device = scope.session.device();
    let status = scope.label(
        "Open an image  ·  Fit / 100% / Zoom / Linear or Nearest",
        rinzu.macos.Rect(x: 12.0, y: 12.0, width: 736.0, height: 24.0)
    );
    let attachedStatus = root.addSubview(status.view);
    let flexibleStatus = status.view.setAutoresizing(2);
    let image = device.texture2D(2, 2, rinzu.macos.pixelRGBA8, rinzu.macos.textureSampled);
    let uploaded = image.write(
        rinzu.macos.Scissor(x: 0, y: 0, width: 2, height: 2),
        8,
        bytesApi.from(b"\x22\xb8\xe6\xff\xed\x75\x40\xff\x52\x41\x9b\xff\x4a\xa3\x6d\xff")
    );
    let viewer = Viewer(
        device: device,
        canvas: Option<rinzu.macos.Canvas2D>.None(),
        status: status,
        image: image,
        path: "Built-in 2 × 2 image",
        fit: true,
        zoom: 1.0,
        filter: rinzu.macos.filterLinear,
        loading: false
    );
    let canvas = scope.canvas2D(
        device,
        rinzu.macos.Rect(x: 12.0, y: 48.0, width: 736.0, height: 470.0),
        4098,
        60,
        rinzu.macos.Color(red: 0.1, green: 0.1, blue: 0.1, alpha: 1.0),
        async fn (frame: rinzu.macos.Frame2D) {
            await viewer.paint(frame);
        }
    );
    viewer.canvas = Option<rinzu.macos.Canvas2D>.Some(value: canvas);
    let flexibleSurface = canvas.view.setAutoresizing(18);
    let menu = scope.menu("Main");
    let application = scope.menu("Rinzu Image Viewer");
    let quit = application.addStandard("Quit", rinzu.macos.commandQuit, "q", rinzu.macos.modifierCommand);
    let file = scope.menu("File");
    let openItem = file.addAction("Open…", 10, "o", rinzu.macos.modifierCommand);
    let view = scope.menu("View");
    let fitItem = view.addAction("Fit", 11, "0", rinzu.macos.modifierCommand);
    let actualItem = view.addAction("Actual pixels", 12, "1", rinzu.macos.modifierCommand);
    let appMenu = menu.addSubmenu(application);
    let fileMenu = menu.addSubmenu(file);
    let viewMenu = menu.addSubmenu(view);
    let installed = scope.window.setMenu(menu);
    let initial = rinzu.process.setting("RINZU_IMAGE_PATH", "");
    if initial != "" {
        viewer.loading = true;
        let loading = scope.start(
            async fn (job: rinzu.macos.UiJob) {
                await viewer.open(job, initial);
            }
        );
    }
    if rinzu.process.setting("RINZU_IMAGE_TEST", "0") == "1" {
        let testing = scope.start(
            async fn (job: rinzu.macos.UiJob) {
                await viewer.exercise(job);
            }
        );
    }
    await scope.dispatch(
        async fn (owner: rinzu.macos.UiScope, event: rinzu.macos.UiEvent) {
            if event.kind == rinzu.macos.eventResized {
                let arranged = rinzu.macos.row(
                    toolbar,
                    [open.view, fit.view, actual.view, zoomIn.view, zoomOut.view, filter.view],
                    0.0,
                    6.0
                );
            }
            await viewer.receive(owner, event);
        }
    );
    rinzu.stdio.writeLine(f"VIEWER:frames={canvas.frames}");
}

async fn main() {
    try {
        let result = await rinzu.macos.applicationWithSignals("Rinzu Image Viewer", 760.0, 568.0, screen);
        let stats = rinzu.macos.statistics();
        if stats.retainedControls != 0 || stats.textureBytes != 0 || stats.bufferBytes != 0 {
            rinzu.core.panic("viewer resources remained");
        }
        rinzu.stdio.writeLine("VIEWER:closed");
    }
    catch errors {
        try {
            rinzu.stdio.writeLine(f"Image viewer failed: {errors}");
        }
        catch outputErrors {}
        rinzu.core.panic("image viewer failed");
    }
}
