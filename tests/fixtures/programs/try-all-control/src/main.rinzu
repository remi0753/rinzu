import rinzu.stdio;

fn work() -> Int {
    var n = 0;
    while n < 10000 {
        n = n + 1;
    }
    return 1;
}

async fn a() {
    rinzu.stdio.writeLine("a");
    let bad = CInt8(300);
}

async fn b() {
    let done = await spawn work();
    rinzu.stdio.writeLine("b");
}

async fn c() {
    rinzu.stdio.writeLine("c-unreachable");
}

async fn choose() -> Int {
    try all {
        await a();
        if true {
            await b();
            return 9;
        }
        await c();
    }
    catch errors {
        rinzu.stdio.writeLine(f"choose-errors={listLength(errors)}");
    }
    finally {
        rinzu.stdio.writeLine("choose-finally");
    }
    return 0;
}

async fn expression() -> Int {
    try all {
        return Int(CInt8(300));
        rinzu.stdio.writeLine("return-expression-continued");
        return 7;
    }
    catch errors {
        rinzu.stdio.writeLine(f"expression-errors={listLength(errors)}");
    }
    finally {
        rinzu.stdio.writeLine("expression-finally");
    }
    return 0;
}

async fn unhandled() -> Int {
    try all {
        await a();
        return 8;
    }
    finally {
        rinzu.stdio.writeLine("unhandled-finally");
    }
    return 0;
}

async fn replacement() -> Int {
    try all {
        let bad = CInt8(300);
        return 5;
    }
    catch errors {
        return 6;
    }
    finally {
        rinzu.stdio.writeLine("replacement-finally");
    }
    return 0;
}

async fn held() -> String {
    try all {
        await a();
        return "held";
    }
    catch errors {
        rinzu.stdio.writeLine(f"held-errors={listLength(errors)}");
    }
    finally {
        var gc = 0;
        while gc < 300 {
            let temporary = f"cleanup-gc-{gc}";
            gc = gc + 1;
        }
        rinzu.stdio.writeLine("held-finally");
    }
    return "unused";
}

async fn main() {
    try {
        let value = await choose();
        rinzu.stdio.writeLine(value);
        let continued = await expression();
        rinzu.stdio.writeLine(continued);
        try {
            let invalid = await unhandled();
            rinzu.stdio.writeLine("return-unreachable");
        }
        catch [error: Error, ...errorRest] {
            rinzu.stdio.writeLine(f"unhandled={errorCode(error)}");
        }
        let saved = await held();
        await b();
        rinzu.stdio.writeLine(saved);
        let replaced = await replacement();
        rinzu.stdio.writeLine(replaced);
        var i = 0;
        while i < 2 {
            try all {
                await b();
                i = i + 1;
                if i == 1 {
                    continue;
                }
                break;
                await c();
            }
            finally {
                rinzu.stdio.writeLine("loop-finally");
            }
        }
        rinzu.stdio.writeLine(i);
        try all {
            var j = 0;
            while j < 3 {
                let bad = CInt8(300);
                j = j + 1;
                if j == 1 {
                    continue;
                }
                break;
            }
            rinzu.stdio.writeLine("inner-body");
        }
        catch errors {
            rinzu.stdio.writeLine(f"inner-errors={listLength(errors)}");
        }
        finally {
            rinzu.stdio.writeLine("inner-finally");
        }
    }
    catch errors {}
}
