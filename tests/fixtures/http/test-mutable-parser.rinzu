// A mutable data object in an async caller must not require immutable
// checkpoints merely to keep the compiler's Future analysis tractable.
import "../http-wire/wire.rinzu" as wire;

async fn ready() -> Int {
    return 1;
}

async fn main() {
    try {
        let parser = wire.fresh(true);
        let pending = ready();
        let complete = wire.feed(parser, byteArray(b"GET /plaintext HTTP/1.1\r\nHost: localhost\r\n\r\n"));
        let value = await pending;
        if !complete || value != 1 {
            panic("incomplete");
        }
        let request = wire.request(parser);
        if request.target != "/plaintext" || bytesLength(parser.residual) != 0 {
            panic("invalidRequest");
        }
    }
    catch errors {
        panic("unexpectedError");
    }
}
